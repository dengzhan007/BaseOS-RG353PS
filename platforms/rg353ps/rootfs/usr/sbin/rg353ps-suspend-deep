#!/bin/sh
# RG353PS deep-suspend driver: cut SDIO WiFi power for the sleep window, wake,
# then bring the combo back and report the measured sleep current.
#
# This is the executable form of option A. It is intentionally separate from
# rg353ps-suspend-test (which is pinned to s2idle) so the known-good s2idle
# diagnostic keeps working unchanged.
#
# Usage:
#   rg353ps-suspend-deep [--wifi-off] [--settle SECONDS]
#
#   --wifi-off        unbind the rtw88 SDIO function before sleeping so the MMC
#                     core can actually cut vcc_wifi, then rebind after wake.
#                     Without it the sleep current should look like the ~41 mA
#                     baseline; with it we expect ~30 mA until the DTB change
#                     lands and the rail is truly switched off.
#   --settle SECONDS  idle time before blanking (default 3)
#
# Requires the DTB to have dropped "keep-power-in-suspend" (patch 0020) for the
# rail to actually switch; otherwise unbinding only costs resume time.
set -u

WIFI_OFF=0
SETTLE=3
while [ "$#" -gt 0 ]; do
  case "$1" in
    --wifi-off) WIFI_OFF=1 ;;
    --settle)   shift; [ "$#" -ge 1 ] || { echo "missing value for --settle" >&2; exit 2; }; SETTLE=$1 ;;
    -h|--help)  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)          echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

WIFI_CYCLE=/usr/sbin/rg353ps-wifi-cycle
BATT=/sys/class/power_supply/battery
REPORT=/tmp/rg353ps-suspend-deep-$(date -u +%Y%m%d-%H%M%S 2>/dev/null || echo run).txt
[ -w /mnt/boot ] && grep -q ' /mnt/boot ' /proc/mounts 2>/dev/null && REPORT=/mnt/boot/$(basename "$REPORT")

exec >>"$REPORT" 2>&1

log() { printf '%s\n' "$*"; printf '%s\n' "$*" > /dev/kmsg 2>/dev/null; return 0; }
fail() { log "ERROR: $*"; exit 1; }

BACKLIGHT=
BACKLIGHT_OLD=
POWER_PID=
MODE_OLD=
WIFI_UNBOUND=0

restore() {
  [ -n "$BACKLIGHT" ] && [ -w "$BACKLIGHT" ] && printf '%s\n' "$BACKLIGHT_OLD" > "$BACKLIGHT" 2>/dev/null
  if [ -n "$POWER_PID" ] && kill -0 "$POWER_PID" 2>/dev/null; then
    kill "$POWER_PID" 2>/dev/null
  fi
  if [ "$WIFI_UNBOUND" = 1 ] && [ -x "$WIFI_CYCLE" ]; then
    "$WIFI_CYCLE" bind || log "WARNING: wifi rebind failed; run '$WIFI_CYCLE bind' manually"
  fi
  if [ -n "$MODE_OLD" ] && [ -w /sys/power/mem_sleep ]; then
    printf '%s\n' "$MODE_OLD" > /sys/power/mem_sleep 2>/dev/null
  fi
}
trap 'restore' EXIT INT TERM

charge_now() { cat "$BATT/charge_now" 2>/dev/null; }
read_attr()   { cat "$1" 2>/dev/null; }

log "=== rg353ps-suspend-deep $(date -u 2>/dev/null) ==="
log "args: wifi_off=$WIFI_OFF settle=$SETTLE"
log "report: $REPORT"

# --- preconditions ----------------------------------------------------------
[ -r /sys/power/state ] || fail "/sys/power/state not readable"
grep -qw mem /sys/power/state || fail "kernel does not expose the mem state"
MEM_MODES="$(tr -d '[]' < /sys/power/mem_sleep 2>/dev/null || :)"
case " $MEM_MODES " in
  *" deep "*) ;;
  *) fail "deep is not available in mem_sleep: $(read_attr /sys/power/mem_sleep)" ;;
esac

MODE_OLD="$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' /sys/power/mem_sleep 2>/dev/null)"
[ -n "$MODE_OLD" ] || fail "cannot read current mem_sleep mode"

for c in /sys/class/backlight/*/brightness; do
  [ -r "$c" ] && [ -w "$c" ] || continue
  v="$(read_attr "$c")"
  case "$v" in ''|*[!0-9]*) continue ;; esac
  BACKLIGHT="$c"; BACKLIGHT_OLD="$v"; break
done
[ -n "$BACKLIGHT" ] || fail "no writable backlight found"

# The PMIC key must be grabbed so the wake press does not also reach the
# frontend and immediately re-blank the panel.
POWER_EVENT=
for nf in /sys/class/input/event*/device/name; do
  [ -r "$nf" ] || continue
  [ "$(read_attr "$nf")" = "rk805 pwrkey" ] || continue
  e=${nf#/sys/class/input/}; POWER_EVENT="/dev/input/${e%%/*}"; break
done
[ -n "$POWER_EVENT" ] || fail "rk805 pwrkey input device not found"
command -v evtest >/dev/null 2>&1 || fail "evtest missing"

Q_BEFORE=$(charge_now)
[ -n "$Q_BEFORE" ] || fail "$BATT/charge_now not readable (fuel gauge missing?)"
T_BEFORE=$(date +%s 2>/dev/null || echo 0)

log "mem_sleep_before=$(read_attr /sys/power/mem_sleep | tr '\n' ' ')"
log "charge_now_before=$Q_BEFORE uAh"
log "suspend_success_before=$(read_attr /sys/power/suspend_stats/success)"
log "suspend_fail_before=$(read_attr /sys/power/suspend_stats/fail)"
log "wakeup_count_before=$(read_attr /sys/power/wakeup_count | tr '\n' ' ')"

# --- cut WiFi ---------------------------------------------------------------
if [ "$WIFI_OFF" = 1 ]; then
  [ -x "$WIFI_CYCLE" ] || fail "$WIFI_CYCLE is missing"
  log "--- unbinding SDIO WiFi ---"
  if "$WIFI_CYCLE" unbind; then
    WIFI_UNBOUND=1
    log "wifi unbound (vcc_wifi is now switchable at suspend)"
  else
    fail "wifi unbind failed; refusing to sleep in an unknown state"
  fi
else
  log "wifi stays bound (keep-power path active; expect the 41 mA baseline)"
fi

# --- select deep ------------------------------------------------------------
if printf 'deep\n' > /sys/power/mem_sleep 2>/dev/null; then
  SELECTED="$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' /sys/power/mem_sleep 2>/dev/null)"
  [ "$SELECTED" = "deep" ] || fail "kernel refused deep: $(read_attr /sys/power/mem_sleep)"
  log "mem_sleep=deep selected"
else
  fail "failed to write deep to /sys/power/mem_sleep"
fi

# --- settle, grab key, blank ------------------------------------------------
log "settling ${SETTLE}s before blanking"
sleep "$SETTLE"

: > /tmp/rg353ps-deep-powerkey.log
evtest --grab "$POWER_EVENT" > /tmp/rg353ps-deep-powerkey.log 2>&1 &
POWER_PID=$!
i=0
while [ "$i" -lt 30 ] && ! grep -q 'Testing .*interrupt to exit' /tmp/rg353ps-deep-powerkey.log 2>/dev/null; do
  kill -0 "$POWER_PID" 2>/dev/null || fail "evtest exited during grab setup"
  sleep 0.1; i=$((i+1))
done
log "power key grabbed ($POWER_EVENT)"

sync
log "--- entering deep suspend ---"
printf '0\n' > "$BACKLIGHT" 2>/dev/null

if printf 'mem\n' > /sys/power/state; then
  RC=0
else
  RC=$?
fi

# --- after resume -----------------------------------------------------------
T_AFTER=$(date +%s 2>/dev/null || echo 0)
log "suspend_write_exit=$RC"
log "resumed_at=$(date -u 2>/dev/null)"

[ -n "$BACKLIGHT" ] && [ -w "$BACKLIGHT" ] && printf '%s\n' "$BACKLIGHT_OLD" > "$BACKLIGHT" 2>/dev/null

if [ "$WIFI_UNBOUND" = 1 ]; then
  log "--- rebinding SDIO WiFi ---"
  if "$WIFI_CYCLE" bind; then
    WIFI_UNBOUND=0
    log "wifi back up"
  else
    log "ERROR: wifi did not come back; keeping state for manual recovery"
  fi
fi

Q_AFTER=$(charge_now)
log "charge_now_after=$Q_AFTER uAh"
log "suspend_success_after=$(read_attr /sys/power/suspend_stats/success)"
log "suspend_fail_after=$(read_attr /sys/power/suspend_stats/fail)"

if [ -n "$Q_AFTER" ] && [ -n "$Q_BEFORE" ] && [ "$T_AFTER" -gt "$T_BEFORE" ]; then
  SECS=$((T_AFTER - T_BEFORE))
  DQ=$((Q_BEFORE - Q_AFTER))
  # mA = uAh * 3600 / seconds / 1000  ==  uAh * 3.6 / seconds
  MA=$(awk -v q="$DQ" -v s="$SECS" 'BEGIN { if (s > 0) printf "%.1f", (q * 3.6) / s; else print "n/a" }')
  log "sleep_window=${SECS}s delta_charge=${DQ}uAh"
  log "average_current_estimate=${MA} mA"
  log "(fuel-gauge estimate; includes settle time and resume burst)"
else
  log "current estimate unavailable (no charge_now or bad clock)"
fi

log "--- kernel log tail ---"
dmesg 2>&1 | grep -iE 'suspend|resume|PM:|mmc2|sdio|rtw88|vcc_wifi|regulator' | tail -60

log "=== done; report at $REPORT ==="
exit "$RC"
