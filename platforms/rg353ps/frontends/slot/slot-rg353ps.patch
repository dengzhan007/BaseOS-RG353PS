+/// Which way each ADC axis climbs, per stick, relative to the evdev convention
+/// that a bigger sample means further right / further down.
+///
+/// Measured on the hardware: X climbs towards the right and Y climbs upwards,
+/// so the left stick is `[+1, -1]`. Both sticks hang off the same adc-joystick
+/// with the same divider, so the right stick starts from the same pair. Every
+/// axis can be overridden at runtime from `<SDCARD>/Config/sticks.txt`:
+///
+/// ```text
+/// # +1 = a bigger sample means further right / further down
+/// rx=-1
+/// ry=1
+/// ```
+///
+/// Missing or unparsable lines keep the built-in value, so a typo cannot leave
+/// a stick dead.
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub struct AxisSigns {
+    pub left: [i32; 2],
+    pub right: [i32; 2],
+}
+
+impl Default for AxisSigns {
+    fn default() -> Self {
+        AxisSigns {
+            left: [1, -1],
+            right: [1, -1],
