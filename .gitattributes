# dropbear host keys are raw binary blobs (no newlines to speak of). With
# core.autocrlf=true a checkout would inject CR bytes and every SSH client
# would then reject the key. Keep them byte-exact.
platforms/rg353ps/rootfs/etc/dropbear/dropbear_ed25519_host_key -text -diff

# Everything the target executes must keep LF. core.autocrlf=true rewrites these
# on checkout, and the result is not cosmetic: the kernel-style shebang line
# makes BusyBox fall back to running the script through a shell that then chokes
# on the trailing CR, and the build container's `sh -n` rejects it outright.
# These are all shell scripts, so forcing eol=lf is safe here.
platforms/*/rootfs/etc/init.d/* text eol=lf
platforms/*/rootfs/usr/sbin/* text eol=lf
platforms/*/rootfs/usr/bin/* text eol=lf
platforms/*/rootfs/etc/profile* text eol=lf
platforms/*/*.sh text eol=lf
# Frontend sources are copied onto the card and, for the patches, fed to
# `git apply`: a CR on a context line turns every hunk into a mismatch.
platforms/*/frontends/*/*.sh text eol=lf
platforms/*/frontends/*/*.patch text eol=lf
# The U-Boot and kernel patch sets are fed to `patch -p1` from
# build-uboot.sh and build-kernel.sh. A CR on a context line turns every hunk
# into a mismatch, and with `set -eu` the build stops at the first one.
platforms/*/patches/*.patch text eol=lf

# Kconfig fragments and other build inputs are parsed line by line by tools that
# do not trim CR, so a "0\r" would quietly not be a 0. The kernel config is the
# same kind of input, but it reaches the build through olddefconfig rather than
# a line-oriented script, so a CR there fails more quietly: the option still
# appears to be set while the recorded value carries the CR.
platforms/*/uboot.config text eol=lf
platforms/*/kernel/config/* text eol=lf
src/*.c text eol=lf
platforms/*/src/*.c text eol=lf

# The version file is read with `tr -d ' \n'` and compared against the release
# stamp inside the image. A CR left in it makes the device see "1.0.4\r" and
# refuse every update payload, with no error anywhere near the cause.
VERSION text eol=lf

# Git reads this file itself; a CR here breaks the patterns on the last line.
.gitattributes text eol=lf
