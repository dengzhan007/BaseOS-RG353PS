#!/bin/sh
# Minimal RG353PS bring-up init. The tty1 diagnostic UI is started by BusyBox init.
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

mount -t proc proc /proc 2>/dev/null || :
mount -t sysfs sysfs /sys 2>/dev/null || :
mount -t devtmpfs devtmpfs /dev 2>/dev/null || :
mkdir -p /dev/pts /run /tmp /mnt/boot /mnt/roms
mount -t devpts devpts /dev/pts 2>/dev/null || :
mount -t tmpfs -o mode=0755 tmpfs /run 2>/dev/null || :
mount -t tmpfs -o mode=1777 tmpfs /tmp 2>/dev/null || :
echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || :
/sbin/mdev -s 2>/dev/null || :

# Hide the virtual-terminal cursor; fbsplash writes pixels but does not own
# the kernel console cursor. The frontend supervisor restores it on exit.
printf '\033[?25l' > /dev/tty1 2>/dev/null || :

# U-Boot deliberately hands over a black screen: the bootlogo patch replaced
# its splash callback with video_clear(). Nothing lights the panel again until
# this script reaches the post-userdata step near the bottom, so every splash
# drawn before that point was painted into a dark panel. On a first boot that
# waits for storage initialization, the unit therefore looked completely dead
# even though userspace was running normally. Raise the backlight before the
# first splash so progress and errors are actually visible.
echo 0 > /sys/class/backlight/backlight/bl_power 2>/dev/null || :

log() { printf '%s\n' "$*" > /dev/kmsg 2>/dev/null || :; }
BOOT_USB_REQUEST=/run/baseos-usb-storage.boot-request

# Start key sampling immediately. Once Function requests storage, the USB helper
# owns the display and no later logo redraw may cover its instructions.
rm -f /run/rg353ps-hotkeyd.ready "$BOOT_USB_REQUEST"
/usr/sbin/rg353ps-hotkeyd >/dev/null 2>&1 &
echo $! > /run/rg353ps-hotkeyd.pid
# Keep the framebuffer untouched until BASEOS_DATA is mounted by
# baseos-init-userdata. baseos-mount-storage only mounts BASEOS_BOOT.
BOOT_LOGO_DRAWN=0

# Sample held boot keys immediately after input devices appear. Do not wait for
# userdata initialization or first-boot prompts: the user may release Function
# before those potentially long steps finish. The storage helper itself waits
# until /mnt/SDCARD is mounted before exporting it.
i=0
while [ ! -e /run/rg353ps-hotkeyd.ready ] && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i+1)); done

/usr/sbin/baseos-mount-storage

# Successful userdata initialization is routine; keep its trace in tmpfs and
# persist a copy on BASEOS_BOOT only if the initialization loop fails.
if grep -q ' /mnt/boot ' /proc/mounts 2>/dev/null; then
  rm -f /mnt/boot/baseos-userdata-init.txt 2>/dev/null || :
fi
: > /tmp/baseos-userdata-init.txt 2>/dev/null || :

# Keep boot diagnostics in the kernel ring buffer, not on the handheld screen.
dmesg -n 1 2>/dev/null || :

# Storage and panel support are built into this kernel configuration. Load the
# mainline RTL8821CS Wi-Fi function; Bluetooth is attached through UART/serdev.
if [ -x /sbin/modprobe ]; then
  /sbin/modprobe rtw88_8821cs 2>/dev/null || :
  /sbin/modprobe hci_uart 2>/dev/null || :
  /sbin/modprobe btrtl 2>/dev/null || :
  /sbin/modprobe hantro-vpu 2>/dev/null || log "WARNING: Hantro VPU driver failed to load"
  # The DRM display controller is built in, but 3D rendering and RGA are
  # modular in this kernel config. Load them explicitly in this minimal
  # userspace, which does not run a full udev daemon for modalias autoloading.
  /sbin/modprobe panfrost 2>/dev/null || log "WARNING: Panfrost GPU driver failed to load"
  /sbin/modprobe rockchip_rga 2>/dev/null || log "NOTICE: Rockchip RGA driver unavailable"
fi

# One-shot, opt-in suspend/wakeup inventory. Create an empty
# BASEOS-SUSPEND-AUDIT file on BASEOS_BOOT from a PC to request a report on
# the next boot. Consume the request before running so it will not repeat.
if [ -e /mnt/boot/BASEOS-SUSPEND-AUDIT ] && [ -x /usr/sbin/rg353ps-suspend-audit ]; then
  rm -f /mnt/boot/BASEOS-SUSPEND-AUDIT
  /usr/sbin/rg353ps-suspend-audit /mnt/boot >/dev/null 2>&1 || \
    log "WARNING: RG353PS suspend audit failed; check /mnt/boot"
  log "RG353PS suspend audit requested; report saved on BASEOS_BOOT"
fi

log "BaseOS userspace initialized for RG353PS"

# Do not start the diagnostic UI until user storage has been initialized.
# The status pill overlays the selected full-screen background during first-boot work.
BOOT_STORAGE_MARKER=/mnt/boot/.baseos-userdata-v1
FIRST_BOOT=0
SHOW_STARTUP_STATUS=1
# During a Function-triggered storage boot, the USB helper owns the display
# once it starts; unrelated first-boot pills must not cover its instructions.
if [ -e "$BOOT_USB_REQUEST" ]; then SHOW_STARTUP_STATUS=0; fi
if [ ! -e "$BOOT_STORAGE_MARKER" ]; then
  FIRST_BOOT=1
  if [ "$SHOW_STARTUP_STATUS" -eq 1 ]; then
    /usr/bin/fbsplash 45 "EXPANDING STORAGE" 2>/dev/null || :
  fi
fi

while :; do
  /usr/sbin/baseos-init-userdata
  INIT_RC=$?
  if grep -q " /mnt/SDCARD " /proc/mounts && [ -e "$BOOT_STORAGE_MARKER" ]; then
    break
  fi
  if grep -q ' /mnt/boot ' /proc/mounts 2>/dev/null; then
    cp /tmp/baseos-userdata-init.txt /mnt/boot/baseos-userdata-init.txt 2>/dev/null || :
  fi
  # Exit 3 means the initializer changed the partition table but the kernel has
  # not published the new block node yet. Looping cannot resolve that and used
  # to leave a freshly flashed card on a black screen forever, which is
  # indistinguishable from dead hardware. Reboot once and let the second boot
  # find the partition already in place.
  if [ "$INIT_RC" -eq 3 ]; then
    log "User storage needs a reboot to pick up the new partition; rebooting"
    if [ "$SHOW_STARTUP_STATUS" -eq 1 ]; then
      /usr/bin/fbsplash 45 "STORAGE READY - REBOOTING" 2>/dev/null || :
    fi
    sync
    sleep 3
    reboot -f
    exit 0
  fi
  if [ "$SHOW_STARTUP_STATUS" -eq 1 ]; then
    /usr/bin/fbsplash -1 "STORAGE INITIALIZATION FAILED" 2>/dev/null || :
  fi
  log "User storage is not ready; retrying initialization"
  sleep 2
  if [ "$SHOW_STARTUP_STATUS" -eq 1 ]; then
    /usr/bin/fbsplash 45 "EXPANDING STORAGE" 2>/dev/null || :
  fi
done

# Earlier builds wrote a few traces on every boot with no way to turn them off:
# a duplicate baseos.log on the data volume, a boot-key report beside it, and a
# frontend-discovery report on BASEOS_BOOT. Nothing recreates them now unless
# debug=yes is set, but a card that ran one of those builds still carries them,
# and a leftover file looks exactly like "the switch does nothing". Clear them
# once per boot here, after both volumes are mounted and before anything that
# might still want to write one. The card's own baseos.conf wins over /etc.
debug_setting() {
  for _cfg in /mnt/SDCARD/baseos.conf /mnt/boot/baseos.conf /etc/baseos.conf; do
    [ -r "$_cfg" ] || continue
    _val="$(sed -n 's/^debug=//p' "$_cfg" 2>/dev/null | tail -1 | tr -d ' \t\r')"
    if [ -n "$_val" ]; then printf '%s' "$_val"; return 0; fi
  done
  printf 'no'
}
case "$(debug_setting)" in
  yes|YES|Yes|1|on) ;;
  *)
    rm -f /mnt/SDCARD/baseos.log \
          /mnt/SDCARD/rg353ps-boot-key.log \
          /mnt/boot/baseos-frontend-detection.txt 2>/dev/null || :
    ;;
esac

# A freshly updated slot set is on trial until a frontend session starts. If the
# trial never reaches a session, boot-check puts the previous slots back. It runs
# here, not earlier, because the trial state lives on BASEOS_DATA: that is the
# only volume a flip does not move, and it is not mounted until the loop above
# finishes. Nothing else touches the slots before this point, so the ordering
# that matters — boot-check before apply — still holds.
if [ -e /mnt/SDCARD/.baseos/update/state ] && [ -x /usr/sbin/baseos-update ]; then
  /usr/sbin/baseos-update boot-check
fi

# A *.bosupd sitting on either volume means the owner asked for an update: it is
# written into the reserved half of boot and rootfs, read back and verified, and
# only then does the GPT flip commit. baseos-update reboots the unit itself.
if [ ! -e "$BOOT_USB_REQUEST" ] && [ -x /usr/sbin/baseos-update ]; then
  /usr/sbin/baseos-update apply
fi

# BASEOS_DATA is now mounted at /mnt/SDCARD. This is the first point where
# the user-supplied bootlogo can be opened reliably. Never fall back to the
# built-in BaseOS artwork if the custom image cannot be loaded.
if [ ! -e "$BOOT_USB_REQUEST" ] && [ -x /usr/bin/fbsplash ]; then
  if BASEOS_CUSTOM_SPLASH_ONLY=1 /usr/bin/fbsplash 0 >/dev/null 2>&1; then
    BOOT_LOGO_DRAWN=1
  else
    log "WARNING: unable to render custom boot logo after userdata mount"
  fi
  echo 0 > /sys/class/backlight/backlight/bl_power 2>/dev/null || :
fi

if [ "$FIRST_BOOT" -eq 1 ] && [ "$SHOW_STARTUP_STATUS" -eq 1 ]; then
  # Clear the first-boot progress state without repainting the full-screen
  # built-in artwork over a bootloader-provided/custom logo.
  /usr/bin/baseos-splash --important 100 "STORAGE READY" 2>/dev/null || :
fi

# Put the RK817 codec into a usable state before a frontend can open ALSA. The
# rootfs itself never touched the mixer, so the speaker amplifier stayed off and
# every frontend without its own audio daemon came up silent. Backgrounded: it
# waits for the card to probe, and nothing after this needs its result.
[ -x /usr/sbin/baseos-audio-init ] && /usr/sbin/baseos-audio-init >/dev/null 2>&1 &

# USB debug channel: RNDIS network plus a key-only dropbear, reachable over the
# cable on 192.168.42.1. On by default in this bring-up build; baseos.conf can
# turn it off. Started in the background because it waits for the UDC.
# baseos-usb-storage releases and re-takes this gadget around a mass-storage
# session, so a Function-triggered storage boot leaves the port alone.
if [ ! -e "$BOOT_USB_REQUEST" ] && [ -x /usr/sbin/baseos-usb-debug ]; then
  /usr/sbin/baseos-usb-debug start >/dev/null 2>&1 &
fi

# Optional boot-partition task for keyboard-free field diagnostics.
# This hook is deliberately opt-in: normal boots are unchanged unless the
# user places /mnt/boot/BASEOS-RUN.SH on BASEOS_BOOT. Run after BASEOS_DATA is
# mounted, but before tty1 starts the frontend, so the task can inspect the
# previous frontend session's logs and ROM tree.
# Never run the task during a Function-triggered USB-storage boot.
BOOT_TASK=/mnt/boot/BASEOS-RUN.SH
if [ ! -e "$BOOT_USB_REQUEST" ] && [ -f "$BOOT_TASK" ] && [ -r "$BOOT_TASK" ]; then
  TASK_LOG=/mnt/boot/BASEOS-RUN-LOG.txt
  {
    echo "BaseOS RG353PS boot task started: $(date 2>/dev/null || echo unknown)"
    echo "Script: $BOOT_TASK"
  } > "$TASK_LOG" 2>&1
  log "Running boot-partition task: $BOOT_TASK"
  /bin/sh "$BOOT_TASK" >> "$TASK_LOG" 2>&1
  TASK_RC=$?
  printf '\nBaseOS boot task exit status: %s\nFinished: %s\n' "$TASK_RC" "$(date 2>/dev/null || echo unknown)" >> "$TASK_LOG"
  if [ "$TASK_RC" -eq 0 ]; then
    log "Boot-partition task finished; report: /mnt/boot/rg353ps-nextui-rom-scan.txt"
  else
    log "WARNING: boot-partition task exited status $TASK_RC; see /mnt/boot/BASEOS-RUN-LOG.txt"
  fi
  sync 2>/dev/null || :
fi



