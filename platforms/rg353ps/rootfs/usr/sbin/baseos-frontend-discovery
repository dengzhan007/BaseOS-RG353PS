#!/bin/sh
# BaseOS frontend discovery: legacy adapters plus package/profile bundles.
# Metadata is parsed as key=value data and is never sourced or evaluated.
BASEOS_FRONTEND_CR=$(printf '\r')

baseos_frontend_valid_id() {
  case "$1" in ''|.*|-*|_*|*[!A-Za-z0-9._-]*) return 1 ;; esac
  [ "${#1}" -le 48 ]
}

baseos_frontend_read_value() {
  bfrv_file=$1 bfrv_key=$2 bfrv_default=$3
  BASEOS_VALUE=$bfrv_default
  [ -r "$bfrv_file" ] || return 0
  while IFS= read -r bfrv_line || [ -n "$bfrv_line" ]; do
    case "$bfrv_line" in *"$BASEOS_FRONTEND_CR") bfrv_line=${bfrv_line%"$BASEOS_FRONTEND_CR"} ;; esac
    case "$bfrv_line" in "$bfrv_key"=*) BASEOS_VALUE=${bfrv_line#*=} ;; esac
  done < "$bfrv_file"
}

baseos_frontend_valid_priority() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "${#1}" -le 4 ] || return 1
  [ "$1" -le 9999 ] 2>/dev/null
}

# Package layout:
# Frontends/<package-id>/baseos-frontend.conf
# Frontends/<package-id>/launch.sh
# Frontends/<package-id>/profiles/<profile-id>.conf
# The pair package-id--profile-id is the independently selectable instance ID.
baseos_frontend_load_package() {
  bfl_root=$1 bfl_dir=$2 bfl_profile=$3
  bfl_package_id=${bfl_dir##*/}
  bfl_profile_file=${bfl_profile##*/}
  bfl_profile_id=${bfl_profile_file%.conf}
  baseos_frontend_valid_id "$bfl_package_id" || return 1
  baseos_frontend_valid_id "$bfl_profile_id" || return 1
  # The composite package--profile ID must be unambiguous when parsing defaults.
  case "$bfl_package_id:$bfl_profile_id" in *--*) return 1 ;; esac
  [ "${#bfl_package_id}" -le 22 ] || return 1
  [ "${#bfl_profile_id}" -le 22 ] || return 1
  [ -f "$bfl_dir/baseos-frontend.conf" ] && [ ! -L "$bfl_dir/baseos-frontend.conf" ] || return 1
  [ -f "$bfl_dir/launch.sh" ] && [ ! -L "$bfl_dir/launch.sh" ] || return 1
  [ -f "$bfl_profile" ] && [ ! -L "$bfl_profile" ] || return 1

  bfl_manifest=$bfl_dir/baseos-frontend.conf
  baseos_frontend_read_value "$bfl_manifest" package_api ""
  [ "$BASEOS_VALUE" = 1 ] || return 1
  baseos_frontend_read_value "$bfl_profile" profile_api ""
  [ "$BASEOS_VALUE" = 1 ] || return 1

  baseos_frontend_read_value "$bfl_manifest" display_name "$bfl_package_id"
  bfl_package_name=$BASEOS_VALUE
  baseos_frontend_read_value "$bfl_profile" display_name "$bfl_profile_id"
  bfl_profile_name=$BASEOS_VALUE
  case "$bfl_package_name$bfl_profile_name" in *'|'*|*'/'*) return 1 ;; esac

  baseos_frontend_read_value "$bfl_manifest" priority 100
  bfl_priority=$BASEOS_VALUE
  baseos_frontend_read_value "$bfl_profile" priority "$bfl_priority"
  bfl_priority=$BASEOS_VALUE
  baseos_frontend_valid_priority "$bfl_priority" || return 1

  baseos_frontend_read_value "$bfl_manifest" volume_owner system
  bfl_volume_owner=$BASEOS_VALUE
  baseos_frontend_read_value "$bfl_profile" volume_owner "$bfl_volume_owner"
  bfl_volume_owner=$BASEOS_VALUE
  baseos_frontend_read_value "$bfl_manifest" power_owner system
  bfl_power_owner=$BASEOS_VALUE
  baseos_frontend_read_value "$bfl_profile" power_owner "$bfl_power_owner"
  bfl_power_owner=$BASEOS_VALUE
  case "$bfl_volume_owner" in system|frontend) ;; *) return 1 ;; esac
  case "$bfl_power_owner" in system|frontend) ;; *) return 1 ;; esac

  bfl_id=$bfl_package_id--$bfl_profile_id
  baseos_frontend_valid_id "$bfl_id" || return 1

  BASEOS_PACKAGE_KIND=managed
  BASEOS_COMPAT_SOURCE=
  BASEOS_COMPAT_ENTRYPOINT=
  BASEOS_COMPAT_PROGRAM_DIR=
  baseos_frontend_read_value "$bfl_manifest" compat_api ""
  if [ "$BASEOS_VALUE" = 1 ]; then
    baseos_frontend_read_value "$bfl_manifest" compat_source ""
    bfl_compat_source=$BASEOS_VALUE
    case "$bfl_compat_source" in ''|.|..|*/*|*'|'*) return 1 ;; esac
    [ -d "$bfl_root/Frontends/$bfl_compat_source" ] &&
      [ ! -L "$bfl_root/Frontends/$bfl_compat_source" ] || return 1
    BASEOS_PACKAGE_KIND=compat
    BASEOS_COMPAT_SOURCE=$bfl_compat_source
    BASEOS_COMPAT_PROGRAM_DIR=$bfl_root/Frontends/$bfl_compat_source
    BASEOS_PACKAGE_DIR=$BASEOS_COMPAT_PROGRAM_DIR
    baseos_frontend_read_value "$bfl_manifest" compat_entrypoint ""
    BASEOS_COMPAT_ENTRYPOINT=$BASEOS_VALUE
    case "$BASEOS_COMPAT_ENTRYPOINT" in
      launch.sh|start.sh|run.sh|frontend.sh|.tmp_update/updater|.tmp_update/launch.sh|frontend.elf|*.elf) ;;
      *) return 1 ;;
    esac
    case "$BASEOS_COMPAT_ENTRYPOINT" in
      */*) [ "$BASEOS_COMPAT_ENTRYPOINT" = .tmp_update/updater ] ||
           [ "$BASEOS_COMPAT_ENTRYPOINT" = .tmp_update/launch.sh ] || return 1 ;;
    esac
    [ -f "$BASEOS_COMPAT_PROGRAM_DIR/$BASEOS_COMPAT_ENTRYPOINT" ] &&
      [ ! -L "$BASEOS_COMPAT_PROGRAM_DIR/$BASEOS_COMPAT_ENTRYPOINT" ] || return 1
  else
    BASEOS_PACKAGE_DIR=$bfl_dir
  fi

  BASEOS_ADAPTER_API=1
  BASEOS_ADAPTER_PRIORITY=$bfl_priority
  BASEOS_ADAPTER_VOLUME_OWNER=$bfl_volume_owner
  BASEOS_ADAPTER_POWER_OWNER=$bfl_power_owner
  BASEOS_ADAPTER_ID=$bfl_id
  BASEOS_ADAPTER_DIR=$bfl_dir
  BASEOS_ADAPTER_LAUNCHER=$bfl_dir/launch.sh
  BASEOS_PACKAGE_ID=$bfl_package_id
  BASEOS_PROFILE_ID=$bfl_profile_id
  BASEOS_PROFILE_CONFIG=$bfl_profile
  if [ "$bfl_package_name" = "$bfl_profile_name" ]; then
    BASEOS_FRONTEND_NAME=$bfl_package_name
  else
    BASEOS_FRONTEND_NAME="$bfl_package_name / $bfl_profile_name"
  fi
  return 0
}

# Legacy adapter contract remains supported for existing cards.
baseos_frontend_load_manifest() {
  bfa_dir=$1
  bfa_id=${bfa_dir##*/}
  baseos_frontend_valid_id "$bfa_id" || return 1
  bfa_launcher=$bfa_dir/launch.sh
  [ -f "$bfa_launcher" ] || return 1
  BASEOS_ADAPTER_API=1
  BASEOS_ADAPTER_PRIORITY=100
  BASEOS_ADAPTER_VOLUME_OWNER=system
  BASEOS_ADAPTER_POWER_OWNER=system
  bfa_manifest=$bfa_dir/manifest.conf
  if [ -e "$bfa_manifest" ]; then
    [ -r "$bfa_manifest" ] || return 1
    while IFS= read -r bfa_line || [ -n "$bfa_line" ]; do
      case "$bfa_line" in *"$BASEOS_FRONTEND_CR") bfa_line=${bfa_line%"$BASEOS_FRONTEND_CR"} ;; esac
      case "$bfa_line" in ''|\#*) continue ;; *=*) ;; *) continue ;; esac
      bfa_key=${bfa_line%%=*}
      bfa_value=${bfa_line#*=}
      case "$bfa_key" in
        adapter_api) BASEOS_ADAPTER_API=$bfa_value ;;
        priority) BASEOS_ADAPTER_PRIORITY=$bfa_value ;;
        volume_owner) BASEOS_ADAPTER_VOLUME_OWNER=$bfa_value ;;
        power_owner) BASEOS_ADAPTER_POWER_OWNER=$bfa_value ;;
      esac
    done < "$bfa_manifest"
  fi
  [ "$BASEOS_ADAPTER_API" = 1 ] || return 1
  baseos_frontend_valid_priority "$BASEOS_ADAPTER_PRIORITY" || return 1
  case "$BASEOS_ADAPTER_VOLUME_OWNER" in system|frontend) ;; *) return 1 ;; esac
  case "$BASEOS_ADAPTER_POWER_OWNER" in system|frontend) ;; *) return 1 ;; esac
  BASEOS_ADAPTER_ID=$bfa_id
  BASEOS_ADAPTER_DIR=$bfa_dir
  BASEOS_ADAPTER_LAUNCHER=$bfa_launcher
  BASEOS_PACKAGE_ID=
  BASEOS_PROFILE_ID=
  BASEOS_PROFILE_CONFIG=
  BASEOS_PACKAGE_DIR=
  BASEOS_PACKAGE_KIND=legacy
  BASEOS_COMPAT_SOURCE=
  BASEOS_COMPAT_ENTRYPOINT=
  BASEOS_COMPAT_PROGRAM_DIR=
  BASEOS_FRONTEND_NAME=$bfa_id
  return 0
}

baseos_frontend_record_candidate() {
  bfr_id=$1 bfr_root=$2 bfr_dir=$3 bfr_launcher=$4 bfr_kind=$5
  if [ -z "${BASEOS_SCAN_ID:-}" ] || [ "$BASEOS_ADAPTER_PRIORITY" -gt "$BASEOS_SCAN_PRIORITY" ] 2>/dev/null; then
    BASEOS_SCAN_ID=$bfr_id
    BASEOS_SCAN_PRIORITY=$BASEOS_ADAPTER_PRIORITY
    BASEOS_SCAN_ROOT=$bfr_root
    BASEOS_SCAN_DIR=$bfr_dir
    BASEOS_SCAN_LAUNCHER=$bfr_launcher
    BASEOS_SCAN_VOLUME_OWNER=$BASEOS_ADAPTER_VOLUME_OWNER
    BASEOS_SCAN_POWER_OWNER=$BASEOS_ADAPTER_POWER_OWNER
    BASEOS_SCAN_KIND=$bfr_kind
    BASEOS_SCAN_PACKAGE_ID=${BASEOS_PACKAGE_ID:-}
    BASEOS_SCAN_PROFILE_ID=${BASEOS_PROFILE_ID:-}
    BASEOS_SCAN_PROFILE_CONFIG=${BASEOS_PROFILE_CONFIG:-}
    BASEOS_SCAN_PACKAGE_DIR=${BASEOS_PACKAGE_DIR:-}
    BASEOS_SCAN_PACKAGE_KIND=${BASEOS_PACKAGE_KIND:-managed}
    BASEOS_SCAN_COMPAT_SOURCE=${BASEOS_COMPAT_SOURCE:-}
    BASEOS_SCAN_COMPAT_PROGRAM_DIR=${BASEOS_COMPAT_PROGRAM_DIR:-}
    BASEOS_SCAN_COMPAT_ENTRYPOINT=${BASEOS_COMPAT_ENTRYPOINT:-}
    BASEOS_SCAN_NAME=${BASEOS_FRONTEND_NAME:-$bfr_id}
  fi
}

baseos_frontend_consider_package() {
  bcp_root=$1 bcp_dir=$2 bcp_profile=$3 bcp_preference=$4
  baseos_frontend_load_package "$bcp_root" "$bcp_dir" "$bcp_profile" || return 0
  # Explicitly disabled managed profiles stay in the selector catalog but are
  # omitted from automatic and pinned boot discovery.
  if [ "${BASEOS_PACKAGE_KIND:-managed}" != compat ] &&
     [ -e "$bcp_root/.baseos/frontend-disabled/$BASEOS_ADAPTER_ID" ]; then
    return 0
  fi
  # Keep disabled auto-compat packages catalogued, but never launch them.
  if [ "${BASEOS_PACKAGE_KIND:-managed}" = compat ] &&
     [ -e "$bcp_root/.baseos/compat-disabled/$BASEOS_PACKAGE_ID" ]; then
    return 0
  fi
  if [ "$bcp_preference" = "$BASEOS_PACKAGE_ID" ] &&
     [ "${BASEOS_PACKAGE_KIND:-managed}" = compat ]; then
    # Keep an existing simple frontend_id working after a plain folder is
    # automatically wrapped. An explicit legacy adapter with the same ID wins.
    if [ -f "$bcp_root/.baseos/frontends/$BASEOS_PACKAGE_ID/launch.sh" ] ||
       [ -f "$bcp_root/baseos/frontends/$BASEOS_PACKAGE_ID/launch.sh" ]; then
      return 0
    fi
  elif [ "$bcp_preference" != auto ] && [ "$BASEOS_ADAPTER_ID" != "$bcp_preference" ]; then
    # A package may declare one previous package ID when its folder/identity
    # is renamed. Preserve the selected profile across that one-time migration.
    case "$bcp_preference" in *--*) bcp_old_package=${bcp_preference%%--*}; bcp_old_profile=${bcp_preference#*--} ;; *) return 0 ;; esac
    valid_old_package=no
    if baseos_frontend_valid_id "$bcp_old_package" && [ "${#bcp_old_package}" -le 22 ]; then
      valid_old_package=yes
    fi
    [ "$valid_old_package" = yes ] || return 0
    baseos_frontend_read_value "$bcp_dir/baseos-frontend.conf" previous_package_id ""
    [ "$BASEOS_VALUE" = "$bcp_old_package" ] || return 0
    # Prefer the exact old profile ID when it was carried forward. If the new
    # package intentionally ships fewer profiles, allow discovery to fall back
    # to the package's highest-priority available profile instead of diagnostics.
    if [ -f "$bcp_dir/profiles/$bcp_old_profile.conf" ] &&
       [ "$bcp_old_profile" != "$BASEOS_PROFILE_ID" ]; then
      return 0
    fi
  elif [ "$bcp_preference" != auto ]; then
    [ "$BASEOS_ADAPTER_ID" = "$bcp_preference" ] || return 0
  fi
  bcp_kind=package
  [ "${BASEOS_PACKAGE_KIND:-managed}" = compat ] && bcp_kind=compat-package
  baseos_frontend_record_candidate "$BASEOS_ADAPTER_ID" "$bcp_root" "$BASEOS_ADAPTER_DIR" "$BASEOS_ADAPTER_LAUNCHER" "$bcp_kind"
}

baseos_frontend_consider_adapter() {
  bfc_dir=$1 bfc_root=$2 bfc_preference=$3
  bfc_id=${bfc_dir##*/}
  # Keep runtime discovery consistent with the selector's disable operation.
  [ ! -e "$bfc_root/.baseos/frontends-disabled/$bfc_id" ] || return 0
  baseos_frontend_load_manifest "$bfc_dir" || return 0
  [ "$bfc_preference" = auto ] || [ "$BASEOS_ADAPTER_ID" = "$bfc_preference" ] || return 0
  baseos_frontend_record_candidate "$BASEOS_ADAPTER_ID" "$bfc_root" "$BASEOS_ADAPTER_DIR" "$BASEOS_ADAPTER_LAUNCHER" legacy
}

baseos_frontend_scan_package_parent() {
  bsp_root=$1 bsp_parent=$2 bsp_preference=$3
  [ -d "$bsp_parent" ] || return 0
  for bsp_dir in "$bsp_parent"/*; do
    [ -d "$bsp_dir" ] && [ ! -L "$bsp_dir" ] || continue
    [ -f "$bsp_dir/baseos-frontend.conf" ] || continue
    [ -d "$bsp_dir/profiles" ] || continue
    for bsp_profile in "$bsp_dir"/profiles/*.conf; do
      [ -f "$bsp_profile" ] || continue
      baseos_frontend_consider_package "$bsp_root" "$bsp_dir" "$bsp_profile" "$bsp_preference"
    done
  done
}

baseos_frontend_scan_packages() {
  bsp_root=$1 bsp_preference=$2
  baseos_frontend_scan_package_parent "$bsp_root" "$bsp_root/Frontends" "$bsp_preference"
  baseos_frontend_scan_package_parent "$bsp_root" "$bsp_root/.baseos/compat" "$bsp_preference"
}

baseos_frontend_scan_container() {
  bsc_root=$1 bsc_preference=$2
  # New packages are considered first; equal priority therefore prefers the
  # explicitly managed package format over a legacy adapter.
  baseos_frontend_scan_packages "$bsc_root" "$bsc_preference"
  for bsc_parent in "$bsc_root/.baseos/frontends" "$bsc_root/baseos/frontends"; do
    [ -d "$bsc_parent" ] || continue
    for bsc_dir in "$bsc_parent"/*; do
      [ -d "$bsc_dir" ] || continue
      baseos_frontend_consider_adapter "$bsc_dir" "$bsc_root" "$bsc_preference"
    done
  done
}

# Scan one card root and one wrapper-directory level without forking per adapter.
baseos_frontend_scan_root() {
  bfs_root=$1 bfs_preference=$2
  BASEOS_SCAN_ID= BASEOS_SCAN_PRIORITY=0 BASEOS_SCAN_ROOT= BASEOS_SCAN_DIR= BASEOS_SCAN_LAUNCHER=
  BASEOS_SCAN_VOLUME_OWNER=system BASEOS_SCAN_POWER_OWNER=system
  BASEOS_SCAN_KIND=legacy BASEOS_SCAN_PACKAGE_ID= BASEOS_SCAN_PROFILE_ID=
  BASEOS_SCAN_PROFILE_CONFIG= BASEOS_SCAN_PACKAGE_DIR= BASEOS_SCAN_NAME=
  BASEOS_SCAN_PACKAGE_KIND=managed BASEOS_SCAN_COMPAT_SOURCE=
  BASEOS_SCAN_COMPAT_PROGRAM_DIR= BASEOS_SCAN_COMPAT_ENTRYPOINT=
  baseos_frontend_scan_container "$bfs_root" "$bfs_preference"
  for bfs_nested in "$bfs_root"/*; do
    [ -d "$bfs_nested" ] && [ ! -L "$bfs_nested" ] || continue
    baseos_frontend_scan_container "$bfs_nested" "$bfs_preference"
  done
  # Historical frontend archives are often installed as a self-contained
  # directory under Frontends/<name>/. Their adapter lives one level deeper
  # than the older root/wrapper layouts, beside .system/ and Tools/.
  for bfs_frontend in "$bfs_root"/Frontends/*; do
    [ -d "$bfs_frontend" ] && [ ! -L "$bfs_frontend" ] || continue
    baseos_frontend_scan_container "$bfs_frontend" "$bfs_preference"
  done
  [ -n "$BASEOS_SCAN_ID" ]
}

# Detect changes to either package/profile trees or legacy adapters.
baseos_frontend_tree_changed_since() {
  bft_root=$1
  bft_cache=$2
  [ -f "$bft_cache" ] || return 0
  for bft_container in "$bft_root" "$bft_root"/* "$bft_root"/Frontends/*; do
    [ -d "$bft_container" ] || continue
    for bft_packages in "$bft_container/Frontends" "$bft_container/.baseos/compat"; do
      [ -d "$bft_packages" ] || continue
      [ "$bft_packages" -nt "$bft_cache" ] && return 0
      for bft_package in "$bft_packages"/*; do
        [ -d "$bft_package" ] || continue
        [ "$bft_package" -nt "$bft_cache" ] && return 0
        for bft_file in "$bft_package/baseos-frontend.conf" "$bft_package/launch.sh" "$bft_package/profiles" "$bft_package"/profiles/*.conf; do
          [ -e "$bft_file" ] && [ "$bft_file" -nt "$bft_cache" ] && return 0
        done
        if [ -f "$bft_package/baseos-frontend.conf" ]; then
          baseos_frontend_read_value "$bft_package/baseos-frontend.conf" compat_source ""
          bft_compat_source=$BASEOS_VALUE
          baseos_frontend_read_value "$bft_package/baseos-frontend.conf" compat_entrypoint ""
          bft_compat_entrypoint=$BASEOS_VALUE
          if [ -n "$bft_compat_source" ] && [ -n "$bft_compat_entrypoint" ]; then
            bft_source_file="$bft_container/Frontends/$bft_compat_source/$bft_compat_entrypoint"
            [ -e "$bft_source_file" ] && [ "$bft_source_file" -nt "$bft_cache" ] && return 0
          fi
        fi
      done
    done
    for bft_parent in "$bft_container/.baseos/frontends" "$bft_container/baseos/frontends"; do
      [ -d "$bft_parent" ] || continue
      [ "$bft_parent" -nt "$bft_cache" ] && return 0
      for bft_adapter in "$bft_parent"/*; do
        [ -d "$bft_adapter" ] || continue
        [ "$bft_adapter" -nt "$bft_cache" ] && return 0
        [ -f "$bft_adapter/launch.sh" ] && [ "$bft_adapter/launch.sh" -nt "$bft_cache" ] && return 0
        [ -f "$bft_adapter/manifest.conf" ] && [ "$bft_adapter/manifest.conf" -nt "$bft_cache" ] && return 0
      done
    done
    for bft_disabled in "$bft_container/.baseos/frontends-disabled" "$bft_container/.baseos/frontend-disabled" "$bft_container/.baseos/compat-disabled"; do
      if [ -d "$bft_disabled" ]; then
        [ "$bft_disabled" -nt "$bft_cache" ] && return 0
        for bft_marker in "$bft_disabled"/*; do
          [ -e "$bft_marker" ] && [ "$bft_marker" -nt "$bft_cache" ] && return 0
        done
      fi
    done
  done
  return 1
}
