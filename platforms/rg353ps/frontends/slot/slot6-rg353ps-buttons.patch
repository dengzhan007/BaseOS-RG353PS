 pub fn code_to_btn(code: u16) -> Option<Btn> {
     Some(match code {
-        0x130 => Btn::A,
-        0x131 => Btn::B,
-        0x132 => Btn::Y,
-        0x133 => Btn::X,
-        0x134 => Btn::L1,
-        0x135 => Btn::R1,
-        0x136 => Btn::Select,
-        0x137 => Btn::Start,
-        0x138 => Btn::Menu,
-        0x13a => Btn::L2,
-        0x13b => Btn::R2,
+        // RG353PS physical layout; face labels follow Nintendo order.
+        0x130 => Btn::B,      // BTN_SOUTH
+        0x131 => Btn::A,      // BTN_EAST
+        0x133 => Btn::X,      // BTN_NORTH
+        0x134 => Btn::Y,      // BTN_WEST
+        0x136 => Btn::L1,     // BTN_TL
+        0x137 => Btn::R1,     // BTN_TR
+        0x138 => Btn::L2,     // BTN_TL2
+        0x139 => Btn::R2,     // BTN_TR2
+        0x13a => Btn::Select,
+        0x13b => Btn::Start,
+        0x13c => Btn::Menu,   // BTN_MODE / Function
+        // D-pad as BTN_DPAD_* or KEY_UP/DOWN/LEFT/RIGHT.
+        0x220 | 103 => Btn::Up,
+        0x221 | 108 => Btn::Down,
+        0x222 | 105 => Btn::Left,
+        0x223 | 106 => Btn::Right,
         115 => Btn::VolUp,
         114 => Btn::VolDown,
-        116 => Btn::Power,
+        // KEY_POWER (116) remains with rg353ps-hotkeyd in this milestone.
         // 0x162 arrives immediately behind 0x138 on one press of MENU. Mapping it too would
         // make every menu press a double tap, which is the gesture the state switcher opens
         // on, so it is deliberately nothing.
         _ => return None,
     })
 }
