-/// 屏是 720x480，开机图必须**整幅**：宽、高、24 位。
-pub const W: u32 = 720;
+/// RG353PS panel is 640x480. The boot partition accepts a full-frame, 24-bit BMP.
+pub const W: u32 = 640;
 pub const H: u32 = 480;
 
-/// 54 字节头 + 720·480·3。行字节 2160 正好是 4 的倍数，24 位 bmp 没有行补齐。
+/// 54-byte header + 640·480·3. Each 24-bit row is 1920 bytes, already 4-byte aligned.
 pub const BYTES: usize = 54 + (W as usize) * (H as usize) * 3;
