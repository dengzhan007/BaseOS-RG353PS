# RG353PS U-Boot configuration, merged over anbernic-rgxx3-rk3566_defconfig by
# build-uboot.sh. Keep entries minimal and explain each one: every line here is
# a change from the board's upstream defaults.

# The board default is 2, so every boot spends two seconds in autoboot waiting
# for a key press that can never come: this unit has no serial console, and the
# gamepad is not polled by U-Boot. Measured on the device with boot-clock, the
# whole pre-kernel stage is 6.19 s; this is two of them for nothing.
CONFIG_BOOTDELAY=0

# Bootstage: record each stage in the device tree handed to the kernel, so one
# boot yields the pre-kernel split on the device itself
# (/proc/device-tree/bootstage/record@*/name + mark, arch-counter microseconds
# from power-on). The console report stays off: this unit has no serial console.
CONFIG_BOOTSTAGE=y
CONFIG_BOOTSTAGE_FDT=y
# CONFIG_BOOTSTAGE_REPORT is not set

# image_setup_libfdt() shrinks the tree to its minimum before the report is
# added; 0009 grows it back into this pad. With the default only the last few
# records fit, and the earliest ones are the ones worth having.
CONFIG_SYS_FDT_PAD=0x6000

# board_late_init spends 234.8 ms on this board and both items below are
# measured with the bootstage marks in 0013, warm reboot:
#   rgxx3_detect_display()  34.5 ms - the panel ID selects a compatible string
#                           for a boot script we do not have (0012)
#   startup_buzz()         200.1 ms - a fixed delay so the chime is audible
#                           (0014). Delete this line to get the chime back.
CONFIG_RGXX3_SKIP_PANEL_ID=y
CONFIG_RGXX3_SKIP_STARTUP_BUZZ=y
