#!/bin/sh
# RG353PS deep-suspend driver: cut SDIO WiFi power for the sleep window, wake,
# then bring the combo back and report the measured sleep current.
#
# This is the executable form of option A. It is intentionally separate from
# rg353ps-suspend-test (which is pinned to s2idle) so the known-good s2idle
# diagnostic keeps working unchanged.
#
# Usage:
#   rg353ps-suspend-deep [--wifi-off] [--settle SECONDS] [--wake-after SECONDS]
#
#   --wifi-off        unbind the rtw88 SDIO function before sleeping so the MMC
#                     core can actually cut vcc_wifi, then rebind after wake.
#                     Without it the sleep current should look like the ~41 mA
#                     baseline; with it we expect ~30 mA until the DTB change
#                     lands and the rail is truly switched off.
#   --settle SECONDS  idle time before blanking (default 3)
#   --wake-after SECS arm the RTC alarm for SECS from now, so a headless unit
#                     wakes itself instead of waiting for a power-key press
#
# Requires the DTB to have dropped "keep-power-in-suspend" (patch 0020) for the
# rail to actually switch; otherwise unbinding only costs resume time.
set -u

WIFI_OFF=0
SETTLE=3
WAKE_AFTER=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --wifi-off)   WIFI_OFF=1 ;;
    --settle)     shift; [ "$#" -ge 1 ] || { echo "missing value for --settle" >&2; exit 2; }; SETTLE=$1 ;;
    --wake-after) shift; [ "$#" -ge 1 ] || { echo "missing value for --wake-after" >&2; exit 2; }; WAKE_AFTER=$1 ;;
    -h|--help)    sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)            echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

WIFI_CYCLE=/usr/sbin/rg353ps-wifi-cycle
REPORT=/tmp/rg353ps-suspend-deep-$(date -u +%Y%m%d-%H%M%S 2>/dev/null || echo run).txt
[ -w /mnt/boot ] && grep -q ' /mnt/boot ' /proc/mounts 2>/dev/null && REPORT=/mnt/boot/$(basename "$REPORT")

exec >>"$REPORT" 2>&1

log() { printf '%s\n' "$*"; printf '%s\n' "$*" > /dev/kmsg 2>/dev/null; return 0; }
fail() { log "ERROR: $*"; exit 1; }

# --- battery gauge ----------------------------------------------------------
# There is no serial console on the test unit, so the report has to carry enough
# raw data to be judged offline. Do not assume a node name: walk every
# power_supply and keep the first one declaring type=Battery.
BATT=
for d in /sys/class/power_supply/*; do
  [ -d "$d" ] || continue
  [ -r "$d/type" ] || continue
  [ "$(cat "$d/type" 2>/dev/null)" = "Battery" ] || continue
  BATT="$d"
  break
done
[ -n "$BATT" ] || BATT=/sys/class/power_supply/battery

# charge_now (uAh) is what we want; energy_now (uWh) and charge_counter are
# accepted fallbacks. Whichever answers first is read for both samples so the
# delta is always apples to apples.
GAUGE=
for a in charge_now charge_counter energy_now; do
  [ -r "$BATT/$a" ] && { GAUGE="$BATT/$a"; break; }
done

gauge_value() { [ -n "$GAUGE" ] && cat "$GAUGE" 2>/dev/null; }

dump_battery() {
  log "--- power_supply inventory ---"
  for d in /sys/class/power_supply/*; do
    [ -d "$d" ] || continue
    log "  $(basename "$d"): type=$(cat "$d/type" 2>/dev/null)"
  done
  log "--- $BATT attributes ---"
  if [ ! -d "$BATT" ]; then
    log "  (directory $BATT missing)"
    return 0
  fi
  for f in "$BATT"/*; do
    [ -f "$f" ] || continue
    log "  $(basename "$f") = $(cat "$f" 2>/dev/null)"
  done
  return 0
}

# The DTS label is vcc_wifi but the node name is regulator-vcc-wifi, so search
# on the node name. These five lines decide whether the rail can be cut at all:
# a stray regulator-always-on makes every later step pointless.
dump_devicetree() {
  log "--- device tree: WiFi rail ---"
  # Try the concrete paths first: busybox find does not always accept
  # -maxdepth, and a false "not found" here would read as a DTB problem.
  W=
  for p in /proc/device-tree/regulator-vcc-wifi \
           /proc/device-tree/soc/regulator-vcc-wifi \
           /proc/device-tree/soc@0/regulator-vcc-wifi; do
    [ -d "$p" ] && { W="$p"; break; }
  done
  [ -n "$W" ] || W=$(find /proc/device-tree -name 'regulator-vcc-wifi' 2>/dev/null | head -1)
  if [ -n "$W" ]; then
    log "  node: ${W#/proc/device-tree/}"
    if [ -e "$W/regulator-always-on" ]; then
      log "  regulator-always-on: PRESENT  <-- rail can never be cut; sleep current will not move"
    else
      log "  regulator-always-on: absent   <-- rail is switchable"
    fi
    [ -e "$W/regulator-boot-on" ] && log "  regulator-boot-on: present (enable once at boot; does not block suspend)"
  else
    log "  regulator-vcc-wifi node NOT FOUND"
  fi
  M=
  for p in /proc/device-tree/mmc@fe000000 \
           /proc/device-tree/soc/mmc@fe000000 \
           /proc/device-tree/soc@0/mmc@fe000000; do
    [ -d "$p" ] && { M="$p"; break; }
  done
  [ -n "$M" ] || M=$(find /proc/device-tree -name 'mmc@fe000000' 2>/dev/null | head -1)
  if [ -n "$M" ]; then
    log "  sdio host: ${M#/proc/device-tree/}"
    log "    status=$(tr -d '\0' < "$M/status" 2>/dev/null)"
    if [ -e "$M/keep-power-in-suspend" ]; then
      log "    keep-power-in-suspend: present (irrelevant while the function driver is unbound)"
    else
      log "    keep-power-in-suspend: absent"
    fi
  else
    log "  mmc@fe000000 (SDIO) node NOT FOUND"
  fi
  return 0
}

dump_regulators() {
  log "--- regulators ---"
  for r in /sys/class/regulator/regulator.*; do
    [ -d "$r" ] || continue
    n=$(cat "$r/name" 2>/dev/null)
    [ "$n" = "vcc_wifi" ] && log "  $n: state=$(cat "$r/state" 2>/dev/null) users=$(cat "$r/num_users" 2>/dev/null)  <-- WiFi rail"
  done
  for r in /sys/class/regulator/regulator.*; do
    [ -d "$r" ] || continue
    n=$(cat "$r/name" 2>/dev/null)
    [ "$n" = "vcc_wifi" ] && continue
    log "  $n: $(cat "$r/state" 2>/dev/null)"
  done
  return 0
}

BACKLIGHT=
BACKLIGHT_OLD=
POWER_PID=
MODE_OLD=
WIFI_UNBOUND=0

restore() {
  [ -n "$BACKLIGHT" ] && [ -w "$BACKLIGHT" ] && printf '%s\n' "$BACKLIGHT_OLD" > "$BACKLIGHT" 2>/dev/null
  if [ -n "$POWER_PID" ] && kill -0 "$POWER_PID" 2>/dev/null; then
    kill "$POWER_PID" 2>/dev/null
  fi
  if [ "$WIFI_UNBOUND" = 1 ] && [ -x "$WIFI_CYCLE" ]; then
    "$WIFI_CYCLE" bind || log "WARNING: wifi rebind failed; run '$WIFI_CYCLE bind' manually"
  fi
  if [ -n "$MODE_OLD" ] && [ -w /sys/power/mem_sleep ]; then
    printf '%s\n' "$MODE_OLD" > /sys/power/mem_sleep 2>/dev/null
  fi
}
trap 'restore' EXIT INT TERM

read_attr()   { cat "$1" 2>/dev/null; }

log "=== rg353ps-suspend-deep $(date -u 2>/dev/null) ==="
log "args: wifi_off=$WIFI_OFF settle=$SETTLE"
log "report: $REPORT"
log "gauge: ${GAUGE:-<none found>}"
read_attr /proc/version | sed 's/^/kernel: /'
[ -r /proc/device-tree/model ] && log "model: $(tr -d '\0' < /proc/device-tree/model 2>/dev/null)"

# --- preconditions ----------------------------------------------------------
[ -r /sys/power/state ] || fail "/sys/power/state not readable"
grep -qw mem /sys/power/state || fail "kernel does not expose the mem state"
MEM_MODES="$(tr -d '[]' < /sys/power/mem_sleep 2>/dev/null || :)"
case " $MEM_MODES " in
  *" deep "*) ;;
  *) fail "deep is not available in mem_sleep: $(read_attr /sys/power/mem_sleep)" ;;
esac

MODE_OLD="$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' /sys/power/mem_sleep 2>/dev/null)"
[ -n "$MODE_OLD" ] || fail "cannot read current mem_sleep mode"

for c in /sys/class/backlight/*/brightness; do
  [ -r "$c" ] && [ -w "$c" ] || continue
  v="$(read_attr "$c")"
  case "$v" in ''|*[!0-9]*) continue ;; esac
  BACKLIGHT="$c"; BACKLIGHT_OLD="$v"; break
done
[ -n "$BACKLIGHT" ] || fail "no writable backlight found"

# The power key only needs grabbing when a human presses it to wake. At boot
# there is no frontend running yet, so a missing evtest/grab must not abort an
# otherwise valid current measurement - there is no console to recover from.
POWER_EVENT=
for nf in /sys/class/input/event*/device/name; do
  [ -r "$nf" ] || continue
  [ "$(read_attr "$nf")" = "rk805 pwrkey" ] || continue
  e=${nf#/sys/class/input/}; POWER_EVENT="/dev/input/${e%%/*}"; break
done
if [ -z "$POWER_EVENT" ]; then
  log "WARNING: rk805 pwrkey not found; skipping the exclusive grab"
elif ! command -v evtest >/dev/null 2>&1; then
  log "WARNING: evtest missing; skipping the exclusive grab"
  POWER_EVENT=
fi

# Arm an RTC wake so the unit does not depend on someone pressing the power key
# at the right moment. Best effort: if the RTC refuses, the power key still
# wakes the SoC.
WAKEALARM=
if [ "${WAKE_AFTER:-0}" -gt 0 ] 2>/dev/null; then
  WE=/sys/class/rtc/rtc0/device/power/wakeup
  [ -w "$WE" ] && printf 'enabled\n' > "$WE" 2>/dev/null
  W=/sys/class/rtc/rtc0/wakealarm
  if [ -w "$W" ]; then
    printf '0\n' > "$W" 2>/dev/null
    if printf '+%s\n' "$WAKE_AFTER" > "$W" 2>/dev/null; then
      WAKEALARM=$(read_attr "$W")
      log "rtc wakealarm armed for +${WAKE_AFTER}s (rtc=$WAKEALARM)"
    else
      log "WARNING: could not arm $W; wake with the power button"
    fi
  else
    log "WARNING: $W not writable; wake with the power button"
  fi
fi

Q_BEFORE=$(gauge_value)
CAP_BEFORE=$(cat "$BATT/capacity" 2>/dev/null)
if [ -z "$Q_BEFORE" ]; then
  log "WARNING: no readable charge/energy gauge; the current estimate will be unavailable"
fi
dump_battery
dump_devicetree
dump_regulators
T_BEFORE=$(date +%s 2>/dev/null || echo 0)

log "mem_sleep_before=$(read_attr /sys/power/mem_sleep | tr '\n' ' ')"
log "gauge_before=$Q_BEFORE (source $GAUGE)"
log "suspend_success_before=$(read_attr /sys/power/suspend_stats/success)"
log "suspend_fail_before=$(read_attr /sys/power/suspend_stats/fail)"
log "wakeup_count_before=$(read_attr /sys/power/wakeup_count | tr '\n' ' ')"

# --- cut WiFi ---------------------------------------------------------------
if [ "$WIFI_OFF" = 1 ]; then
  [ -x "$WIFI_CYCLE" ] || fail "$WIFI_CYCLE is missing"
  log "--- unbinding SDIO WiFi ---"
  if "$WIFI_CYCLE" unbind; then
    WIFI_UNBOUND=1
    log "wifi unbound (vcc_wifi is now switchable at suspend)"
    # vcc_wifi users should drop to 0 here. If it stays >0 something else still
    # holds the rail and the sleep current will not improve.
    dump_regulators
  else
    fail "wifi unbind failed; refusing to sleep in an unknown state"
  fi
else
  log "wifi stays bound (keep-power path active; expect the 41 mA baseline)"
fi

# --- select deep ------------------------------------------------------------
if printf 'deep\n' > /sys/power/mem_sleep 2>/dev/null; then
  SELECTED="$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' /sys/power/mem_sleep 2>/dev/null)"
  [ "$SELECTED" = "deep" ] || fail "kernel refused deep: $(read_attr /sys/power/mem_sleep)"
  log "mem_sleep=deep selected"
else
  fail "failed to write deep to /sys/power/mem_sleep"
fi

# --- settle, grab key, blank ------------------------------------------------
log "settling ${SETTLE}s before blanking"
sleep "$SETTLE"

if [ -n "$POWER_EVENT" ]; then
  : > /tmp/rg353ps-deep-powerkey.log
  evtest --grab "$POWER_EVENT" > /tmp/rg353ps-deep-powerkey.log 2>&1 &
  POWER_PID=$!
  i=0
  while [ "$i" -lt 30 ] && ! grep -q 'Testing .*interrupt to exit' /tmp/rg353ps-deep-powerkey.log 2>/dev/null; do
    if ! kill -0 "$POWER_PID" 2>/dev/null; then
      log "WARNING: evtest exited during grab setup; continuing without grab"
      POWER_PID=
      break
    fi
    sleep 0.1; i=$((i+1))
  done
  [ -n "$POWER_PID" ] && log "power key grabbed ($POWER_EVENT)"
else
  log "no power-key grab; wake source is the RTC alarm or a manual press"
fi

sync
log "--- entering deep suspend ---"
printf '0\n' > "$BACKLIGHT" 2>/dev/null

if printf 'mem\n' > /sys/power/state; then
  RC=0
else
  RC=$?
fi

# --- after resume -----------------------------------------------------------
T_AFTER=$(date +%s 2>/dev/null || echo 0)
log "suspend_write_exit=$RC"
log "resumed_at=$(date -u 2>/dev/null)"

[ -n "$BACKLIGHT" ] && [ -w "$BACKLIGHT" ] && printf '%s\n' "$BACKLIGHT_OLD" > "$BACKLIGHT" 2>/dev/null

if [ "$WIFI_UNBOUND" = 1 ]; then
  log "--- rebinding SDIO WiFi ---"
  if "$WIFI_CYCLE" bind; then
    WIFI_UNBOUND=0
    log "wifi back up"
  else
    log "ERROR: wifi did not come back; keeping state for manual recovery"
  fi
fi

Q_AFTER=$(gauge_value)
CAP_AFTER=$(cat "$BATT/capacity" 2>/dev/null)
CUR_AVG_AFTER=$(cat "$BATT/current_avg" 2>/dev/null)
log "gauge_after=$Q_AFTER (source $GAUGE)"
log "capacity_before=$CAP_BEFORE capacity_after=$CAP_AFTER"
log "current_avg_after=$CUR_AVG_AFTER uA"
log "suspend_success_after=$(read_attr /sys/power/suspend_stats/success)"
log "suspend_fail_after=$(read_attr /sys/power/suspend_stats/fail)"
dump_battery

# --- sleep-current estimate -------------------------------------------------
# Three sources, in decreasing order of trustworthiness. The rk817 coulomb
# counter printed by the charger driver at resume is the best one: it is the
# chip's own accumulator across the sleep window and is not touched by the
# OCV-based soc recalibration. charge_now is NOT safe on its own - the driver
# recomputes soc from the open-circuit voltage while asleep, so the counter can
# jump *up* by hundreds of uAh even though the pack only ever discharged.
SLEEP_DONE=0
if [ -n "$Q_AFTER" ] && [ -n "$Q_BEFORE" ] && [ "$T_AFTER" -gt "$T_BEFORE" ]; then
  SECS=$((T_AFTER - T_BEFORE))
  DQ=$((Q_BEFORE - Q_AFTER))
  SLEEP_DONE=1
  log "sleep_window=${SECS}s delta_gauge=${DQ}"

  # --- source 1: driver coulomb counter ---
  CNTLINE=$(dmesg 2>/dev/null | grep -o 'resume after [0-9][0-9]*s: counter [0-9][0-9]* uAh ([0-9][0-9]* at suspend)' | tail -1)
  if [ -n "$CNTLINE" ]; then
    CSECS=$(printf '%s\n' "$CNTLINE" | sed -n 's/resume after \([0-9][0-9]*\)s:.*/\1/p')
    CATS=$(printf '%s\n' "$CNTLINE" | sed -n 's/.*(\([0-9][0-9]*\) at suspend).*/\1/p')
    CNOW=$(printf '%s\n' "$CNTLINE" | sed -n 's/.*counter \([0-9][0-9]*\) uAh.*/\1/p')
    log "driver_counter: $CNTLINE"
    if [ -n "$CSECS" ] && [ -n "$CATS" ] && [ -n "$CNOW" ] && [ "$CSECS" -gt 0 ] && [ "$CATS" -gt "$CNOW" ]; then
      CQ=$((CATS - CNOW))
      CMA=$(awk -v q="$CQ" -v s="$CSECS" 'BEGIN { printf "%.1f", (q * 3.6) / s }')
      log "driver_counter_delta=${CQ}uAh over ${CSECS}s"
      log "AUTHORITATIVE average_current=${CMA} mA  (RK817 coulomb counter, OCV-recalibration immune)"
    fi
  else
    log "driver_counter: resume line not found in dmesg"
  fi

  # --- source 2: charge_now delta, only when it actually went down ---
  if [ "$DQ" -gt 0 ]; then
    case "$GAUGE" in
      *energy_now)
        MA=$(awk -v q="$DQ" -v s="$SECS" 'BEGIN { printf "%.1f", (q * 3.6 / s) / 3.8 }')
        log "average_current_from_gauge=${MA} mA (energy_now uWh, assumes 3.80 V nominal)"
        ;;
      *)
        MA=$(awk -v q="$DQ" -v s="$SECS" 'BEGIN { printf "%.1f", (q * 3.6) / s }')
        log "average_current_from_gauge=${MA} mA"
        ;;
    esac
  else
    log "charge_now delta is ${DQ} (non-negative while discharging): the fuel gauge"
    log "  recalibrated soc from the open-circuit voltage during sleep, so this delta"
    log "  is unusable. Do not report it as a current."
    if [ -n "$CUR_AVG_AFTER" ]; then
      MA=$(awk -v c="$CUR_AVG_AFTER" 'BEGIN { if (c < 0) c = -c; printf "%.1f", c / 1000 }')
      log "average_current_from_current_avg=${MA} mA (battery/current_avg at resume)"
    fi
  fi
else
  log "current estimate unavailable (no usable gauge or bad clock)"
fi

log "--- kernel log tail ---"
dmesg 2>&1 | grep -iE 'suspend|resume|PM:|mmc2|sdio|rtw88|vcc_wifi|regulator' | tail -60

log "=== done; report at $REPORT ==="
exit "$RC"
