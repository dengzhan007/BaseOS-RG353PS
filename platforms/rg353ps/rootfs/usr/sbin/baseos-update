#!/bin/sh
# BaseOS system update — A/B slot updates that leave the card's files alone.
#
# `boot` and `rootfs` each have twice their size reserved on the card, and only
# one half of each is a partition at a time; the other is unallocated space
# reached by raw offset. An update writes both inactive halves, verifies them by
# reading them back, and only then flips the GPT — so the flip is the single
# commit point, and power loss before it leaves the card byte-identical. The
# data partition is never touched, which is the point: ROMs, saves and settings
# survive what would otherwise be a reflash.
#
#   apply       find and apply a *.bosupd payload (rcS)
#   boot-check  restore the previous slots if this one never reaches a session (rcS)
#   confirm     end the trial (frontend-session)
#   status      what is installed, and what each payload on the card would do
#
# Payload: an uncompressed tar named *.bosupd holding `manifest` and one
# `<region>.img.gz` per region, each a whole slot. Integrity is the SHA-256 in
# the manifest, checked by reading back what was written. There is deliberately
# no signing key: it would be a single point of failure for every update, and
# these images carry no secrets.
#
# Both regions are written every time, even when a release changes only the
# rootfs. The boot volume is live, so comparing first cannot be trusted.

FORMAT=baseos-update/2
# No `uboot` here on purpose. The RG353PS boot chain is Rockchip's SPL followed
# by mainline U-Boot, and that SPL reads u-boot.itb from a fixed sector (16384)
# rather than by partition name — so the loader region has no second half it
# could be moved to. Only boot and rootfs take part in an update.
REGIONS="boot rootfs"
# Resolved at run time from what is mounted: the device can boot from either
# card slot, so no mmcblk number may be baked in here.
DISK=
BOOT_MNT=/mnt/boot
CARD=/mnt/SDCARD
# The second card: the frontend and the games live there when one is inserted,
# and USB storage mode exports it, so a payload copied over the cable lands here.
FRONTEND_MNT=/mnt/TF2
# Trial state must not live on a volume that an update moves.
#
# It used to sit in /mnt/boot/update. BASEOS_BOOT is one of the two regions the
# flip swaps, so the flip relocated the very directory holding this file: the
# next boot mounted the freshly written boot slot, found no state there, and
# both halves of the update contract silently stopped working. `confirm` never
# ran, so an applied payload was never deleted and every later boot kept
# treating the card as freshly updated; `boot-check` never ran, so a slot set
# that could not reach a session was never rolled back and the trial counter
# never advanced.
#
# BASEOS_DATA is the one volume an update never touches, which is exactly what
# this state has to outlive. Upstream keeps it on /data for the same reason.
STATE_DIR="$CARD/.baseos/update"
STATE="$STATE_DIR/state"
# Cards updated by a build that still wrote the old path: read it once so an
# update in flight across the change is still confirmed instead of being left
# applied-but-unconfirmed forever.
LEGACY_STATE="$BOOT_MNT/update/state"
# Every payload this card has committed to: "<sha> <version> <build>", appended
# at commit time rather than on success, so one that turns out broken and rolls
# back is never retried — that would oscillate forever.
HISTORY="$STATE_DIR/history"
MANIFEST=/tmp/.bosupd-manifest
# Boots allowed after an update before the previous slots are restored. The
# trial ends as soon as a frontend session starts, so this only ever counts
# boots that never got that far.
MAX_TRIAL_BOOTS=3
# The update owns the whole track: it is not "half a boot", it is a minute of
# work that dwarfs the boot around it. The split is time-proportional, since
# writing to SD takes appreciably longer than reading back.
WRITE_FROM=0
WRITE_TO=60
VERIFY_FROM=60
VERIFY_TO=95
COMMIT_STAGE=98
CHUNK_MB=32

. /usr/share/baseos/log.sh

splash() {
	[ -x /usr/bin/baseos-splash ] && /usr/bin/baseos-splash --important "$@" 2>/dev/null
	return 0
}

# System-update progress is drawn as the BaseOS wordmark itself, not as a pill
# over whatever artwork was on screen. Drop the custom-logo opt-in for this
# updater process so a user's selected BMP cannot become the update background.
# The percentage is based on bytes written and read back, not elapsed time.
update_progress() {
	unset BASEOS_CUSTOM_SPLASH BASEOS_CUSTOM_SPLASH_ONLY
	# Keep the wordmark illumination and overlay the traditional bottom
	# progress pill. fbsplash with a message preserves the underlying logo.
	[ -x /usr/bin/fbsplash ] && /usr/bin/fbsplash "$1" >/dev/null 2>&1 || :
	[ -x /usr/bin/baseos-splash ] && /usr/bin/baseos-splash --important "$1" "UPDATING SYSTEM" >/dev/null 2>&1 || :
	return 0
}

field() { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1; }

is_mounted() { grep -q " $1 " /proc/mounts; }
cleanup() { return 0; }

# One release of this port recorded the trial under /mnt/boot, where the flip
# hid it. A card upgraded by that build still carries such a file — point
# $STATE at it so `confirm` can retire it, and so the payload it names is
# removed rather than left on the card forever.
adopt_legacy_state() {
	[ -f "$STATE" ] && return 0
	[ -f "$LEGACY_STATE" ] || return 0
	STATE="$LEGACY_STATE"
	log "found trial state at the pre-fix path $LEGACY_STATE; retiring it"
	return 0
}

# One geometry variable: slot uboot _INACTIVE -> $SLOT_UBOOT_INACTIVE.
slot() { eval "printf '%s' \"\${SLOT_$(echo "$1" | tr a-z A-Z)$2}\""; }

# Which disk holds this system? Derived from the boot volume, falling back to
# the root mount, so a card in either slot works without configuration.
find_disk() {
	[ -n "$DISK" ] && return 0
	_src="$(awk '$2 == "/mnt/boot" { print $1; exit }' /proc/mounts 2>/dev/null)"
	[ -n "$_src" ] || _src="$(awk '$2 == "/" { print $1; exit }' /proc/mounts 2>/dev/null)"
	case "$_src" in
		/dev/*p[0-9]*) DISK="${_src%p[0-9]*}" ;;
		*) return 1 ;;
	esac
	[ -b "$DISK" ]
}

# Slot geometry comes from the GPT itself; gptslot refuses any layout that is
# not a BaseOS A/B layout, which is what stops this touching an older card.
load_geometry() {
	[ -x /usr/sbin/gptslot ] || return 1
	find_disk || return 1
	geometry="$(/usr/sbin/gptslot "$DISK" geometry 2>/dev/null)" || return 1
	eval "$geometry"
	[ -n "${SLOT_ROOTFS_SECTORS:-}" ]
}

# Where payloads may sit: the visible data volume, the card the frontend was
# selected from, then the boot volume.
scan_dirs() {
	DIRS="$CARD $FRONTEND_MNT $BOOT_MNT"
	return 0
}

# The frontend card is TF2 on this platform, and it is the card USB storage mode
# exports, so it is where an owner who copies a payload over the cable will put
# it. It is mounted by the frontend session, which has not run yet here, so this
# is the one directory apply() has to mount for itself.
#
# It also enumerates late: mmc1 appears about a second into the boot, roughly
# when rcS reaches this point, so a single attempt at the wrong moment finds no
# block node and the payload is never seen. Waiting is only paid when a card is
# really in the slot. The mmc host publishes <host>:<id>/type as soon as it sees
# a card -- before mmcblk1 exists -- and publishes nothing for an empty slot.
# SDIO functions (the Wi-Fi card) report type=SDIO, which is why the type is read
# rather than the directory merely tested.
second_card_present() {
	sc_disk=
	for event_file in /sys/class/block/*p*/uevent; do
		[ -r "$event_file" ] || continue
		sc_dev=
		sc_part=
		while IFS= read -r event_line || [ -n "$event_line" ]; do
			case "$event_line" in
				DEVNAME=*) sc_dev=${event_line#DEVNAME=} ;;
				PARTNAME=*) sc_part=${event_line#PARTNAME=} ;;
			esac
		done < "$event_file"
		if [ "$sc_part" = "BASEOS_ROOT" ] && [ -n "$sc_dev" ]; then
			sc_disk=${sc_dev%p[0-9]*}
			break
		fi
	done
	for card_dir in /sys/class/mmc_host/mmc*/*:*; do
		[ -e "$card_dir/type" ] || continue
		sc_type=$(cat "$card_dir/type" 2>/dev/null || :)
		case "$sc_type" in SD|MMC) ;; *) continue ;; esac
		sc_host=$(basename "$(dirname "$card_dir")")
		if [ -n "$sc_disk" ] && [ "mmc${sc_disk#mmcblk}" = "$sc_host" ]; then
			continue
		fi
		return 0
	done
	return 1
}

ensure_frontend_card() {
	is_mounted "$FRONTEND_MNT" && return 0
	[ -x /usr/sbin/baseos-tf2-mount ] || return 1
	if ! second_card_present; then
		/usr/sbin/baseos-tf2-mount >/dev/null 2>&1 || :
		is_mounted "$FRONTEND_MNT" && return 0
		return 1
	fi
	i=0
	while [ "$i" -lt 5 ]; do
		/usr/sbin/baseos-tf2-mount >/dev/null 2>&1 || :
		is_mounted "$FRONTEND_MNT" && return 0
		sleep 0.1
		i=$((i + 1))
	done
	return 1
}

# Is $1 a strictly newer dotted version than $2? Missing fields count as zero,
# so 1.1 beats 1.0.9.
version_newer() {
	i=1
	while [ "$i" -le 4 ]; do
		fa="$(printf "%s" "$1" | cut -d. -f"$i" | tr -cd '0-9')"
		fb="$(printf "%s" "$2" | cut -d. -f"$i" | tr -cd '0-9')"
		[ -n "$fa" ] || fa=0
		[ -n "$fb" ] || fb=0
		[ "$fa" -gt "$fb" ] && return 0
		[ "$fa" -lt "$fb" ] && return 1
		i=$((i + 1))
	done
	return 1
}

# Build ids of dirty trees end in the UTC timestamp they were stamped with
# (16652d2-dirty-20261030143042). That suffix is the only ordering the id has.
build_stamp() {
	case "$1" in
		*-dirty-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) \
			printf '%s' "${1##*-dirty-}" ;;
		*) printf '' ;;
	esac
}

# Judge one payload: 0 = apply it, 1 = nothing to do, 2 = rejected outright.
# Sets EV_VERSION / EV_BUILD / EV_SHA, EV_REASON for humans, and leaves the
# payload's own manifest in $MANIFEST — which is what apply() reads afterwards.
evaluate() {
	EV_VERSION=""; EV_BUILD=""; EV_SHA=""; EV_REASON=""
	if ! tar -xOf "$1" manifest > "$MANIFEST" 2>/dev/null || [ ! -s "$MANIFEST" ]; then
		EV_REASON="not a BaseOS update payload"; return 2
	fi
	EV_VERSION="$(field "$MANIFEST" version)"
	EV_BUILD="$(field "$MANIFEST" build)"
	EV_SHA="$(field "$MANIFEST" rootfs-sha256)"

	if [ "$(field "$MANIFEST" format)" != "$FORMAT" ]; then
		EV_REASON="unsupported payload format"; return 2
	fi
	if [ "$(field "$MANIFEST" target)" != "$BASEOS_TARGET" ]; then
		EV_REASON="built for $(field "$MANIFEST" target), this is $BASEOS_TARGET"; return 2
	fi
	for r in $REGIONS; do
		if [ "$(field "$MANIFEST" "$r-sectors")" != "$(slot "$r" _SECTORS)" ]; then
			EV_REASON="its $r slot does not fit this card"; return 2
		fi
		case "$(field "$MANIFEST" "$r-sha256")" in
			[0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;;
			*) EV_REASON="no usable $r-sha256"; return 2 ;;
		esac
	done

	# Only ever move forward. Without this an old payload left on the card
	# becomes applicable again the moment you update past it, so the device
	# would downgrade, re-apply the newer one, and ping-pong. A rebuild of the
	# running version is still allowed, which is what makes iteration work.
	if version_newer "$EV_VERSION" "${BASEOS_VERSION:-0}"; then
		:
	elif [ "$EV_VERSION" = "${BASEOS_VERSION:-}" ] && [ "$EV_BUILD" != "${BASEOS_BUILD:-}" ]; then
		# Same version, different build: a rebuild is allowed so iteration
		# works, but an *older* build of it must not be. Without this, the
		# payload left beside a newer install re-applies the previous slot set
		# on the very next boot and the card ping-pongs between two builds that
		# both claim to be the running version.
		_ev_stamp="$(build_stamp "$EV_BUILD")"
		_cur_stamp="$(build_stamp "${BASEOS_BUILD:-}")"
		if [ -n "$_ev_stamp" ] && [ -n "$_cur_stamp" ] && [ "$_ev_stamp" -lt "$_cur_stamp" ]; then
			EV_REASON="older build ($EV_BUILD) of the running $EV_VERSION"; return 1
		fi
	else
		EV_REASON="not newer than the running ${BASEOS_VERSION:-?}"; return 1
	fi
	if grep -q "^$EV_SHA " "$HISTORY" 2>/dev/null; then
		EV_REASON="already applied to this card"; return 1
	fi
	# A trial that has not been confirmed yet is the same evidence as history,
	# and it survives the case history cannot: a card updated by a build that
	# still wrote history under /mnt/boot loses that file to the flip, so the
	# next boot re-applied the same payload it had just written and rebooted
	# again. Ask the trial state first — it is written at the same commit point.
	if [ -f "$STATE" ]; then
		if [ "$(field "$STATE" sha)" = "$EV_SHA" ]; then
			EV_REASON="already applied and awaiting confirmation"; return 1
		fi
	fi

	EV_REASON="ready"
	return 0
}

# The first *.bosupd across $DIRS, in search order. Sets $FOUND; no forks, so an
# ordinary boot pays one failed glob per directory.
first_payload() {
	FOUND=""
	for dir in $DIRS; do
		for candidate in "$dir"/*.bosupd; do
			[ -f "$candidate" ] || continue
			FOUND="$candidate"
			return 0
		done
	done
	return 1
}

# Pick the first applicable payload across every directory. Considering all of
# them matters: a stale payload must not mask the new one beside it.
select_payload() {
	CHOSEN=""; REJECTED=0
	for dir in $DIRS; do
		[ -z "$CHOSEN" ] || break
		for candidate in "$dir"/*.bosupd; do
			[ -f "$candidate" ] || continue
			evaluate "$candidate"; verdict=$?
			if [ "$verdict" -eq 0 ]; then CHOSEN="$candidate"; break; fi
			if [ "$verdict" -eq 2 ]; then
				log "$candidate rejected: $EV_REASON"
				REJECTED=1
			fi
		done
	done
	[ -n "$CHOSEN" ]
}

paint() { update_progress $(( $1 + ($2 - $1) * $3 / total_mb )); }

# Write one region's member into its inactive half, in chunks so the track can
# move. iflag=fullblock is load-bearing: a short read from the pipe would leave
# every later chunk misaligned. conv=fsync per chunk spreads the flush across
# the bar, so what it shows is data actually committed. status=none drops the
# per-chunk summary busybox dd prints on success; real errors still reach the log.
write_slot() {
	seek=$(( $(slot "$1" _INACTIVE) / 2048 ))
	count=$(( $(slot "$1" _SECTORS) / 2048 ))
	tar -xOf "$payload" "$1.img.gz" 2>>"$BASEOS_LOG" | gunzip 2>>"$BASEOS_LOG" | {
		w=0
		while [ "$w" -lt "$count" ]; do
			n="$CHUNK_MB"
			[ $((w + n)) -le "$count" ] || n=$((count - w))
			dd of="$DISK" bs=1M seek=$((seek + w)) count="$n" \
				iflag=fullblock conv=notrunc,fsync status=none \
				2>>"$BASEOS_LOG" || exit 1
			w=$((w + n))
			paint "$WRITE_FROM" "$WRITE_TO" $((done_mb + w))
		done
	}
}

# Hash an inactive half back off the card. The splash calls inside the group must
# not write to stdout — that stream is the hash input.
verify_slot() {
	skip=$(( $(slot "$1" _INACTIVE) / 2048 ))
	count=$(( $(slot "$1" _SECTORS) / 2048 ))
	{
		c=0
		while [ "$c" -lt "$count" ]; do
			n="$CHUNK_MB"
			[ $((c + n)) -le "$count" ] || n=$((count - c))
			dd if="$DISK" bs=1M skip=$((skip + c)) count="$n" 2>/dev/null
			c=$((c + n))
			paint "$VERIFY_FROM" "$VERIFY_TO" $((done_mb + c)) >/dev/null 2>&1
		done
	} | sha256sum | cut -d' ' -f1
}

fail() {
	log "$1 — GPT untouched"
	splash -1 "UPDATE FAILED"
	cleanup
	return 1
}

# Retire a payload that has already been committed, by renaming it beside where
# the operator put it. A rename is atomic on both FAT and ext4 and costs one
# syscall, and unlike history it cannot be invalidated by a flip, a rollback or
# a power cut between the flip and the next boot. confirm() removes the renamed
# file once the slot set is proven to boot.
claim_payload() {
	case "$payload" in
		""|*.applied) return 0 ;;
	esac
	if mv -f "$payload" "$payload.applied" 2>/dev/null; then
		log "marked $payload.applied; it will not be applied again"
		payload="$payload.applied"
	else
		log "WARNING: could not rename $payload; history is now the only record of this update"
	fi
	return 0
}

apply() {
	ensure_frontend_card || :
	scan_dirs
	# Ordinary boot: no payload anywhere, and nothing else runs.
	first_payload || { cleanup; return 0; }

	if ! load_geometry; then
		log "payload present but this card has no A/B layout — ignoring"
		cleanup
		return 0
	fi
	. /etc/baseos-release

	if ! select_payload; then
		[ "$REJECTED" -eq 1 ] && splash -1 "UPDATE FAILED"
		cleanup
		return "$REJECTED"
	fi
	# evaluate() left the chosen payload's manifest in $MANIFEST.
	payload="$CHOSEN"
	version="$EV_VERSION"
	build="$EV_BUILD"
	want_sha="$EV_SHA"

	mkdir -p "$STATE_DIR"
	log "applying $version ($build) from $payload"
	# Switch from any selected user logo to the BaseOS progress wordmark.
	update_progress "$WRITE_FROM"

	total_mb=0
	for r in $REGIONS; do total_mb=$((total_mb + $(slot "$r" _SECTORS) / 2048)); done

	done_mb=0
	for r in $REGIONS; do
		write_slot "$r" || { fail "writing the $r slot failed"; return 1; }
		done_mb=$((done_mb + $(slot "$r" _SECTORS) / 2048))
	done
	sync
	# Drop the page cache first, so the read-back verifies what actually landed
	# on the card rather than the pages we just wrote. (subshell: a failed
	# redirection is reported by the shell itself, so redirecting the command's
	# stderr alone would not silence it)
	( echo 3 > /proc/sys/vm/drop_caches ) 2>/dev/null || true

	done_mb=0
	for r in $REGIONS; do
		if [ "$(verify_slot "$r")" != "$(field "$MANIFEST" "$r-sha256")" ]; then
			fail "the $r slot failed verification"
			return 1
		fi
		done_mb=$((done_mb + $(slot "$r" _SECTORS) / 2048))
	done
	log "all slots verified"

	# The commit. Everything above is reversible by doing nothing.
	if ! /usr/sbin/gptslot "$DISK" flip $REGIONS >> "$BASEOS_LOG" 2>&1; then
		log "slot flip failed — still running the old slots"
		splash -1 "UPDATE FAILED"
		cleanup
		return 1
	fi

	# Record the commit before rebooting. This is the idempotency key for every
	# later boot: whatever happens to these slots now, the same payload sitting
	# on the card is never applied a second time.
	printf "%s %s %s\n" "$want_sha" "$version" "$build" >> "$HISTORY"
	{
		printf "trial=%s\n" "$version"
		printf "build=%s\n" "$build"
		printf "attempts=0\n"
		printf "sha=%s\n" "$want_sha"
		printf "payload=%s\n" "$payload"
	} > "$STATE"
	# history and state are both files this script can lose: history used to be
	# written under /mnt/boot, which the flip relocates, and a card updated by
	# that build booted, found no history, and re-applied the payload it had just
	# written — an update loop that only the operator could stop. The payload's
	# own name is the one key that survives everything, so retire it here, in the
	# same commit window, before the reboot.
	claim_payload
	log "flipped to $version; rebooting"
	sync
	# Paint the last value only once every write is on the card: the flip, the
	# history append and this sync take a few seconds between them.
	update_progress "$COMMIT_STAGE"
	cleanup
	reboot
	# init takes over from here; hold rcS briefly so it does not race ahead into
	# a frontend session on a system that is already shutting down.
	sleep 10
	return 0
}

boot_check() {
	adopt_legacy_state
	[ -f "$STATE" ] || return 0
	attempts="$(field "$STATE" attempts)"
	[ -n "$attempts" ] || attempts=0
	attempts=$((attempts + 1))
	if [ "$attempts" -ge "$MAX_TRIAL_BOOTS" ]; then
		log "no session in $attempts boots — restoring the previous slots;"
		log "the payload that produced them stays on the card but is not retried"
		splash -1 "RESTORING SYSTEM"
		if /usr/sbin/gptslot "$DISK" flip $REGIONS >> "$BASEOS_LOG" 2>&1; then
			rm -f "$STATE"
			sync
			reboot
			sleep 10
			return 0
		fi
		log "restore flip failed; continuing on the current slots"
		rm -f "$STATE"
		return 1
	fi
	sed "s/^attempts=.*/attempts=$attempts/" "$STATE" > "$STATE.new" \
		&& mv "$STATE.new" "$STATE"
	log "update trial boot $attempts of $MAX_TRIAL_BOOTS"
	return 0
}

# Only once confirmed: a payload that rolled back stays for status to explain.
# Both names are removed: claim_payload renames it at commit time, and the trial
# state still records the original path, so a confirmed update must clean up
# whichever of the two is on the card.
remove_payload() {
	case "$1" in
		"") return 0 ;;
		"$BOOT_MNT"/*|"$CARD"/*|"$FRONTEND_MNT"/*) ;;
		*) return 0 ;;
	esac
	for candidate in "$1" "$1.applied"; do
		[ -e "$candidate" ] || continue
		if rm -f "$candidate" 2>/dev/null; then
			log "removed $candidate"
		else
			log "WARNING: could not remove $candidate; delete it from a PC"
		fi
	done
	return 0
}

confirm() {
	adopt_legacy_state
	if [ ! -f "$STATE" ]; then
		log "no update trial pending; nothing to confirm"
		return 0
	fi
	version="$(field "$STATE" trial)"
	remove_payload "$(field "$STATE" payload)"
	rm -f "$STATE"
	log "update to $version confirmed"
	# Cheap here (measured at 0 on device) and worth it: if an unclean shutdown
	# resurrected the trial, three more boots would roll back a working update.
	sync
	return 0
}

# The apply path is deliberately silent about the payloads it skips — it runs on
# every boot — so this is where "I copied the file and nothing happened" gets
# answered, for every payload on the card rather than just the chosen one.
status() {
	. /etc/baseos-release
	printf "version: %s (%s)\n" "${BASEOS_VERSION:-unknown}" "${BASEOS_BUILD:-unknown}"
	if load_geometry; then
		have_geometry=1
		for r in $REGIONS; do
			printf "slot:    %-6s %s (active LBA %s, spare %s, %s sectors)\n" \
				"$r" "$(slot "$r" "")" "$(slot "$r" _ACTIVE)" \
				"$(slot "$r" _INACTIVE)" "$(slot "$r" _SECTORS)"
		done
	else
		have_geometry=0
		printf "slot:    no A/B layout on this card\n"
	fi
	if [ -f "$STATE" ]; then
		printf "trial:   %s, boot %s of %s\n" "$(field "$STATE" trial)" \
			"$(field "$STATE" attempts)" "$MAX_TRIAL_BOOTS"
	else
		printf "trial:   none (committed)\n"
	fi

	ensure_frontend_card || :
	scan_dirs
	any=0
	for dir in $DIRS; do
		for candidate in "$dir"/*.bosupd; do
			[ -f "$candidate" ] || continue
			any=1
			printf "payload: %s\n" "$candidate"
			if [ "$have_geometry" -eq 0 ]; then
				printf "         cannot apply: this card has no A/B layout\n"
				continue
			fi
			evaluate "$candidate"; verdict=$?
			printf "         %s %s (%s)\n" "$BASEOS_TARGET" "${EV_VERSION:-?}" "${EV_BUILD:-?}"
			case "$verdict" in
				0) printf "         WILL APPLY on the next boot\n" ;;
				1) printf "         skipped: %s\n" "$EV_REASON" ;;
				*) printf "         rejected: %s\n" "$EV_REASON" ;;
			esac
		done
	done
	[ "$any" -eq 1 ] || printf "payload: none on the card\n"
	cleanup
	return 0
}

case "${1:-apply}" in
	apply) apply ;;
	boot-check) boot_check ;;
	confirm) confirm ;;
	status) status ;;
	*) echo "usage: baseos-update [apply|boot-check|confirm|status]" >&2; exit 2 ;;
esac
