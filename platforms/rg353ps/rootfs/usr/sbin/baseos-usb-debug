#!/bin/sh
# USB Gadget manager for a unit that has no adbd.
# Development builds combine RNDIS/NCM network + Dropbear SSH with MTP
# FunctionFS in one composite configuration; release builds may expose MTP
# alone. Mass Storage remains a separate, exclusive mode.
#
# Why not ADB: ADB is FunctionFS plus the Android adbd daemon, and adbd needs
# libbase/libcutils/libselinux/liblog, none of which exist in Alpine. An RNDIS
# gadget uses the same configfs machinery the storage helper already relies on,
# Windows 10/11 binds it without a driver package, and `ssh root@192.168.42.1`
# runs anything a local shell could. It costs about 400 KB of rootfs.
#
# Development builds default to a composite network + MTP gadget; release
# builds default to MTP only. Mass Storage remains on-demand and exclusive:
# baseos-usb-storage stops this manager before it takes the UDC, then starts it
# again during cleanup. SSH listens only on the USB network address; MTP exports
# only /mnt/SDCARD. The network function defaults to RNDIS and can use NCM/ECM.
#
# Usage: baseos-usb-debug start|stop|restart|status|soft-connect-test-arm|soft-connect-test-cancel

set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

G=/sys/kernel/config/usb_gadget/baseos_debug
LOG=/run/baseos-usb-debug.log
CONF=/run/baseos-udhcpd.conf
LEASES=/run/baseos-udhcpd.leases
PIDFILE_DROPBEAR=/run/dropbear.pid
PIDFILE_DHCP=/run/baseos-udhcpd.pid
ADDR=192.168.42.1
CIDR=192.168.42.1/24
DHCP_FIRST=192.168.42.100
DHCP_LAST=192.168.42.120

say() { printf '%s %s\n' "$(date '+%H:%M:%S' 2>/dev/null)" "$*" >>"$LOG" 2>/dev/null || :; }

# The card copy of baseos.conf wins, so the switch can be flipped without a
# rebuild or an update file.
config_value() {
    key=$1
    for cfg in /mnt/SDCARD/baseos.conf /mnt/boot/baseos.conf /etc/baseos.conf; do
        [ -r "$cfg" ] || continue
        val=$(sed -n "s/^${key}=//p" "$cfg" 2>/dev/null | tail -1 | tr -d ' \t\r')
        [ -n "$val" ] && { printf '%s' "$val"; return 0; }
    done
    return 1
}

enabled() {
    case "$(config_value usb_debug)" in
        yes|YES|Yes|1|on|true) return 0 ;;
    esac
    return 1
}

network_enabled() { enabled; }

mtp_enabled() {
    case "$(config_value usb_mtp)" in
        yes|YES|Yes|1|on|true) return 0 ;;
    esac
    return 1
}

find_udc() { ls /sys/class/udc 2>/dev/null | head -1; }

# dwc3 probes later than rcS on this board, and a first boot can reach here
# before /sys/class/udc is populated. Ten seconds costs nothing at boot and
# turns "no UDC" from a permanent failure into a short wait.
wait_udc() {
    i=0
    while [ "$i" -lt 20 ]; do
        found=$(find_udc)
        [ -n "$found" ] && { printf '%s' "$found"; return 0; }
        i=$((i + 1))
        sleep 0.5
    done
    return 1
}

udc_state() { cat "/sys/class/udc/$UDC/state" 2>/dev/null || :; }

# The charger is a second, completely independent VBUS witness: it sits on the
# PMIC and is told about 5 V by its own IRQ, without the USB2PHY being involved.
# That matters here because the PHY's SDP/CDP bits are exactly what stopped
# reporting in the field log - if the only witness is the thing that is asleep,
# a plugged cable looks like no cable at all.
vbus_state() {
    for ps in /sys/class/power_supply/*; do
        [ -r "$ps/status" ] || continue
        case "$(cat "$ps/status" 2>/dev/null)" in
            Charging|Full) printf 'charging'; return 0 ;;
        esac
    done
    printf 'idle'
}

vbus_present() { [ "$(vbus_state)" = charging ]; }

extcon_summary() {
    out=
    for e in /sys/class/extcon/*; do
        [ -r "$e/name" ] || continue
        name=$(cat "$e/name" 2>/dev/null)
        case "$name" in *usb2phy*) ;; *) continue ;; esac
        out="$out${out:+,}$name=$(cat "$e/state" 2>/dev/null)"
    done
    printf '%s' "${out:-none}"
}

# "Is a PC on the other end?" - three signals, any one of which counts: the
# PHY's SDP/CDP cable bits, the PMIC seeing charge current, and a UDC state
# above "not attached". "attached" alone is reported as soon as a gadget is
# bound, with or without a cable, so it is deliberately not part of this.
cable_present() {
    for cable in /sys/devices/platform/"$UDC"/supplier:platform:*usb2phy/extcon/*/cable.*; do
        [ -r "$cable/name" ] && [ -r "$cable/state" ] || continue
        case "$(cat "$cable/name" 2>/dev/null)" in
            SDP|CDP) [ "$(cat "$cable/state" 2>/dev/null)" = "1" ] && return 0 ;;
        esac
    done
    for extcon in /sys/class/extcon/*; do
        [ -r "$extcon/name" ] && [ -r "$extcon/state" ] || continue
        case "$(cat "$extcon/name" 2>/dev/null)" in *usb2phy*) ;; *) continue ;; esac
        if cat "$extcon/state" 2>/dev/null |
             grep -Eq '(^|[[:space:]])(SDP|CDP)=1([[:space:]]|$)'; then
            return 0
        fi
    done
    vbus_present && return 0
    case "$(udc_state)" in
        powered|configured) return 0 ;;
    esac
    return 1
}

# Everything a remote reader needs to tell "the PHY never saw the cable" from
# "the PHY saw it and dwc3 still would not attach". The whole point of this
# channel is that there is no shell yet, so the report has to reach the card -
# but only when the channel is actually in trouble. A boot that brings the
# network up has nothing to explain, and rewriting 17 KB of probe on every
# power-on was wear with no reader: the report is assembled in RAM, and copied
# out on the first sign of a stuck controller.
PROBE_RAM=/run/baseos-usb-probe.txt
PROBE_PUSHED=0
USB_TROUBLE=0

# The card copies exist for the failure case, so that is when they are written.
# debug=yes still asks for them on every boot, which is what makes a card copy
# available while the channel is healthy.
persist_enabled() {
    [ "$USB_TROUBLE" = 1 ] && return 0
    [ "$(config_value debug)" = yes ] && return 0
    return 1
}

push_probe() {
    case "$PROBE_PUSHED" in 1) return 0 ;; esac
    persist_enabled || return 0
    [ -s "$PROBE_RAM" ] || return 0
    _pout=/mnt/SDCARD/rg353ps-usb-probe.txt
    cat "$PROBE_RAM" >>"$_pout" 2>/dev/null || :
    tail -n 240 "$_pout" >"$_pout.new" 2>/dev/null && mv "$_pout.new" "$_pout" 2>/dev/null || :
    PROBE_PUSHED=1
    sync 2>/dev/null || :
}

probe_dump() {
    [ -d /mnt/SDCARD ] || return 0
    out=$PROBE_RAM
    {
        printf '== %s  %s\n' "$1" "$(date '+%F %T' 2>/dev/null)"
        printf 'udc=%s state=%s\n' "${UDC:-none}" "$(udc_state)"
        printf 'gadget UDC=%s driver=%s\n' \
            "$(cat "$G/UDC" 2>/dev/null)" \
            "$(readlink "/sys/bus/platform/devices/${UDC:-none}/driver" 2>/dev/null)"
        for e in /sys/class/extcon/*; do
            [ -r "$e/name" ] || continue
            printf 'extcon %s: %s\n' "$(cat "$e/name" 2>/dev/null)" "$(cat "$e/state" 2>/dev/null)"
        done
        for ps in /sys/class/power_supply/*; do
            [ -r "$ps/status" ] || continue
            printf 'power %s: status=%s online=%s\n' "${ps##*/}" \
                "$(cat "$ps/status" 2>/dev/null)" "$(cat "$ps/online" 2>/dev/null)"
        done
        printf -- '-- dmesg --\n'
        dmesg 2>/dev/null | grep -iE 'dwc3|usb2phy|xhci|gadget|rndis|ep0' | tail -20
    } >>"$out" 2>/dev/null || :
    tail -n 240 "$out" >"$out.new" 2>/dev/null && mv "$out.new" "$out" 2>/dev/null || :
    push_probe
}

# Hold the controller and its PHYs out of autosuspend for the life of the
# channel. The storage helper does this because a suspended PHY never reports
# the VBUS interrupt that starts an enumeration; the debug channel has the same
# exposure and, unlike storage, it is entered *before* the cable exists - which
# is exactly the case where the PHY is idle and free to autosuspend.
disable_usb_runtime_pm() {
    for pm in /sys/bus/platform/devices/"$UDC" /sys/bus/platform/devices/*usb2phy*; do
        [ -w "$pm/power/control" ] || continue
        printf 'on' >"$pm/power/control" 2>/dev/null && say "runtime PM pinned on: $pm"
    done
}

# One known-good-cable test on ff88dd9 wrote both soft_connect
# disconnect/connect commands successfully, but the UDC stayed at
# "not attached" with speed=UNKNOWN for the full eight-second observation.
# The supervisor's DWC3 driver re-probe then restored enumeration. This is
# evidence for that failure signature, not proof that soft_connect is useless
# in every possible controller state.
#
# The supervisor never uses soft_connect automatically. A one-shot test can
# be armed while USB is healthy with:
#   baseos-usb-debug soft-connect-test-arm
# On the next cable-present enumeration failure, the supervisor runs one
# disconnect/connect test, records the result, waits eight seconds, then
# resumes the existing re-probe fallback if the UDC is still not configured.
# Cancel an armed test with soft-connect-test-cancel.

rebind_gadget() {
    say "recovery: unbinding and rebinding $UDC"
    printf '\n' >"$G/UDC" 2>/dev/null || :
    sleep 0.5
    if printf '%s' "$UDC" >"$G/UDC" 2>/dev/null; then
        sleep 1
        say "recovery: rebind done state=$(udc_state)"
        if network_enabled; then
            configure_iface || :
            start_dhcp "$(cat /run/baseos-usb-debug.iface 2>/dev/null || echo usb0)"
        fi
    else
        say "recovery: rebind failed"
    fi
}

# The heavy one, lifted from baseos-usb-storage where it is the step that
# actually recovers this port: unbind the controller from its platform driver
# and let it probe again. That rebuilds dwc3 and usb2phy from scratch and is the
# closest thing to the state the unit is in right after boot - with VBUS already
# present - which is the only state mass storage has never failed in.
#
# This is also the only action that does not need the cable edge: re-probing
# while the cable is already in is exactly how storage mode succeeds.
reprobe_udc_driver() {
    drv=$(readlink "/sys/bus/platform/devices/$UDC/driver" 2>/dev/null) || {
        say "recovery: no platform driver on $UDC; cannot re-probe"
        return 1
    }
    drv=${drv##*/}
    say "recovery: re-probing $UDC on $drv (cable=$(cable_present && echo yes || echo no) vbus=$(vbus_state))"
    # The gadget must come off first: a UDC device that vanishes under a bound
    # gadget leaves the gadget unbound for the rest of the session.
    printf '\n' >"$G/UDC" 2>/dev/null || :
    sleep 1
    if ! printf '%s' "$UDC" >"/sys/bus/platform/drivers/$drv/unbind" 2>/dev/null; then
        say "recovery: unbind from $drv failed"
        return 1
    fi
    sleep 1
    if ! printf '%s' "$UDC" >"/sys/bus/platform/drivers/$drv/bind" 2>/dev/null; then
        say "recovery: bind to $drv failed"
        return 1
    fi
    sleep 2
    if ! printf '%s' "$UDC" >"$G/UDC" 2>/dev/null; then
        sleep 2
        printf '%s' "$UDC" >"$G/UDC" 2>/dev/null || { say "recovery: gadget rebind failed"; return 1; }
    fi
    # The fresh platform device comes back with power/control=auto, so the PHY
    # would be free to idle again the moment it is probed.
    disable_usb_runtime_pm
    if network_enabled; then
        configure_iface || :
        start_dhcp "$(cat /run/baseos-usb-debug.iface 2>/dev/null || echo usb0)"
    fi
    sleep 1
    say "recovery: re-probe done state=$(udc_state) cable=$(cable_present && echo yes || echo no)"
    return 0
}

# Heavier still: rebuild the USB2PHY as well as the controller, in the order a
# cold boot uses - PHY probes with VBUS already present, then dwc3 attaches to
# it. The field log shows why this ordering may matter: with VBUS arriving long
# after both had probed, dwc3 took a device event with speed=0 and immediately
# reported a disconnect, i.e. the host's port reset never produced a usable
# link. That is the state storage mode never sees, because it boots with the
# cable in.
reprobe_usb_stack() {
    phy=
    for candidate in /sys/bus/platform/devices/*usb2phy; do
        case "$(readlink "$candidate/driver" 2>/dev/null)" in
            *rockchip-usb2phy*) phy=${candidate##*/}; break ;;
        esac
    done
    drv=$(readlink "/sys/bus/platform/devices/$UDC/driver" 2>/dev/null) || {
        say "recovery: no platform driver on $UDC; cannot rebuild the stack"
        return 1
    }
    drv=${drv##*/}
    say "recovery: rebuilding the USB stack: $drv + ${phy:-no phy} (cable=$(cable_present && echo yes || echo no))"
    printf '\n' >"$G/UDC" 2>/dev/null || :
    sleep 1
    printf '%s' "$UDC" >"/sys/bus/platform/drivers/$drv/unbind" 2>/dev/null || {
        say "recovery: unbind from $drv failed"; return 1
    }
    sleep 1
    if [ -n "$phy" ]; then
        phydrv=$(readlink "/sys/bus/platform/devices/$phy/driver" 2>/dev/null)
        phydrv=${phydrv##*/}
        if [ -n "$phydrv" ]; then
            printf '%s' "$phy" >"/sys/bus/platform/drivers/$phydrv/unbind" 2>/dev/null || :
            sleep 1
            printf '%s' "$phy" >"/sys/bus/platform/drivers/$phydrv/bind" 2>/dev/null || {
                say "recovery: PHY rebind failed; the port will stay dead until reboot"
            }
            sleep 1
            say "recovery: PHY ${phy} re-probed (cable=$(cable_present && echo yes || echo no))"
        fi
    fi
    printf '%s' "$UDC" >"/sys/bus/platform/drivers/$drv/bind" 2>/dev/null || {
        say "recovery: bind to $drv failed"; return 1
    }
    sleep 2
    printf '%s' "$UDC" >"$G/UDC" 2>/dev/null || {
        sleep 2
        printf '%s' "$UDC" >"$G/UDC" 2>/dev/null || { say "recovery: gadget rebind failed"; return 1; }
    }
    disable_usb_runtime_pm
    if network_enabled; then
        configure_iface || :
        start_dhcp "$(cat /run/baseos-usb-debug.iface 2>/dev/null || echo usb0)"
    fi
    sleep 1
    say "recovery: stack rebuild done state=$(udc_state) cable=$(cable_present && echo yes || echo no)"
    return 0
}

# One supervisor for the whole session. It runs at two-second intervals and its
# job is to get the host to see the device at all.
#
# The first field log ended with "cable status at start: absent" and nothing
# after it, with a cable the owner had just plugged in: neither the PHY's
# SDP/CDP bits nor the UDC state ever moved. Waiting for a cable edge on this
# part is therefore not a plan. Every N ticks that find the UDC not configured
# the supervisor takes one step up the ladder on its own - a re-probe of dwc3
# with whatever VBUS is present right now, which is precisely the situation
# mass storage boots into and never fails in.
#
# Steps, cheapest first:
#   re-probe   controller driver off/on under the current cable state.
#   rebind     gadget off/on.
#   rebuild    PHY off/on and then the controller, which reproduces the probe
#              order of a cable-present cold boot.
#
# No soft_connect anywhere: see the note above rebind_gadget.
WATCH_PID=/run/baseos-usb-debug.watch.pid
RECOVERY_LOCK=/run/baseos-usb-debug.recovery.lock
SOFT_CONNECT_TEST_ARMED=/run/baseos-usb-soft-connect-test.armed
SOFT_CONNECT_TEST_LOG=/run/baseos-usb-soft-connect-test.log

# Runs on every tick that finds the UDC configured. The address and the DHCP
# server are set up by do_start, but do_start runs before the host has finished
# enumerating: on a cable-present cold boot the netdev exists with no carrier
# yet, so the first attempt can be a no-op. This is the second half of that
# setup, and it is written to be harmless when there is nothing to do.
ensure_link_up() {
    network_enabled || return 0
    iface=$(cat /run/baseos-usb-debug.iface 2>/dev/null || :)
    [ -n "$iface" ] || iface=$(find_iface) || return 1
    printf '%s\n' "$iface" >/run/baseos-usb-debug.iface 2>/dev/null || :
    ip link set "$iface" up 2>/dev/null || :
    if ! ip addr show "$iface" 2>/dev/null | grep -q "inet $ADDR/"; then
        ip addr add "$CIDR" dev "$iface" 2>/dev/null || :
        say "supervisor: link address restored on $iface ($ADDR)"
    fi
    pidof dnsmasq >/dev/null 2>&1 || start_dhcp "$iface"
    pidof dropbear >/dev/null 2>&1 || start_sshd
}


soft_connect_test_snapshot() {
    label=$1
    {
        printf '\n== %s %s ==\n' "$label" "$(date '+%F %T' 2>/dev/null)"
        printf 'UDC=%s configfs_binding=%s state=%s\n' "$UDC" \
            "$(cat "$G/UDC" 2>/dev/null)" "$(udc_state)"
        for attr in function current_speed maximum_speed; do
            path="/sys/class/udc/$UDC/$attr"
            [ -r "$path" ] && printf '%s=%s\n' "$attr" "$(cat "$path" 2>/dev/null)"
        done
        soft_path="/sys/class/udc/$UDC/soft_connect"
        printf 'soft_connect_attr=%s writable=%s\n' \
            "$([ -e "$soft_path" ] && echo present || echo absent)" \
            "$([ -w "$soft_path" ] && echo yes || echo no)"
        printf 'cable=%s vbus=%s extcon=%s\n' \
            "$(cable_present && echo yes || echo no)" "$(vbus_state)" "$(extcon_summary)"
        for ps in /sys/class/power_supply/*; do
            [ -r "$ps/status" ] || continue
            printf 'power %s status=%s online=%s\n' "$(basename "$ps")" \
                "$(cat "$ps/status" 2>/dev/null)" "$(cat "$ps/online" 2>/dev/null)"
        done
        iface=$(cat /run/baseos-usb-debug.iface 2>/dev/null || :)
        if [ -n "$iface" ]; then
            printf 'network interface %s:\n' "$iface"
            ip link show "$iface" 2>&1 || :
            ip -4 addr show "$iface" 2>&1 || :
        fi
        if [ -x /usr/sbin/baseos-usb-mtp ]; then
            /usr/sbin/baseos-usb-mtp status 2>&1 || :
        fi
        printf '%s\n' '-- recent kernel USB messages --'
        dmesg 2>/dev/null | grep -iE 'dwc3|usb2phy|gadget|rndis|ep0|soft.connect' | tail -n 100
    } >>"$SOFT_CONNECT_TEST_LOG" 2>/dev/null || :
}


soft_connect_test_save() {
    if [ -s "$SOFT_CONNECT_TEST_LOG" ] && [ -d /mnt/SDCARD ]; then
        cat "$SOFT_CONNECT_TEST_LOG" >>/mnt/SDCARD/rg353ps-soft-connect-test.txt 2>/dev/null || :
        sync 2>/dev/null || :
        say "soft-connect test report saved to /mnt/SDCARD/rg353ps-soft-connect-test.txt"
    else
        say "soft-connect test report remains in $SOFT_CONNECT_TEST_LOG"
    fi
}

run_soft_connect_test() {
    : >"$SOFT_CONNECT_TEST_LOG"
    SOFT_CONNECT_ATTR="/sys/class/udc/$UDC/soft_connect"
    state=$(udc_state)
    if [ ! -w "$SOFT_CONNECT_ATTR" ]; then
        say "soft-connect test: unavailable (missing or not writable: $SOFT_CONNECT_ATTR)"
        printf 'soft-connect test unavailable: %s\n' "$SOFT_CONNECT_ATTR" >>"$SOFT_CONNECT_TEST_LOG"
        soft_connect_test_save
        return 1
    fi
    if ! cable_present; then
        say "soft-connect test: aborted; cable no longer present"
        printf 'soft-connect test aborted: cable absent\n' >>"$SOFT_CONNECT_TEST_LOG"
        soft_connect_test_save
        return 1
    fi
    if [ "$(cat "$G/UDC" 2>/dev/null)" != "$UDC" ]; then
        say "soft-connect test: aborted; configfs gadget is not bound to $UDC"
        printf 'soft-connect test aborted: configfs UDC binding mismatch\n' >>"$SOFT_CONNECT_TEST_LOG"
        soft_connect_test_save
        return 1
    fi
    case "$state" in
        configured|suspended)
            say "soft-connect test: skipped; UDC recovered to $state before test"
            printf 'soft-connect test skipped: state=%s\n' "$state" >"$SOFT_CONNECT_TEST_LOG"
            soft_connect_test_save
            return 0
            ;;
    esac

    say "soft-connect test: begin state=$state cable=yes; supervisor recovery paused"
    printf 'test started %s\n' "$(date '+%F %T' 2>/dev/null)" >>"$SOFT_CONNECT_TEST_LOG"
    soft_connect_test_snapshot before

    if ! printf 'disconnect\n' >"$SOFT_CONNECT_ATTR" 2>/dev/null; then
        say "soft-connect test: disconnect command failed"
        printf 'soft_connect disconnect command failed\n' >>"$SOFT_CONNECT_TEST_LOG"
        soft_connect_test_snapshot after-disconnect-error
        soft_connect_test_save
        return 1
    fi
    say "soft-connect test: disconnect accepted"
    printf 'soft_connect disconnect accepted %s\n' "$(date '+%F %T' 2>/dev/null)" >>"$SOFT_CONNECT_TEST_LOG"
    sleep 0.5

    if ! cable_present; then
        say "soft-connect test: cable disappeared before reconnect command"
        printf 'cable disappeared before connect command\n' >>"$SOFT_CONNECT_TEST_LOG"
        soft_connect_test_snapshot after-cable-loss
        soft_connect_test_save
        return 1
    fi
    if ! printf 'connect\n' >"$SOFT_CONNECT_ATTR" 2>/dev/null; then
        say "soft-connect test: connect command failed"
        printf 'soft_connect connect command failed\n' >>"$SOFT_CONNECT_TEST_LOG"
        soft_connect_test_snapshot after-connect-error
        soft_connect_test_save
        return 1
    fi
    say "soft-connect test: connect accepted; observing UDC for 8 seconds"
    printf 'soft_connect connect accepted %s\n' "$(date '+%F %T' 2>/dev/null)" >>"$SOFT_CONNECT_TEST_LOG"

    sample=0
    while [ "$sample" -lt 16 ]; do
        sample=$((sample + 1))
        state=$(udc_state)
        speed=$(cat "/sys/class/udc/$UDC/current_speed" 2>/dev/null || echo unknown)
        printf 'sample=%02d time=%s state=%s speed=%s cable=%s vbus=%s\n' \
            "$sample" "$(date '+%H:%M:%S' 2>/dev/null)" "$state" "$speed" \
            "$(cable_present && echo yes || echo no)" "$(vbus_state)" >>"$SOFT_CONNECT_TEST_LOG"
        [ "$state" = configured ] && break
        sleep 0.5
    done

    soft_connect_test_snapshot after-observation
    state=$(udc_state)
    say "soft-connect test: finished state=$state"
    printf 'test finished %s final_state=%s\n' "$(date '+%F %T' 2>/dev/null)" "$state" >>"$SOFT_CONNECT_TEST_LOG"
    soft_connect_test_save
}

arm_soft_connect_test() {
    UDC=$(find_udc) || :
    [ -n "$UDC" ] || { echo "No UDC found" >&2; return 1; }
    soft_path="/sys/class/udc/$UDC/soft_connect"
    [ -w "$soft_path" ] || { echo "soft_connect is unavailable: $soft_path" >&2; return 1; }
    [ "$(cat "$G/UDC" 2>/dev/null)" = "$UDC" ] || {
        echo "USB gadget is not bound to $UDC" >&2
        return 1
    }
    [ "$(udc_state)" = configured ] || {
        echo "Arm the test only while USB is healthy (UDC state must be configured)" >&2
        return 1
    }
    cable_present || { echo "No USB host cable detected" >&2; return 1; }
    [ ! -d "$RECOVERY_LOCK" ] || { echo "USB recovery is currently active" >&2; return 1; }
    if [ -e "$SOFT_CONNECT_TEST_ARMED" ]; then
        echo "A one-shot soft_connect test is already armed"
        return 0
    fi
    printf '%s\n' "$(date '+%F %T' 2>/dev/null)" >"$SOFT_CONNECT_TEST_ARMED"
    say "soft-connect test armed; it will run only after the next cable-present enumeration failure"
    echo "Armed. Unplug and reconnect the USB cable once. The test runs only if that reconnect remains unenumerated."
}

cancel_soft_connect_test() {
    rm -f "$SOFT_CONNECT_TEST_ARMED"
    say "soft-connect test arm cancelled"
    echo "Cancelled."
}

watch_cable() {
    tick=0
    last_state=x
    last_present=no
    attempt=0
    stuck_since=
    # Keep a short startup grace, but sample cable/state every 500 ms.
    # Recovery runs separately so driver-probe sleeps never pause polling.
    next_tick=6
    say "supervisor: started pid=$$ (state=$(udc_state) cable=$(cable_present && echo yes || echo no) vbus=$(vbus_state))"
    probe_dump "boot"
    while :; do
        sleep 0.5
        tick=$((tick + 1))
        [ -e "$G/UDC" ] || { say "supervisor: gadget gone; exiting"; exit 0; }
        state=$(udc_state)
        present=no
        cable_present && present=yes
        if [ "$tick" -le 6 ] || [ "$state" != "$last_state" ] || [ "$present" != "$last_present" ]; then
            say "supervisor: tick=$tick state=$state cable=$present vbus=$(vbus_state) extcon=$(extcon_summary)"
        fi
        if [ "$present" != "$last_present" ]; then
            if [ "$present" = yes ]; then
                say "supervisor: cable inserted (state=$state)"
                next_tick=$tick
                [ "$next_tick" -lt 6 ] && next_tick=6
                attempt=0
                stuck_since=$tick
            else
                say "supervisor: cable removed (state=$state)"
                stuck_since=
            fi
            last_present=$present
            probe_dump "cable $present"
            persist_log
        fi
        last_state=$state
        # Without a cable the UDC is supposed to sit in "not attached". That is
        # the idle state, not a fault, so it must not start a recovery: each
        # re-probe unbinds and rebinds the controller, which powers the PHY
        # down and back up, and the probe path re-arms a six-second OTG state
        # machine work every time. Unplugged, that loop repeats forever and
        # wakes the box once per cycle for nothing. Recovery is only meaningful
        # while a cable is present and the port still fails to enumerate.
        if [ "$present" = no ]; then
            stuck_since=
            attempt=0
            continue
        fi
        case "$state" in
            configured)
                stuck_since=
                attempt=0
                ensure_link_up || :
                continue ;;
            default|address|powered)
                stuck_since= ;;
            *)
                [ -z "$stuck_since" ] && stuck_since=$tick ;;
        esac
        [ -n "$stuck_since" ] || continue
        # Two seconds of continuous non-enumerated state starts recovery.
        # Unlike the old loop, recovery runs in the background.
        [ "$tick" -ge "$next_tick" ] || continue
        [ $((tick - stuck_since)) -ge 4 ] || continue
        [ -d "$RECOVERY_LOCK" ] && continue

        attempt=$((attempt + 1))
        if mkdir "$RECOVERY_LOCK" 2>/dev/null; then
            say "supervisor: launching asynchronous recovery attempt $attempt"
            (
                trap 'rmdir "$RECOVERY_LOCK" 2>/dev/null || :' 0
                USB_TROUBLE=1
                PROBE_PUSHED=0
                # Only a present cable can get here: the supervisor skips
                # recovery entirely while the cable is out, because the
                # unplugged "not attached" state is expected, not a fault.
                if [ -f "$SOFT_CONNECT_TEST_ARMED" ]; then
                    rm -f "$SOFT_CONNECT_TEST_ARMED"
                    say "supervisor: consuming one-shot soft-connect test instead of re-probing"
                    run_soft_connect_test || :
                else
                    case "$attempt" in
                        1|2) reprobe_udc_driver || : ;;
                        3)   rebind_gadget ;;
                        *)   reprobe_usb_stack || : ;;
                    esac
                fi
                say "supervisor: attempt $attempt done state=$(udc_state) cable=$(cable_present && echo yes || echo no)"
                probe_dump "attempt $attempt"
                persist_log force
            ) >/dev/null 2>&1 &
            next_tick=$((tick + 8))
        else
            say "supervisor: recovery lock already held"
        fi
    done
}

start_watch() {
    if [ -f "$WATCH_PID" ] && kill -0 "$(cat "$WATCH_PID" 2>/dev/null)" 2>/dev/null; then
        return 0
    fi
    # setsid when present: rcS exits right after this, and a supervisor that
    # dies with its parent would leave the channel deaf for the whole session -
    # which is one of the two readings of the first field log, where a cable
    # arrived and no transition was ever recorded. It writes its own pid into
    # $WATCH_PID once running, because setsid may fork.
    if command -v setsid >/dev/null 2>&1; then
        setsid "$0" __supervise >/dev/null 2>&1 &
    else
        ( watch_cable ) >/dev/null 2>&1 &
    fi
}

stop_watch() {
    if [ -f "$WATCH_PID" ]; then
        pid=$(cat "$WATCH_PID" 2>/dev/null)
        [ -n "$pid" ] && kill "$pid" 2>/dev/null || :
        # Let it notice before the UDC is taken away, otherwise it may re-probe
        # dwc3 in the middle of storage mode taking the controller.
        sleep 1
        rm -f "$WATCH_PID" 2>/dev/null || :
    fi
    # Belt and braces: a supervisor whose pidfile was never written (setsid
    # forked and stop ran inside the same few milliseconds) still has to go.
    pkill -f 'baseos-usb-debug __supervise' 2>/dev/null || :
    # Do not hand the UDC to Mass Storage while a recovery worker touches it.
    wait_i=0
    while [ -d "$RECOVERY_LOCK" ] && [ "$wait_i" -lt 60 ]; do
        sleep 0.25
        wait_i=$((wait_i + 1))
    done
    [ ! -d "$RECOVERY_LOCK" ] || {
        say "ERROR: USB recovery still active; refusing controller hand-off"
        return 1
    }
}

# The channel exists to be inspected before a shell does, so its log has to be
# readable from a PC: the card is the only place that survives the reboot
# someone reaches for when nothing came up. Only the tail is kept, and it is
# written on trouble rather than on every event - a channel that came up and
# stayed up leaves nothing behind. "force" is for the few callers that are
# themselves the event worth recording: a failed start, an explicit stop.
persist_log() {
    [ "${1:-}" = force ] || persist_enabled || return 0
    [ -d /mnt/SDCARD ] || return 0
    tail -n 120 "$LOG" 2>/dev/null >/mnt/SDCARD/rg353ps-usb-debug.txt 2>/dev/null || :
    sync 2>/dev/null || :
}

# The netdev only exists while the RNDIS function is instantiated. Its name is
# usb0 unless something else already claimed that slot, so ask the kernel which
# interface appeared instead of assuming.
find_iface() {
    for n in usb0 usb1 usb2 usb3; do
        [ -e "/sys/class/net/$n" ] && { printf '%s' "$n"; return 0; }
    done
    return 1
}

build_gadget() {
    NETWORK_ENABLED=0
    MTP_ENABLED=0
    network_enabled && NETWORK_ENABLED=1
    mtp_enabled && MTP_ENABLED=1
    [ "$NETWORK_ENABLED" -eq 1 ] || [ "$MTP_ENABLED" -eq 1 ] || {
        say "USB disabled by configuration (usb_debug=no, usb_mtp=no)"
        return 1
    }

    # configfs is not mounted on the synchronous boot path.
    if ! grep -q " /sys/kernel/config " /proc/mounts 2>/dev/null; then
        mkdir -p /sys/kernel/config 2>/dev/null || :
        if mount -t configfs none /sys/kernel/config 2>/dev/null; then
            say "mounted configfs at /sys/kernel/config"
        else
            say "cannot mount configfs; the UDC cannot be driven"
            return 1
        fi
    fi
    mkdir -p "$G" "$G/strings/0x409" "$G/configs/c.1/strings/0x409" 2>/dev/null || {
        say "cannot create USB gadget configuration"
        return 1
    }

    # Rebuild configuration links only. Function directories are retained
    # across a Mass-Storage hand-off, but stale links must not survive profile
    # changes or a switch between RNDIS and NCM.
    for stale in rndis.usb0 ncm.usb0 ecm.usb0 ffs.mtp; do
        rm -f "$G/configs/c.1/$stale" 2>/dev/null || :
    done

    printf '0x2207' >"$G/idVendor" 2>/dev/null || :
    case "$NETWORK_ENABLED:$MTP_ENABLED" in
        1:1) PRODUCT_ID=0x0008 ;; # composite network + MTP
        0:1) PRODUCT_ID=0x0009 ;; # MTP only
        *)   PRODUCT_ID=0x0007 ;; # legacy network-only identity
    esac
    printf '%s' "$PRODUCT_ID" >"$G/idProduct" 2>/dev/null || :
    printf '0x0200' >"$G/bcdUSB" 2>/dev/null || :
    printf 'BaseOS' >"$G/strings/0x409/manufacturer" 2>/dev/null || :
    printf 'RG353PS USB' >"$G/strings/0x409/product" 2>/dev/null || :
    printf 'baseos-rg353ps' >"$G/strings/0x409/serialnumber" 2>/dev/null || :
    printf '500' >"$G/configs/c.1/MaxPower" 2>/dev/null || :
    printf 'BaseOS USB' >"$G/configs/c.1/strings/0x409/configuration" 2>/dev/null || :

    FUNC=
    if [ "$NETWORK_ENABLED" -eq 0 ]; then
        # A previous development-mode session may have left Microsoft OS
        # descriptors enabled. Do not expose a stale RNDIS compatible-ID table
        # on the MTP-only release gadget.
        [ -w "$G/os_desc/use" ] && printf '0' >"$G/os_desc/use" 2>/dev/null || :
        rm -f "$G/os_desc/c.1" 2>/dev/null || :
    fi

    if [ "$NETWORK_ENABLED" -eq 1 ]; then
        case "$(config_value usb_debug_mode)" in
            ncm) fname=ncm.usb0 ;;
            ecm) fname=ecm.usb0 ;;
            *)   fname=rndis.usb0 ;;
        esac
        FUNC=$fname
        mkdir -p "$G/functions/$fname" 2>/dev/null || {
            say "cannot create network function $fname (kernel support missing?)"
            return 1
        }
        [ -w "$G/functions/$fname/dev_addr" ] &&
            printf '02:1a:11:00:42:01' >"$G/functions/$fname/dev_addr" 2>/dev/null || :
        [ -w "$G/functions/$fname/host_addr" ] &&
            printf '02:1a:11:00:42:02' >"$G/functions/$fname/host_addr" 2>/dev/null || :
        ln -sf "$G/functions/$fname" "$G/configs/c.1/$fname" 2>/dev/null || {
            say "cannot link network function $fname"
            return 1
        }
        say "network function $fname linked into c.1"

        # Microsoft's compatible-ID descriptors bind the Windows inbox RNDIS
        # driver to the network interface without masking the MTP interface.
        if [ -w "$G/os_desc/use" ]; then
            printf '1' >"$G/os_desc/use" 2>/dev/null || :
            printf '0xcd' >"$G/os_desc/b_vendor_code" 2>/dev/null || :
            printf 'MSFT100' >"$G/os_desc/qw_sign" 2>/dev/null || :
        fi
        if [ "$fname" = rndis.usb0 ]; then
            osd="$G/functions/$fname/os_desc/interface.rndis"
            if mkdir -p "$osd" 2>/dev/null; then
                printf 'RNDIS' >"$osd/compatible_id" 2>/dev/null || :
                printf '5162001' >"$osd/sub_compatible_id" 2>/dev/null || :
            fi
        fi
    fi

    if [ "$MTP_ENABLED" -eq 1 ]; then
        mkdir -p "$G/functions/ffs.mtp" 2>/dev/null || {
            say "cannot create FunctionFS MTP function"
            return 1
        }
        ln -sf "$G/functions/ffs.mtp" "$G/configs/c.1/ffs.mtp" 2>/dev/null || {
            say "cannot link FunctionFS MTP function"
            return 1
        }
        say "FunctionFS MTP linked into c.1"
    fi

    if [ "$NETWORK_ENABLED" -eq 1 ] && [ -d "$G/os_desc" ]; then
        ln -sf "$G/configs/c.1" "$G/os_desc/c.1" 2>/dev/null || :
    fi
    say "USB configuration ready: network=$NETWORK_ENABLED mtp=$MTP_ENABLED product_id=$PRODUCT_ID"
    return 0
}
configure_iface() {
    iface=$(find_iface) || { say "RNDIS netdev did not appear"; return 1; }
    ip addr add "$CIDR" dev "$iface" 2>/dev/null || :
    ip link set "$iface" up 2>/dev/null || :
    printf '%s\n' "$iface" >/run/baseos-usb-debug.iface 2>/dev/null || :
    say "usb network up: $iface $ADDR/24"
}

start_dhcp() {
    iface=$1
    pidof dnsmasq >/dev/null 2>&1 && return 0
    pidof udhcpd >/dev/null 2>&1 && return 0
    # busybox on Alpine ships no udhcpd applet, so dnsmasq is the one that is
    # actually present. port=0 keeps it from answering DNS; only DHCP is wanted.
    # Every failure is logged with the daemon's own words: the first field log
    # said only "dnsmasq failed to start", which is not something anyone can act
    # on, and the host-then-needs-a-static-address note was all it left behind.
    if command -v dnsmasq >/dev/null 2>&1; then
        err=/run/baseos-dnsmasq.err
        # The first attempt still said only "failed to start"; with the daemon's
        # own stderr it turned out to be one line - dnsmasq wants its lease file
        # in /var/lib/misc, and this rootfs is squashfs-shaped with /var on
        # tmpfs, so the directory does not exist. Point the lease file somewhere
        # that does.
        mkdir -p /var/lib/misc 2>/dev/null || :
        # Two things this rootfs does not have by default, both of which dnsmasq
        # only reports after it has already given up:
        #   - no `dnsmasq` account (assembled without --scripts), so the default
        #     privilege drop fails with "unknown user or group: dnsmasq";
        #   - no /var/lib/misc for the default lease file.
        # Naming root and /run up front turns both into a first-try success
        # instead of a failure the log has to explain away.
        #
        # --dhcp-broadcast is not optional on an RNDIS link. A host that leaves
        # the broadcast flag clear gets its reply unicast to the address being
        # offered, and dnsmasq reaches that address by injecting an ARP entry
        # first. On usb0 that fails ("ARP-cache injection failed: Invalid
        # argument"), so every DHCPOFFER was logged as sent and never reached
        # Windows, which kept retrying DISCOVER until it fell back to 169.254.
        # Answering by broadcast needs no ARP entry at all.
        dnsmasq_run() {
            dnsmasq --conf-file=/dev/null --port=0 --no-resolv --log-queries=no \
                --bind-interfaces \
                --interface="$iface" \
                --dhcp-range="$DHCP_FIRST,$DHCP_LAST,12h" \
                --dhcp-leasefile=/run/baseos-dnsmasq.leases \
                --dhcp-option=3,"$ADDR" \
                --dhcp-broadcast \
                --dhcp-authoritative \
                --user=root --group=root \
                --pid-file=/run/baseos-dnsmasq.pid \
                --log-facility=/run/baseos-dnsmasq.log "$@" 2>"$err"
        }
        if dnsmasq_run >/dev/null; then
            say "dhcp: $DHCP_FIRST-$DHCP_LAST on $iface (dnsmasq)"
            return 0
        fi
        say "dnsmasq failed: $(head -n 3 "$err" 2>/dev/null | tr '\n' ';')"
        say "set 192.168.42.2/24 on the host by hand; the link still works"
        return 0
    fi
    command -v udhcpd >/dev/null 2>&1 || { say "no dhcp server; set 192.168.42.2/24 on the host"; return 0; }
    {
        echo "start $DHCP_FIRST"
        echo "end $DHCP_LAST"
        echo "interface $iface"
        echo "lease_file $LEASES"
        echo "opt subnet 255.255.255.0"
        echo "opt router $ADDR"
        echo "opt lease 86400"
    } >"$CONF" 2>/dev/null || return 0
    : >"$LEASES" 2>/dev/null || :
    if udhcpd "$CONF" >/dev/null 2>&1; then
        say "dhcp: $DHCP_FIRST-$DHCP_LAST on $iface (udhcpd)"
    else
        say "udhcpd failed; the host will need a static address"
    fi
}

start_sshd() {
    pidof dropbear >/dev/null 2>&1 && return 0
    command -v dropbear >/dev/null 2>&1 || { say "dropbear missing"; return 1; }
    mkdir -p /etc/dropbear /root/.ssh 2>/dev/null || :
    chmod 700 /root/.ssh 2>/dev/null || :
    # A key dropped on the user partition beats the one baked into the rootfs,
    # so access can be rotated without shipping a new image.
    if [ -r /mnt/SDCARD/baseos-ssh/authorized_keys ]; then
        cp /mnt/SDCARD/baseos-ssh/authorized_keys /root/.ssh/authorized_keys 2>/dev/null && \
            say "authorized_keys taken from the user partition"
    elif [ ! -s /root/.ssh/authorized_keys ] && [ -r /etc/dropbear/authorized_keys ]; then
        cp /etc/dropbear/authorized_keys /root/.ssh/authorized_keys 2>/dev/null || :
    fi
    chmod 600 /root/.ssh/authorized_keys 2>/dev/null || :
    [ -s /root/.ssh/authorized_keys ] || say "WARNING: no authorized_keys; ssh logins will be refused"
    # -R generates host keys on first run. Password auth is NOT refused (-s is
    # deliberately absent) so a unit whose key is lost can still be reached as
    # root with the password baked into /etc/shadow. The listener is bound to
    # the RNDIS address only, so this never opens on Wi-Fi.
    if dropbear -R -p "$ADDR:22" -P "$PIDFILE_DROPBEAR" >/dev/null 2>&1; then
        say "sshd listening on $ADDR:22"
    else
        say "dropbear failed to start"
        return 1
    fi
}

stop_services() {
    if [ -f "$PIDFILE_DROPBEAR" ]; then
        kill "$(cat "$PIDFILE_DROPBEAR" 2>/dev/null)" 2>/dev/null || :
        rm -f "$PIDFILE_DROPBEAR" 2>/dev/null || :
    fi
    pidof dropbear >/dev/null 2>&1 && killall dropbear 2>/dev/null || :
    pidof udhcpd >/dev/null 2>&1 && killall udhcpd 2>/dev/null || :
    if [ -f /run/baseos-dnsmasq.pid ]; then
        kill "$(cat /run/baseos-dnsmasq.pid 2>/dev/null)" 2>/dev/null || :
        rm -f /run/baseos-dnsmasq.pid 2>/dev/null || :
    fi
    pidof dnsmasq >/dev/null 2>&1 && killall dnsmasq 2>/dev/null || :
    rm -f "$PIDFILE_DHCP" 2>/dev/null || :
}

do_start() {
    NETWORK_ENABLED=0
    MTP_ENABLED=0
    network_enabled && NETWORK_ENABLED=1
    mtp_enabled && MTP_ENABLED=1
    if [ "$NETWORK_ENABLED" -eq 0 ] && [ "$MTP_ENABLED" -eq 0 ]; then
        say "USB networking and MTP are both disabled; no gadget will be bound"
        persist_log
        return 0
    fi

    UDC=$(wait_udc) || { say "no UDC after 10s; cannot bring USB functions up"; persist_log force; exit 1; }
    say "starting USB gadget on UDC $UDC (network=$NETWORK_ENABLED mtp=$MTP_ENABLED)"
    disable_usb_runtime_pm
    build_gadget || { persist_log force; exit 1; }

    # FunctionFS descriptors must be registered before binding the UDC.
    if [ "$MTP_ENABLED" -eq 1 ]; then
        if /usr/sbin/baseos-usb-mtp start; then
            say "MTP FunctionFS descriptors and endpoints are ready"
        else
            say "WARNING: MTP failed to initialise"
            /usr/sbin/baseos-usb-mtp stop >/dev/null 2>&1 || :
            rm -f "$G/configs/c.1/ffs.mtp" 2>/dev/null || :
            MTP_ENABLED=0
            if [ "$NETWORK_ENABLED" -eq 1 ]; then
                printf '0x0007' >"$G/idProduct" 2>/dev/null || :
                say "falling back to the existing network-only gadget"
            else
                say "MTP is the only enabled function and could not start; leaving UDC unbound"
                persist_log force
                exit 1
            fi
        fi
    fi

    current=$(cat "$G/UDC" 2>/dev/null || :)
    if [ "$current" != "$UDC" ]; then
        [ -n "$current" ] && printf '\n' >"$G/UDC" 2>/dev/null || :
        if ! printf '%s' "$UDC" >"$G/UDC" 2>/dev/null; then
            say "cannot bind $UDC (another gadget holds it?)"
            /usr/sbin/baseos-usb-mtp stop >/dev/null 2>&1 || :
            persist_log force
            exit 1
        fi
        say "gadget bound to $UDC"
    fi

    if [ "$NETWORK_ENABLED" -eq 1 ]; then
        configure_iface || :
        iface=$(cat /run/baseos-usb-debug.iface 2>/dev/null || echo usb0)
        start_dhcp "$iface"
        start_sshd
        say "USB network ready: $iface $ADDR/24; SSH on $ADDR:22"
        say "cable status at start: $(cable_present && echo present || echo absent) vbus=$(vbus_state) state=$(udc_state)"
        probe_dump "after start"
    else
        say "MTP-only gadget bound; no network, DHCP or SSH listener started"
    fi
    # The same DWC3/PHY recovery supervisor is useful in MTP-only mode. Its
    # network-specific repair steps are guarded by usb_debug.
    start_watch
    persist_log
}
do_stop() {
    stop_watch || { persist_log force; return 1; }
    stop_services
    if [ -e "$G/UDC" ]; then
        if ! printf '\n' >"$G/UDC" 2>/dev/null; then
            say "ERROR: could not unbind USB gadget from UDC; refusing hand-off"
            persist_log force
            return 1
        fi
        bound="$(cat "$G/UDC" 2>/dev/null || :)"
        if [ -n "$bound" ]; then
            say "ERROR: UDC still reports a bound controller ($bound); refusing hand-off"
            persist_log force
            return 1
        fi
    fi
    # MTP has access to the mounted user-data tree. It must exit and FunctionFS
    # must unmount before the storage helper may unmount/export that partition.
    if [ -x /usr/sbin/baseos-usb-mtp ]; then
        if ! /usr/sbin/baseos-usb-mtp stop >/dev/null 2>&1; then
            say "ERROR: MTP/FunctionFS did not stop cleanly; refusing Mass Storage hand-off"
            persist_log force
            return 1
        fi
    fi
    say "USB gadget stopped; UDC and FunctionFS released"
    persist_log
    return 0
}
do_status() {
    iface=$(cat /run/baseos-usb-debug.iface 2>/dev/null || find_iface || echo none)
    UDC=$(find_udc)
    printf 'usb_debug: %s\n' "$(config_value usb_debug || echo unset)"
    printf 'usb_mtp:   %s\n' "$(config_value usb_mtp || echo unset)"
    printf 'gadget:    %s\n' "$([ -d "$G" ] && echo present || echo absent)"
    if [ -x /usr/sbin/baseos-usb-mtp ]; then
        /usr/sbin/baseos-usb-mtp status | sed 's/^/mtp:       /'
    fi
    printf 'function:  %s\n' "$(config_value usb_debug_mode || echo rndis)"
    printf 'udc bound: %s\n' "$(cat "$G/UDC" 2>/dev/null || echo none)"
    printf 'udc state: %s\n' "$(udc_state)"
    printf 'cable:     %s\n' "$(cable_present && echo present || echo absent)"
    printf 'vbus:      %s\n' "$(vbus_state)"
    printf 'extcon:    %s\n' "$(extcon_summary)"
    printf 'interface: %s\n' "$iface"
    [ "$iface" != none ] && ip -4 addr show "$iface" 2>/dev/null | sed -n 's/^ *inet /address:   /p'
    printf 'dropbear:  %s\n' "$(pidof dropbear >/dev/null 2>&1 && echo running || echo stopped)"
    printf 'dhcp:      %s\n' "$(pidof dnsmasq >/dev/null 2>&1 && echo "dnsmasq running" || (pidof udhcpd >/dev/null 2>&1 && echo "udhcpd running" || echo stopped))"
    printf 'watcher:   %s\n' "$([ -f "$WATCH_PID" ] && kill -0 "$(cat "$WATCH_PID" 2>/dev/null)" 2>/dev/null && echo running || echo stopped)"
    printf 'soft-connect test: %s\n' "$([ -e "$SOFT_CONNECT_TEST_ARMED" ] && echo armed || echo not-armed)"
    printf 'soft-connect log: %s\n' "$([ -r "$SOFT_CONNECT_TEST_LOG" ] && echo "$SOFT_CONNECT_TEST_LOG" || echo none)"
    printf 'log:       %s\n' "$LOG"
    printf 'card log:  %s\n' "$([ -r /mnt/SDCARD/rg353ps-usb-debug.txt ] && echo /mnt/SDCARD/rg353ps-usb-debug.txt || echo none)"
}

case "${1:-status}" in
    start)   do_start ;;
    stop)    do_stop ;;
    restart) do_stop; sleep 1; do_start ;;
    status)  do_status ;;
    soft-connect-test-arm) arm_soft_connect_test ;;
    soft-connect-test-cancel) cancel_soft_connect_test ;;
    # Internal entry point for the detached supervisor: it re-resolves the UDC
    # itself instead of inheriting do_start's variables, so it survives rcS.
    __supervise)
        printf '%s\n' "$$" >"$WATCH_PID" 2>/dev/null || :
        UDC=$(find_udc) || :
        [ -n "$UDC" ] || { say "supervisor: no UDC; exiting"; exit 1; }
        watch_cable
        ;;
    *) echo "usage: $0 start|stop|restart|status" >&2; exit 2 ;;
esac
