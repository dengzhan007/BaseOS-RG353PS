#!/bin/sh
# Bring the RG353PS codec up before any frontend starts.
#
# The board's only output is a simple-audio-card named rk817_ext: the RK817
# codec drives HPOL/HPOR, and the internal speakers hang off a separate
# simple-amplifier ("Speaker Amp") gated by GPIO4_C2. A stock Alpine rootfs
# never touches either, so the amplifier stays off and the DAC sits at its reset
# level - a frontend that opens ALSA but never talks to the mixer (Slot does
# exactly that) comes up silent. NextUI hides the same gap because its audiomon
# daemon sets the controls itself.
#
# Why the volume lives in a softvol layer
# ---------------------------------------
# RK817 exposes its DAC gain as a raw 0..255 register that maps linearly onto
# -95.5 dB..0 dB. ALSA's "%" on that control is a percentage of the *register*,
# not of the useful range, so 50% is -47 dB and 20% is -76 dB: both are silence
# on this speaker. Anything that moves the hardware control (the volume keys,
# a restored asound.state, a codec re-probe after resume) therefore produces a
# volume curve that is wildly non-linear and different from boot to boot.
#
# So the hardware gain is pinned at 0 dB on every run and the user-facing volume
# is the "BaseOS Master" softvol control: 0..100 mapped onto -48 dB..0 dB. That
# is one predictable curve for every frontend, and the same control the volume
# keys move.
#
# Runs on every boot and again after resume; every step is best effort and
# nothing here can block the boot.

LOG=/run/baseos-audio.log
# Where the mixer state lives. The root filesystem is mounted read-only, so a
# path under /var would be lost on the next boot; the state has to be on the
# user volume instead. The name on the volume is deliberately not
# "asound.state": the directory entry for that one is damaged on cards that
# have taken hard power-offs, and deleting and recreating it does not clear
# it. This path is ours alone, so it takes a name whose entry is healthy
# instead of fighting a damaged one.
#
# The blob is only used to carry the user's own mixer settings across a boot.
# If the volume is not there - a card that failed to mount, a unit that has
# never been initialized - the mixer still works, it just starts from the
# defaults below.
STATE_DIR=/mnt/SDCARD/.baseos/state
# A unit whose user volume did not mount has nowhere persistent to write, but
# /var is a tmpfs and is writable. The mixer settings are then lost across the
# reboot, which is a much smaller failure than a script that cannot run at all.
mkdir -p "$STATE_DIR" 2>/dev/null || STATE_DIR=/var/lib/alsa
mkdir -p "$STATE_DIR" 2>/dev/null || :
STATE=$STATE_DIR/baseos-alsa-state
SOFTVOL_CTL='BaseOS Master'
# 0% maps here. -48 dB is inaudible on this speaker while still leaving the
# whole 0..100 range useful instead of squeezing it into the top 5%.
SOFTVOL_MIN_DB=-48.0
MAX_WAIT=15

# Wall clock is useless for boot work: it cannot be lined up with the rcS marks
# or the frontend handoff, and it silently rounds to a whole second. Prefix the
# kernel's uptime instead, which is the same clock /proc/uptime reports.
say() {
    up=$(cut -d' ' -f1 /proc/uptime 2>/dev/null || :)
    printf '%7s %s\n' "${up:-?}" "$*" >>"$LOG" 2>/dev/null || :
}

find_card() {
    i=0
    while [ "$i" -lt 8 ]; do
        id=$(cat "/sys/class/sound/card$i/id" 2>/dev/null || :)
        case "$id" in
            *[rR][kK]817*) echo "$i"; return 0 ;;
        esac
        i=$((i + 1))
    done
    return 1
}

: >>"$LOG" 2>/dev/null || :

CARD=
n=0
# Poll fast, then fall back to 1 s. The keypad poll was 1 s flat, so a codec that
# probed at 8.6 s was not noticed until 9.5 s and the frontend session, which
# waits for the ready flag below, sat idle for the difference: measured on the
# device, that alone was most of a second of the boot. The first 5 s are the
# window where a normal boot's codec appears, so 100 ms there costs nothing; the
# slow tail keeps 1 s so a missing codec does not spin the CPU for 15 s.
while [ "$n" -lt "$MAX_WAIT" ]; do
    CARD=$(find_card) && break
    if [ "$n" -lt 5 ]; then sleep 0.1; else sleep 1; fi
    n=$((n + 1))
done
if [ -z "$CARD" ]; then
    say "no rk817 sound card after ${MAX_WAIT}s; leaving the mixer alone"
    : >/run/baseos-audio-ready 2>/dev/null || :
    exit 0
fi
say "rk817 codec is card$CARD ($(cat "/sys/class/sound/card$CARD/id" 2>/dev/null))"

# 1. ALSA default = plug -> softvol -> the codec. "default" otherwise resolves
#    to card 0, and on this board HDMI can probe as card 0 with no sink
#    attached, which is a very quiet way to lose all sound.
#
#    The file is rewritten whenever the card index it names changes; a stale
#    index after a re-probe would point the whole stack at HDMI.
write_asound() {
    {
        echo '# BASEOS audio: the RK817 codec is the only output this unit has.'
        echo '# Generated by baseos-audio-init; edit that script, not this file.'
        echo '#'
        echo '# The hardware DAC is pinned at 0 dB and the user volume is the'
        echo '# softvol control below, so 0..100 is -48 dB..0 dB end to end.'
        echo 'pcm.baseos_hw {'
        echo '    type hw'
        echo "    card $CARD"
        echo '    device 0'
        echo '}'
        echo 'pcm.baseos_vol {'
        echo '    type softvol'
        echo '    slave.pcm "baseos_hw"'
        echo '    control {'
        echo "        name \"$SOFTVOL_CTL\""
        echo "        card $CARD"
        echo '    }'
        echo "    min_dB $SOFTVOL_MIN_DB"
        echo '    max_dB 0.0'
        echo '    resolution 100'
        echo '}'
        echo 'pcm.!default {'
        echo '    type plug'
        echo '    slave.pcm "baseos_vol"'
        echo '}'
        echo 'ctl.!default {'
        echo '    type hw'
        echo "    card $CARD"
        echo '}'
    } >/etc/asound.conf 2>/dev/null || say "could not write /etc/asound.conf"
}

write_asound

mixer_names() {
    amixer -c "$CARD" controls 2>/dev/null |
        sed -n "s/^numid=[0-9][0-9]*,.*name='\(.*\)'$/\1/p"
}

# 2. Pin every hardware gain at 0 dB and close every playback switch, so that
#    nothing but the softvol layer can change the level. Capture controls are
#    left alone, and the softvol control is filtered out by name.
pin_hardware() {
    mixer_names | while IFS= read -r name; do
        [ "$name" = "$SOFTVOL_CTL" ] && continue
        case "$name" in
            *Volume*)
                if amixer -c "$CARD" cset name="$name" 100% >/dev/null 2>&1; then
                    say "hardware '$name' -> 100% (0 dB)"
                fi
                ;;
            *Switch*)
                case "$name" in
                    *Capture*|*Mic*|*PGA*) continue ;;
                esac
                if amixer -c "$CARD" cset name="$name" on >/dev/null 2>&1; then
                    say "switch '$name' -> on"
                fi
                ;;
        esac
    done
}

softvol_present() {
    amixer -c "$CARD" sget "$SOFTVOL_CTL" >/dev/null 2>&1
}

# 3. Create the softvol control before restore: the plugin only registers it
#    when a PCM using it is opened, and alsactl cannot restore a control that
#    does not exist yet. One second of silence is enough and runs off the boot
#    path.
if ! softvol_present; then
    # The control appears when the PCM is opened, so what matters is that the
    # device is opened and one period written - not how long the audio runs.
    # This used to play a full second of silence (-d 1), which measured 1.02 s
    # of the boot for no benefit; piping a few hundred bytes into aplay gets
    # the same registration in 0.14 s. The fallback keeps the old path for a
    # codec whose first open needs longer than that to settle.
    if head -c 2048 /dev/zero 2>/dev/null |
            aplay -q -D default -t raw -f S16_LE -r 48000 -c 2 >/dev/null 2>&1 &&
            softvol_present; then
        say "softvol control created"
    elif aplay -q -D default -t raw -f S16_LE -r 48000 -c 2 -d 1 /dev/zero >/dev/null 2>&1; then
        say "softvol control created (slow path)"
    else
        say "could not open default PCM to create the softvol control"
    fi
fi

# 4. Pin the hardware before anything can open the PCM.
#
#    The state blob used to be restored here first, because a blob carrying an
#    old, low hardware gain would otherwise land on top of the pin. That restore
#    is cheap on a running system (0.02 s) but measured 1.6 s inside a boot -
#    and it sat directly in front of the ready flag below, so it was the last
#    large item between rcS and the frontend. Nothing the frontend needs comes
#    out of it: the pin below is what makes sound audible, and it no longer has
#    to wait. The restore moved to the deferred pass in 5, which re-pins and
#    re-applies the user level afterwards, so the ordering still holds - the
#    frontend just does not sit through it.
pin_hardware

# The softvol level is also kept in its own file: alsactl restores one state
# blob and can give up on a single mismatched control, and silently losing the
# user's volume to that is worse than a duplicated source of truth. The file
# wins when it is present and well formed.
#
# The number in the file is the control's own value (0..99), not a percentage.
# That distinction is not cosmetic: writing 99 and then restoring it as "99%"
# lands on 98, so a unit would lose one step of volume on every boot. cset
# writes the value through untouched.
VOLUME_FILE=$STATE_DIR/baseos-volume
# A frontend that runs its own volume bar (Slot, and anything else that answers
# the volume keys itself) does not use this control as a fader - it uses it as a
# fixed gain stage and draws its own percentage. When one owns the keys, the
# mixer level is a constant, and restoring the file's value over it is what left
# the unit silent on boot with the frontend's bar sitting at "30%".
FRONTEND_MARKER=/run/baseos-volume-frontend
FRONTEND_LEVEL=90
frontend_owns_volume() {
    [ -s "$FRONTEND_MARKER" ] || return 1
    fp=$(cat "$FRONTEND_MARKER" 2>/dev/null)
    case "$fp" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ -d "/proc/$fp" ] || return 1
    return 0
}

# The file's 0 is not a user preference more often than it is a leftover from a
# test or a key held down to the bottom; booting silently and leaving the user to
# find the keys again is a worse failure than starting at a usable level.
VOLUME_DEFAULT=60
if frontend_owns_volume; then
    if amixer -c "$CARD" cset name="$SOFTVOL_CTL" "$FRONTEND_LEVEL" >/dev/null 2>&1; then
        say "softvol '$SOFTVOL_CTL' -> $FRONTEND_LEVEL (a frontend owns the keys via $FRONTEND_MARKER)"
    fi
elif [ -s "$VOLUME_FILE" ]; then
    saved=$(cat "$VOLUME_FILE" 2>/dev/null)
    case "$saved" in
        ''|*[!0-9]*) say "ignoring malformed $VOLUME_FILE ('$saved')" ;;
        *)
            if [ "$saved" -lt 5 ]; then
                say "$VOLUME_FILE held $saved; treating that as leftover rather than a level"
                saved=$VOLUME_DEFAULT
            fi
            if amixer -c "$CARD" cset name="$SOFTVOL_CTL" "$saved" >/dev/null 2>&1; then
                say "softvol '$SOFTVOL_CTL' -> value $saved from $VOLUME_FILE"
            fi
            ;;
    esac
fi

# First boot on this rootfs slot, or a state file that predates the softvol
# layer: start at 100% so "volume all the way up" really is full scale. The
# marker is what decides this, not the current value - a user who left the
# volume at 0 must not be turned back up by the next boot.
VOLUME_MARKER=$STATE_DIR/baseos-volume-model
if ! softvol_present; then
    say "softvol control still missing; volume keys will fall back to hardware"
elif [ ! -e "$VOLUME_MARKER" ]; then
    if amixer -c "$CARD" sset "$SOFTVOL_CTL" 100% >/dev/null 2>&1; then
        say "softvol '$SOFTVOL_CTL' initialised to 100%"
    fi
    : >"$VOLUME_MARKER" 2>/dev/null || :
fi

# Everything the frontend needs is in place: /etc/asound.conf names the codec,
# the softvol control exists, the hardware gains are pinned and the user level
# is applied. Signal that now, before the persistence work below.
WANT_LEVEL=$(amixer -c "$CARD" cget name="$SOFTVOL_CTL" 2>/dev/null |
    sed -n 's/^ *: values=\([0-9]*\).*/\1/p' | head -1)
# The frontend session waits for this file before it paints its volume bar.
: >/run/baseos-audio-ready 2>/dev/null || :

# 5. Deferred pass: restore the saved state blob, then undo whatever it did to
#    the two things that decide how loud this unit is.
#
#    Runs after the ready flag because none of it can change whether the
#    frontend works, and it was measured at 1.6 s inside a boot. $WANT_LEVEL is
#    the level the synchronous path already settled on, so a blob from an older
#    volume model cannot silently move it.
#
#    alsactl locks "<state>.lock" next to the state file with fcntl, and opens
#    that lock with O_CREAT only when the *state file already exists*. On a
#    first boot it therefore fails before writing anything:
#
#        alsactl: state_lock:168: file .../asound.state lock error:
#        No such file or directory
#
#    which is exactly the line the unit reported, and which quietly cost every
#    boot its persisted hardware gains. An empty file is enough for the lock to
#    have something to open; store overwrites it with real content straight
#    after. The lock file itself is never removed, so it has to live on a
#    filesystem that supports fcntl locks - the user volume's exFAT does, and
#    that was checked on the device before the path was moved there.
(
    if [ -s "$STATE" ] && alsactl -f "$STATE" restore >/dev/null 2>&1; then
        say "restored $STATE (deferred)"
        # A blob can carry a low hardware gain and an older softvol level; both
        # are re-applied, in this order, so the pin is never the loser.
        pin_hardware
        case "${WANT_LEVEL:-}" in
            ''|*[!0-9]*) : ;;
            *) amixer -c "$CARD" cset name="$SOFTVOL_CTL" "$WANT_LEVEL" >/dev/null 2>&1 || : ;;
        esac
    fi

    mkdir -p "${STATE%/*}" 2>/dev/null || :
    [ -e "$STATE" ] || : >"$STATE" 2>/dev/null || :
    if alsactl -f "$STATE" store >/dev/null 2>&1; then
        say "saved $STATE"
    else
        say "could not save $STATE"
    fi

    # The user's level is also written back here, so a volume set through the
    # frontend (which never touches the hotkey daemon) is not lost on reboot. It
    # only records a value that is actually readable - a failed cget must not
    # overwrite a good file with garbage.
    cur=$(amixer -c "$CARD" cget name="$SOFTVOL_CTL" 2>/dev/null |
        sed -n 's/^ *: values=\([0-9]*\).*/\1/p' | head -1)
    case "${cur:-}" in
        ''|*[!0-9]*) : ;;
        *) [ -s "$VOLUME_FILE" ] && [ "$(cat "$VOLUME_FILE" 2>/dev/null)" = "$cur" ] || \
               printf '%s\n' "$cur" >"$VOLUME_FILE" 2>/dev/null || : ;;
    esac
    say "volume model: hardware 0 dB, softvol ${cur:-?}% (-48..0 dB)"
) >/dev/null 2>&1 &
exit 0
