+        assert_eq!(hat.feed(abs(ABS_X, 519)), vec![RawEvent::Up(Btn::Right)]);
+        assert_eq!(hat.feed(abs(ABS_X, 15)), vec![RawEvent::Down(Btn::Left)]);
