+/// True when this event node is the adc-joystick: all four ABS channels, and on
+/// this board no keys at all. Only this node may publish the analog axes - the
+/// gpio-keys node carries none and would otherwise overwrite them with centre
+/// every time a button is pressed.
+pub fn is_stick_node(sys: &Path, node: &Path) -> bool {
+    let Some(name) = node.file_name() else {
+        return false;
+    };
