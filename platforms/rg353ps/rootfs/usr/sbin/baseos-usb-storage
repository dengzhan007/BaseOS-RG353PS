#!/bin/sh
# Expose the active frontend/user-data partition over USB mass storage.
# Never export the system root or BASEOS_BOOT partition.
set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

REQUEST=/run/baseos-usb-storage.request
PAUSED=/run/baseos-frontend-paused
ACTIVE=/run/baseos-usb-storage.active
DIAG_LOG=/run/rg353ps-usb-storage.log
BOOT_LOG=/mnt/boot/rg353ps-usb-storage.log
KERNEL_ERR_START_SEC="$(awk '{print $1}' /proc/uptime 2>/dev/null)"
LAST_KERNEL_ERRORS=
LAST_SCSI_START_SEQ=0
LAST_SCSI_FINISH_SEQ=0
LAST_EP0_SETUPS=
LAST_WRITE_SECTORS=
hb_write_sectors=
NO_WRITE_PROGRESS_SECONDS=0
LAST_STALL_DIAG_SECONDS=0
CONFIGFS=/sys/kernel/config
G="$CONFIGFS/usb_gadget/rockchip"
UDC=
OLD_UDC=
HAD_ADB=0
MOUNTPOINT=
DEVICE=
FSTYPE=
BOUND=0
CABLE_TRIGGERED=0
CREATED_GADGET=0
BOOT_MODE=0
RESET_NOT_CONFIGURED_SECONDS=0
RESET_RECOVERY_ATTEMPTED=0
ENUM_SOFT_PULSES=0
ENUM_REBINDS=0
ENUM_REPROBES=0
PROMPT_PID=
FLUSH_PID=
i=unset
ORIGINAL_PRINTK=
CONSOLE_LOWERED=0
# Keep the previous session's card copy instead of overwriting it. Every entry
# truncated /mnt/boot/rg353ps-usb-storage.log, so the only trace that ever
# existed on the card was the last run: a session that failed, followed by one
# that worked, left no evidence of the failure at all. Name snapshots by the
# timestamp of the run being saved so the newest sorts last.
rotate_diag_logs() {
  [ -s "$BOOT_LOG" ] || return 0
  rotate_stamp="$(date '+%Y%m%d-%H%M%S' 2>/dev/null || echo unknown)"
  mv "$BOOT_LOG" "/mnt/boot/rg353ps-usb-storage-$rotate_stamp.log" 2>/dev/null || :
  # Evict anything past the five most recent snapshots.
  for rotate_old in $(ls -1 /mnt/boot/rg353ps-usb-storage-*.log 2>/dev/null | sort | head -n -5); do
    rm -f "$rotate_old" 2>/dev/null || :
  done
}
: > "$DIAG_LOG"
# BASEOS_BOOT_LIVE_LOG_V1: mirror logs to BOOT so forced power-off preserves progress.
if [ -d /mnt/boot ] && grep -q ' /mnt/boot ' /proc/mounts 2>/dev/null; then
  rotate_diag_logs
  : > "$BOOT_LOG" 2>/dev/null || :
  printf '%s baseos-usb-storage: session started; live BOOT logging enabled\n' "$(date '+%F %T' 2>/dev/null || echo uptime)" >> "$BOOT_LOG" 2>/dev/null || :
  sync
fi
case "${1:-}" in
  "") ;;
  --boot) BOOT_MODE=1 ;;
  *) log "unknown argument: $1"; exit 2 ;;
esac

log() {
  line="$(date '+%F %T' 2>/dev/null || echo uptime) baseos-usb-storage: $*"
  printf '%s\n' "$line" >> "$DIAG_LOG"
  printf '<6>baseos-usb-storage: %s\n' "$*" > /dev/kmsg 2>/dev/null || :
  if [ -d /mnt/boot ] && grep -q ' /mnt/boot ' /proc/mounts 2>/dev/null; then
    printf '%s\n' "$line" >> "$BOOT_LOG" 2>/dev/null || :
  fi
}
set_storage_console_quiet() {
  [ -r /proc/sys/kernel/printk ] && [ -w /proc/sys/kernel/printk ] || return 0
  ORIGINAL_PRINTK="$(cat /proc/sys/kernel/printk 2>/dev/null)"
  [ -n "$ORIGINAL_PRINTK" ] || return 0
  set -- $ORIGINAL_PRINTK
  [ "$#" -ge 4 ] || return 0
  case "$1" in ''|*[!0-9]*) return 0 ;; esac
  if [ "$1" -gt 1 ]; then
    if printf '1 %s %s %s\n' "$2" "$3" "$4" > /proc/sys/kernel/printk 2>/dev/null; then
      CONSOLE_LOWERED=1
      log "console output reduced to emergency-only during USB storage; detailed trace remains in dmesg (original printk=$ORIGINAL_PRINTK)"
    else
      log "WARNING: could not reduce console log level; detailed USB tracing may scroll on screen"
    fi
  fi
}
restore_console_loglevel() {
  if [ "$CONSOLE_LOWERED" -eq 1 ] && [ -n "$ORIGINAL_PRINTK" ]; then
    if printf '%s\n' "$ORIGINAL_PRINTK" > /proc/sys/kernel/printk 2>/dev/null; then
      CONSOLE_LOWERED=0
      log "console printk settings restored"
    else
      log "WARNING: could not restore console printk settings"
    fi
  fi
}
is_mounted() { grep -q " $1 " /proc/mounts; }
read_usb_attr() {
  p="$1"
  [ -r "$p" ] || return 0
  value="$(cat "$p" 2>/dev/null | tr '\n' ' ')"
  log "USB sysfs: $p=$value"
}
is_data_cable_connected() {
  # Prefer the UDC's supplier-PHY extcon entries when this kernel exposes them.
  for cable in /sys/devices/platform/"$UDC"/supplier:platform:*usb2phy/extcon/*/cable.*; do
    [ -r "$cable/name" ] && [ -r "$cable/state" ] || continue
    probe_name="$(cat "$cable/name" 2>/dev/null)"
    case "$probe_name" in
      SDP|CDP)
        [ "$(cat "$cable/state" 2>/dev/null)" = "1" ] && return 0
        ;;
    esac
  done
  # Some RK3566 kernels expose only the aggregate state through /sys/class/extcon.
  # Match SDP/CDP as complete whitespace-delimited tokens, not a shell glob.
  for extcon in /sys/class/extcon/*; do
    [ -r "$extcon/name" ] && [ -r "$extcon/state" ] || continue
    probe_name="$(cat "$extcon/name" 2>/dev/null)"
    case "$probe_name" in *usb2phy*) ;; *) continue ;; esac
    probe_state="$(cat "$extcon/state" 2>/dev/null)"
    if printf '%s\n' "$probe_state" | grep -Eq '(^|[[:space:]])(SDP|CDP)=1([[:space:]]|$)'; then
      return 0
    fi
  done
  return 1
}
log_cable_probe_inputs() {
  probe_reason="$1"
  for probe_extcon in /sys/class/extcon/*; do
    [ -r "$probe_extcon/name" ] && [ -r "$probe_extcon/state" ] || continue
    probe_name="$(cat "$probe_extcon/name" 2>/dev/null)"
    case "$probe_name" in *usb2phy*) ;; *) continue ;; esac
    probe_state="$(cat "$probe_extcon/state" 2>/dev/null)"
    log "cable detector input reason=$probe_reason path=$probe_extcon name=$probe_name state=$probe_state"
  done
}
# "Is a PC on the other end?" — deliberately wider than the extcon query above.
#
# On this RK3566 port, plugging the cable in during the same instant the UDC is
# bound can leave the USB2PHY's SDP bit unasserted even though the controller
# did attach: the PHY's VBUS interrupt and the UDC's attach race, and the state
# machine that would have set SDP=1 never runs. The old wait loop keyed only on
# extcon, so that case waited the full hour with the cable connected — the
# device looked frozen on "WAITING FOR DATA CABLE" and unplugging changed
# nothing, so a second signal is still worth having.
#
# Only "powered" and up count. "attached" does NOT: the UDC core reports it as
# soon as a gadget is bound to the controller, with or without a cable. Keying
# on anything above "not attached" made this function true the instant the
# gadget was bound, which skipped the wait entirely -- storage mode jumped
# straight to "CONNECTING USB STORAGE" with no cable attached, then died when
# enumeration never started. That is the bug this list exists to prevent.
cable_present() {
  is_data_cable_connected && return 0
  case "$(cat "/sys/class/udc/$UDC/state" 2>/dev/null)" in
    powered|configured|suspended) return 0 ;;
  esac
  return 1
}
ep0_control_ready() {
  [ -r "/sys/kernel/debug/usb/$UDC/ep0out/transfer_type" ] &&
    grep -q 'control' "/sys/kernel/debug/usb/$UDC/ep0out/transfer_type" 2>/dev/null
}
# Hold the controller and its PHYs out of runtime power management for the
# whole session. See the call site for why.
disable_usb_runtime_pm() {
  for pm_path in /sys/bus/platform/devices/"$UDC" /sys/bus/platform/devices/*usb2phy*; do
    [ -w "$pm_path/power/control" ] || continue
    pm_before="$(cat "$pm_path/power/control" 2>/dev/null)"
    printf 'on' > "$pm_path/power/control" 2>/dev/null || continue
    log "runtime PM forced on: $pm_path (was ${pm_before:-unreadable})"
  done
}
# Recovery ladder for a first enumeration that never completes.
#
# The old code only ever recovered a *re*-enumeration: it required $seen=1, so
# when the very first attempt failed the helper sat idle for 45 seconds and then
# gave up, leaving "CONNECTING USB STORAGE" on screen with an unresponsive PC.
# Overnight that was reported as "plug in the cable, nothing happens, reboot two
# or three times until it takes".
#
# Two escalating actions exist on this DWC3/PHY combination:
#   soft pulse   disconnect + connect on soft_connect: makes the host see a new
#                attach, and is cheap enough to try first.
#   rebind       unbind the gadget from the UDC and bind it again: drops and
#                rebuilds the whole gadget state, including an EP0 that failed to
#                enable. Heavier, so it is used second and twice at most.
pulse_soft_connect() {
  enum_soft="/sys/class/udc/$UDC/soft_connect"
  [ -w "$enum_soft" ] || { log "enumeration recovery: soft_connect not writable; skipping pulse"; return 1; }
  log "enumeration recovery: soft_connect pulse (disconnect/connect) to restart host enumeration"
  printf 'disconnect' > "$enum_soft" 2>/dev/null || {
    log "enumeration recovery: soft_connect=disconnect failed"
    return 1
  }
  sleep 1
  printf 'connect' > "$enum_soft" 2>/dev/null || {
    log "enumeration recovery: soft_connect=connect failed"
    return 1
  }
  sleep 1
  log "enumeration recovery: pulse done state=$(cat "/sys/class/udc/$UDC/state" 2>/dev/null || echo unknown)"
  return 0
}
rebind_gadget() {
  log "enumeration recovery: unbinding UDC $UDC from the gadget"
  enum_err=
  if [ -e "$G/UDC" ] && enum_err="$(printf '\n' 2>&1 > "$G/UDC")"; then
    BOUND=0
    sleep 1
    if enum_err="$(printf '%s' "$UDC" 2>&1 > "$G/UDC")"; then
      BOUND=1
      sleep 2
      log "enumeration recovery: rebind done state=$(cat "/sys/class/udc/$UDC/state" 2>/dev/null || echo unknown)"
      return 0
    fi
    log "enumeration recovery: rebind failed error=${enum_err:-no stderr}"
    return 1
  fi
  log "enumeration recovery: unbind failed error=${enum_err:-no stderr}"
  return 1
}
edited_udc_state() {
  cat "/sys/class/udc/$UDC/state" 2>/dev/null || echo unknown
}
# Re-probe the platform driver that owns the UDC: unbind the controller from its
# driver, let it probe again, then re-bind the gadget. This rebuilds the
# controller and its PHY from scratch, which is the closest thing to the clean
# state the unit has immediately after boot -- the only time storage mode has
# never failed. Forcing a power cycle to get that state back is exactly what the
# two lighter tools could not avoid.
reprobe_udc_driver() {
  rp_drv="$(readlink "/sys/bus/platform/devices/$UDC/driver" 2>/dev/null)"
  [ -n "$rp_drv" ] || {
    log "enumeration recovery: no platform driver bound to $UDC; cannot re-probe"
    return 1
  }
  rp_drv="${rp_drv##*/}"
  log "enumeration recovery: re-probing $UDC on driver $rp_drv"
  # The gadget must be off the UDC first: removing the platform device takes the
  # UDC device with it, and a UDC device that disappears while the gadget is
  # bound to it leaves the gadget unbound for the rest of the session.
  if [ -e "$G/UDC" ]; then printf '\n' > "$G/UDC" 2>/dev/null || :; fi
  BOUND=0
  sleep 1
  if ! printf '%s' "$UDC" > "/sys/bus/platform/drivers/$rp_drv/unbind" 2>/dev/null; then
    log "enumeration recovery: unbind of $UDC from $rp_drv failed"
    return 1
  fi
  sleep 1
  if ! printf '%s' "$UDC" > "/sys/bus/platform/drivers/$rp_drv/bind" 2>/dev/null; then
    log "enumeration recovery: bind of $UDC to $rp_drv failed"
    return 1
  fi
  sleep 2
  if ! printf '%s' "$UDC" > "$G/UDC" 2>/dev/null; then
    log "enumeration recovery: gadget could not be re-bound after the re-probe"
    return 1
  fi
  BOUND=1
  log "enumeration recovery: re-probe done state=$(edited_udc_state)"
  return 0
}
# Called once per second while the first enumeration has not succeeded. Takes a
# no-op action outside its scheduled slots, so it costs one test per iteration.
enum_recovery_step() {
  enum_t="$1"
  case "$enum_t" in
    8)
      [ "$ENUM_SOFT_PULSES" -ge 1 ] && return 0
      ENUM_SOFT_PULSES=1
      pulse_soft_connect || :
      ;;
    16)
      # The strong action goes in early. The log that proved the lighter ones
      # ineffective showed the UDC sitting at "not attached" for 30 seconds with
      # extcon still reporting SDP=1: a pulse and a gadget rebind both changed
      # nothing, so waiting 58s to try the only thing that might work just makes
      # the wait longer.
      [ "$ENUM_REPROBES" -ge 1 ] && return 0
      ENUM_REPROBES=1
      reprobe_udc_driver || :
      ;;
    30)
      [ "$ENUM_REBINDS" -ge 1 ] && return 0
      ENUM_REBINDS=1
      rebind_gadget || :
      ;;
    48)
      [ "$ENUM_REPROBES" -ge 2 ] && return 0
      ENUM_REPROBES=2
      reprobe_udc_driver || :
      ;;
  esac
  return 0
}
rk3566_usb_trigger() {
  soft="/sys/class/udc/$UDC/soft_connect"
  [ -w "$soft" ] || {
    log "RK3566 USB soft_connect unavailable; skipping reconnect workaround"
    return 1
  }

  state="$(cat "/sys/class/udc/$UDC/state" 2>/dev/null || echo unknown)"
  case "$state" in
    configured|suspended)
      log "RK3566 USB host already configured the gadget (state=$state); no reconnect needed"
      return 0
      ;;
    "not attached"|unknown)
      # On this RK3566 port, soft disconnect/reconnect while no UDC attachment
      # is active has repeatedly left EP0 disabled (failed to enable ep0out).
      # Gadget is now bound before cable detection, so let the USB2PHY/UDC
      # attach path handle a fresh cable event instead of forcing soft_connect.
      log "RK3566 USB state=$state; skipping soft reconnect and preserving native PHY attach path"
      return 0
      ;;
    powered)
      # Wait for the host to issue bus reset; disconnecting at this point can
      # race the very first SETUP transaction on this DWC3 controller.
      log "RK3566 USB state=powered; waiting for host reset without soft reconnect"
      return 0
      ;;
  esac

  # Recovery is reserved for a host that has started enumeration (default or
  # addressed) but has not reached CONFIGURED. Do not pulse soft_connect while
  # the device is still physically unattached or before the host reset.
  if ep0_control_ready; then
    log "RK3566 USB retry: ep0out=control but UDC state=$state; forcing one soft disconnect/reconnect"
  else
    log "RK3566 USB retry: UDC state=$state; forcing one soft disconnect/reconnect after host activity"
  fi
  printf '%s' disconnect > "$soft" 2>/dev/null || {
    log "RK3566 USB soft_connect=disconnect failed"
    return 1
  }
  sleep 1
  printf '%s' connect > "$soft" 2>/dev/null || {
    log "RK3566 USB soft_connect=connect failed"
    return 1
  }
  sleep 1
  state="$(cat "/sys/class/udc/$UDC/state" 2>/dev/null || echo unknown)"
  speed="$(cat "/sys/class/udc/$UDC/current_speed" 2>/dev/null || echo unknown)"
  log "RK3566 USB retry completed: UDC state=$state speed=$speed"
  return 0
}
dump_usb_status() {
  # Read-only snapshots: expose role/VBUS/PHY state without changing hardware.
  for p in \
    "/sys/class/udc/$UDC/state" \
    "/sys/class/udc/$UDC/current_speed" \
    "/sys/class/udc/$UDC/maximum_speed" \
    "/sys/class/udc/$UDC/function" \
    "/sys/class/udc/$UDC/is_otg" \
    "/sys/class/udc/$UDC/soft_connect" \
    /sys/class/usb_role/*/role \
    /sys/class/extcon/*/name \
    /sys/class/extcon/*/state \
    /sys/class/typec/*/data_role \
    /sys/class/typec/*/power_role \
    /sys/class/phy/*/type \
    /sys/class/phy/*/power/control \
    /sys/class/phy/*/power/runtime_status \
    "/sys/bus/platform/devices/$UDC/dr_mode" \
    "/sys/bus/platform/devices/$UDC/role" \
    "/sys/bus/platform/devices/$UDC/status" \
    "/sys/bus/platform/devices/$UDC/power/control" \
    "/sys/bus/platform/devices/$UDC/power/runtime_status"; do
    read_usb_attr "$p"
  done
  # Log the exact nested extcon cable entries ROCKNIX uses, not just
  # /sys/class/extcon summaries (which can hide SDP/CDP cable state).
  for phy in /sys/devices/platform/"$UDC"/supplier:platform:*usb2phy; do
    [ -d "$phy" ] || continue
    log "USB PHY supplier path: $phy"
    for cable in "$phy"/extcon/*/cable.*; do
      [ -r "$cable/name" ] && [ -r "$cable/state" ] || continue
      log "USB extcon cable: $cable name=$(cat "$cable/name" 2>/dev/null) state=$(cat "$cable/state" 2>/dev/null)"
    done
  done
  for d in /sys/bus/platform/devices/*phy*; do
    [ -d "$d" ] || continue
    case "$d" in *usb2phy*|*usb-phy*|*phy*) ;; *) continue ;; esac
    driver="$(readlink "$d/driver" 2>/dev/null || echo none)"
    log "USB PHY device: $d driver=$driver"
    for attr in mode otg_mode vbus_det_en vbus_det_en_ctrl power/control power/runtime_status; do
      read_usb_attr "$d/$attr"
    done
  done
}
snapshot() {
  log "===== diagnostic snapshot: $1 ====="
  log "mountpoint=$MOUNTPOINT device=$DEVICE fstype=$FSTYPE udc=$UDC bound=$BOUND"
  if [ -d /sys/class/udc ]; then
    for u in /sys/class/udc/*; do
      [ -e "$u" ] || continue
      log "UDC entry: ${u##*/}"
      [ ! -r "$u/state" ] || log "UDC state: $(cat "$u/state" 2>/dev/null)"
      [ ! -r "$u/current_speed" ] || log "UDC speed: $(cat "$u/current_speed" 2>/dev/null)"
    done
  else
    log "/sys/class/udc is missing"
  fi
  [ ! -e "$G/UDC" ] || log "gadget UDC binding: $(cat "$G/UDC" 2>/dev/null)"
  [ ! -e "$G/functions/mass_storage.0/lun.0/file" ] || log "mass-storage backing file: $(cat "$G/functions/mass_storage.0/lun.0/file" 2>/dev/null)"
  # Record descriptor/configuration values while the gadget is still bound;
  for attr in idVendor idProduct bcdUSB max_speed bDeviceClass bDeviceSubClass bDeviceProtocol bMaxPacketSize0; do
    read_usb_attr "$G/$attr"
  done
  for attr in manufacturer product serialnumber; do
    read_usb_attr "$G/strings/0x409/$attr"
  done
  for attr in MaxPower bmAttributes; do
    read_usb_attr "$G/configs/b.1/$attr"
  done
  read_usb_attr "$G/configs/b.1/strings/0x409/configuration"
  for attr in file ro removable cdrom nofua stall num_buffers inquiry_string; do
    read_usb_attr "$G/functions/mass_storage.0/lun.0/$attr"
  done
  for p in /sys/kernel/debug/usb/"$UDC"/ep0out/transfer_type /sys/kernel/debug/usb/"$UDC"/ep0in/transfer_type /sys/kernel/debug/usb/"$UDC"/ep0out/queued /sys/kernel/debug/usb/"$UDC"/ep0in/queued; do
    read_usb_attr "$p"
  done
  dump_usb_status
  if command -v dmesg >/dev/null 2>&1; then
    # Keep EP0 SETUP records separately: SCSI WRITE diagnostics can evict them
    # from a fixed dmesg tail before the failure snapshot is collected.
    dmesg 2>/dev/null | grep -F 'RG353PS EP0 SETUP' | tail -n 16 | sed 's/RG353PS EP0 SETUP/EP0 SETUP request/g' | while IFS= read -r ep0_setup_line; do
      [ -z "$ep0_setup_line" ] || log "EP0 SETUP history: $ep0_setup_line"
    done
    dmesg 2>/dev/null | grep -Ei 'baseos-msdiag|dwc3|usb|phy|gadget|udc|ep0out|mass.storage|vbus|extcon|role.switch|rockchip-usb2phy|otg' | tail -n 100 >> "$DIAG_LOG" || :
  fi
}
diagnose_usb_state_change() {
  changed_state="$1"
  log "===== immediate USB controller snapshot: post-CONFIGURED state=$changed_state ====="
  log "UDC current state=$(cat "/sys/class/udc/$UDC/state" 2>/dev/null || echo unknown) speed=$(cat "/sys/class/udc/$UDC/current_speed" 2>/dev/null || echo unknown) gadget_binding=$(cat "$G/UDC" 2>/dev/null || echo empty)"
  # State changes can precede a full disconnect by tens of seconds. Capture
  # endpoint queues and controller IRQs now; periodic heartbeat may miss it.
  for ep_dir in /sys/kernel/debug/usb/"$UDC"/ep*; do
    [ -d "$ep_dir" ] || continue
    for attr_path in "$ep_dir"/*; do
      [ -f "$attr_path" ] || continue
      attr_name="$(basename "$attr_path")"
      case "$attr_name" in
        transfer_type|queued|state|enabled|flags|maxpacket|burst|interval|address|direction|resource_index|type|descriptor|streams)
          read_usb_attr "$attr_path"
          ;;
      esac
    done
  done
  irq_snapshot="$(grep -Ei 'dwc3|usb|mmc|sdhci|dw_mmc' /proc/interrupts 2>/dev/null | tr '\n' ';')"
  [ -z "$irq_snapshot" ] || log "controller IRQ counters at UDC state transition: $irq_snapshot"
  if command -v dmesg >/dev/null 2>&1; then
    dmesg 2>/dev/null | grep -Ei 'baseos-msdiag|RG353PS EP0 SETUP|RG353PS ignoring stale|dwc3|usb2phy|VBUS|extcon|BULK OUT mismatch|mass.storage' | tail -n 100 >> "$DIAG_LOG" || :
  fi
}

# Make pulling the cable safe without an eject.
#
# The LUN runs nofua=1, so the host's per-write FUA is ignored and its writes
# land in the page cache; only a flush puts them on the card. The heartbeat sync
# fires on a 10 s timer, which is a long window to leave a finished copy sitting
# in RAM: unplug 3 s after Explorer says "done" and the file is gone.
#
# Flush on write-idle instead of on a clock. The partition's write counter is
# sampled once a second; after it has been constant for two samples, everything
# the host has written is synced. When the host writes again the counter moves
# and the next quiet window triggers the next flush, so a transfer in progress
# keeps flushing as it finishes rather than at an arbitrary tick.
#
# This gives a USB stick's guarantee, not a stronger one: unplug once the copy
# has settled is safe, unplug mid-write is not, because the host still holds
# data that never reached us.
flush_on_idle() {
  flush_last=
  flush_idle=0
  flush_dirty=0
  while :; do
    flush_now="$(awk -v p="$PART_NAME" '$3 == p {print $10; exit}' /proc/diskstats 2>/dev/null)"
    if [ -n "$flush_now" ] && [ "$flush_now" = "$flush_last" ]; then
      flush_idle=$((flush_idle + 1))
    else
      flush_idle=0
      [ -z "$flush_now" ] || flush_dirty=1
    fi
    if [ "$flush_dirty" -eq 1 ] && [ "$flush_idle" -ge 2 ]; then
      sync
      flush_dirty=0
    fi
    flush_last="$flush_now"
    sleep 1
  done
}
cleanup() {
  cleanup_status=$?
  trap - EXIT INT TERM HUP
  log "cleanup entry trigger=$CLEANUP_TRIGGER status=$cleanup_status elapsed_i=$i bound=$BOUND"

  # Stop the write-idle flusher first: it holds no lock, but leaving it running
  # would have it sync during teardown for no reason.
  if [ -n "$FLUSH_PID" ]; then
    kill "$FLUSH_PID" 2>/dev/null || :
    FLUSH_PID=
  fi

  # Preserve the v31 transfer pipeline. Keep teardown simple: the v32 log
  # stopped after UDC unbind, apparently during configfs function unlink.
  # Do not clear the LUN file or unlink/rmdir configfs objects on exit.
  UNBIND_OK=1
  if [ -n "$UDC" ] && [ -e "$G/UDC" ] && [ "$BOUND" -eq 1 ]; then
    unbind_result=/run/baseos-usb-storage-unbind.result
    rm -f "$unbind_result"
    log "cleanup step=unbind begin; bounded asynchronous sysfs write"
    (
      printf '\n' > "$G/UDC" 2>/dev/null
      printf '%s\n' "$?" > "$unbind_result" 2>/dev/null
    ) &
    unbind_pid=$!
    unbind_ticks=0
    while [ "$unbind_ticks" -lt 50 ] && [ ! -f "$unbind_result" ]; do
      sleep 0.1
      unbind_ticks=$((unbind_ticks+1))
    done
    if [ -f "$unbind_result" ]; then
      unbind_rc="$(cat "$unbind_result" 2>/dev/null || echo 1)"
      wait "$unbind_pid" 2>/dev/null || :
      if [ "$unbind_rc" -eq 0 ]; then
        BOUND=0
        log "cleanup step=unbind complete write_rc=$unbind_rc"
      else
        UNBIND_OK=0
        log "ERROR: UDC unbind write returned rc=$unbind_rc"
      fi
    else
      UNBIND_OK=0
      log "WARNING: UDC unbind exceeded 5 seconds; skipping remount to avoid concurrent host access"
      kill -KILL "$unbind_pid" 2>/dev/null || :
    fi
    rm -f "$unbind_result"
  elif [ "$BOUND" -eq 0 ]; then
    log "cleanup step=unbind skipped; helper is not bound"
  else
    UNBIND_OK=0
    log "ERROR: cannot address UDC unbind path"
  fi

  # Stop the on-screen prompt immediately so it cannot keep scrolling while
  # storage cleanup proceeds.
  if [ -n "$PROMPT_PID" ]; then
    log "cleanup step=stop-prompt signal pid=$PROMPT_PID"
    kill "$PROMPT_PID" 2>/dev/null || :
    PROMPT_PID=
  fi

  if [ "$UNBIND_OK" -eq 1 ]; then
    # Restore the local filesystem only after UDC unbind returned successfully.
    log "cleanup step=local-remount begin"
    if [ -n "$MOUNTPOINT" ] && [ -n "$DEVICE" ] && ! is_mounted "$MOUNTPOINT"; then
      mount -t "$FSTYPE" -o rw,noatime "$DEVICE" "$MOUNTPOINT" 2>/dev/null || \
        log "WARNING: could not remount $DEVICE at $MOUNTPOINT"
    fi
    if [ -n "$MOUNTPOINT" ] && is_mounted "$MOUNTPOINT"; then
      log "cleanup step=local-remount complete mountpoint=$MOUNTPOINT"
    else
      log "WARNING: local data partition is not mounted; avoid further writes until recovery"
    fi
  else
    log "WARNING: UDC unbind not confirmed; backing device remains unmounted for safety"
  fi

  # Always release the frontend pause so diagnostics can resume. If unbind
  # failed, retain ACTIVE as a guard against a second concurrent storage session.
  rm -f "$REQUEST" "$PAUSED"
  if [ "$UNBIND_OK" -eq 1 ]; then
    rm -f "$ACTIVE"
  else
    log "WARNING: keeping active marker because UDC unbind was not confirmed"
  fi

  restore_console_loglevel
  log "storage mode ended; unbind_ok=$UNBIND_OK; configfs function retained for next entry"
  if [ "$cleanup_status" -eq 0 ]; then
    /usr/bin/baseos-splash --important 100 "USB STORAGE FINISHED" 2>/dev/null || :
  else
    # Do not erase the failure state with the normal boot logo; hotkeyd keeps
    # the boot-storage gate active so the frontend cannot hide this error.
    /usr/bin/baseos-splash --important -1 "USB STORAGE FAILED" 2>/dev/null || :
  fi
  # Persist logs only after the frontend is released; avoid a blocking sync
  # before returning to diagnostics.
  if [ -d /mnt/boot ] && grep -q ' /mnt/boot ' /proc/mounts 2>/dev/null; then
    cp "$DIAG_LOG" "$BOOT_LOG" 2>/dev/null || :
  fi
}
CLEANUP_TRIGGER=EXIT
trap 'CLEANUP_TRIGGER=INT; exit 130' INT
trap 'CLEANUP_TRIGGER=TERM; exit 143' TERM
trap 'CLEANUP_TRIGGER=HUP; exit 129' HUP
trap cleanup EXIT
set_storage_console_quiet
HELPER_CKSUM="$(cksum "$0" 2>/dev/null | awk '{print $1 ":" $2}')"
log "helper_revision=usb-high-speed-dwc3-v34-simple-exit-cleanup cksum=$HELPER_CKSUM"
# Prefer the removable frontend card (usually the left TF slot). If absent,
# export only the dedicated BASEOS_DATA partition, never the boot/root system.
if is_mounted /mnt/TF2; then
  MOUNTPOINT=/mnt/TF2
else
  MOUNTPOINT=/mnt/SDCARD
fi
if [ "$BOOT_MODE" -eq 1 ]; then
  i=0
  while ! is_mounted "$MOUNTPOINT" && [ "$i" -lt 120 ]; do sleep 1; i=$((i+1)); done
fi
if ! is_mounted "$MOUNTPOINT"; then log "$MOUNTPOINT is not mounted; refusing storage mode"; exit 1; fi
DEVICE=$(awk -v m="$MOUNTPOINT" '$2 == m { print $1; exit }' /proc/mounts)
FSTYPE=$(awk -v m="$MOUNTPOINT" '$2 == m { print $3; exit }' /proc/mounts)
case "$DEVICE" in /dev/mmcblk*p[0-9]*) ;; *) log "unsupported block source '$DEVICE'; refusing"; exit 1 ;; esac
case "$FSTYPE" in vfat|exfat) ;; *) log "filesystem '$FSTYPE' is not supported for PC storage mode"; exit 1 ;; esac
# Which partition number carries BASEOS_DATA is a property of the layout, not
# a constant: it was p3 before BASEOS_UBOOT took slot 1 and became p4 with the
# A/B layout. Match the GPT name so a future layout move cannot silently turn
# storage mode into an "USB STORAGE FAILED" pill again.
PART_NAME=${DEVICE#/dev/}
DEV_PARTNAME=$(sed -n 's/^PARTNAME=//p' "/sys/class/block/$PART_NAME/uevent" 2>/dev/null | head -1)
case "$MOUNTPOINT:$DEVICE" in
  /mnt/SDCARD:/dev/mmcblk*p[0-9]*)
    case "$DEV_PARTNAME" in
      BASEOS_DATA) ;;
      "") log "WARNING: $DEVICE has no PARTNAME; assuming BASEOS_DATA by mount point" ;;
      *) log "refusing to export $DEVICE (PARTNAME=$DEV_PARTNAME); only BASEOS_DATA may be shared"; exit 1 ;;
    esac
    ;;
  /mnt/TF2:/dev/mmcblk*p[0-9]*) ;;
  *) log "refusing unexpected mount source $DEVICE at $MOUNTPOINT"; exit 1 ;;
esac
log "requested storage for $DEVICE mounted at $MOUNTPOINT"
if [ "$BOOT_MODE" -eq 0 ]; then
  printf '%s\n' "$MOUNTPOINT" > "$REQUEST"
  i=0
  while [ ! -e "$PAUSED" ] && [ "$i" -lt 150 ]; do sleep 0.1; i=$((i+1)); done
  if [ ! -e "$PAUSED" ]; then log "frontend did not pause; refusing to export a mounted filesystem"; exit 1; fi
else
  :
fi
# Diagnostic UI may re-enable the virtual-terminal cursor after rcS hid it.
# Hide it again on the active VT and tty1 before drawing the storage prompt.
for console in /dev/tty0 /dev/tty1; do
  printf '\033[?25l' > "$console" 2>/dev/null || :
done
# Do not call "fbsplash 0" here: it paints BaseOS's built-in full-screen art
# over the bootloader logo, breaking NextUI's custom boot-logo selection.
# The status pill preserves the underlying U-Boot/NextUI logo.
 /usr/bin/baseos-splash --important -1 "STARTING USB STORAGE" 2>/dev/null || :
sync
# Leaving the shell's cwd on the volume being exported guarantees EBUSY. That
# is not hypothetical: when storage mode is requested from the diagnostic UI,
# this helper is forked from rg353ps-control-center, which the frontend
# supervisor starts after "cd $FRONTEND_ROOT" -- an adapter directory that can
# itself live on BASEOS_DATA. The fork inherits that cwd, umount fails
# instantly, and the whole screen flashes "USB STORAGE FAILED" before anything
# else happens. Change directory first, then retry once to let any transient
# reference (a just-signalled UI, an open directory handle) drain.
cd / 2>/dev/null || :
report_mount_users() {
  for ru_proc in /proc/[0-9]*; do
    ru_pid=${ru_proc#/proc/}
    [ "$ru_pid" = "$$" ] && continue
    for ru_link in cwd root exe; do
      ru_target="$(readlink "$ru_proc/$ru_link" 2>/dev/null)" || continue
      case "$ru_target" in
        "$1"|"$1"/*) log "volume still referenced: pid=$ru_pid $ru_link=$ru_target" ;;
      esac
    done
  done
}
umount_msg=
if ! umount_msg="$(umount "$MOUNTPOINT" 2>&1)"; then
  log "first unmount of $MOUNTPOINT failed (${umount_msg:-no message}); retrying after a grace period"
  report_mount_users "$MOUNTPOINT"
  sleep 1
  if ! umount_msg="$(umount "$MOUNTPOINT" 2>&1)"; then
    log "could not unmount $MOUNTPOINT (${umount_msg:-no message}); refusing to export"
    /usr/bin/baseos-splash --important -1 "USB STORAGE: PARTITION BUSY" 2>/dev/null || :
    sleep 2
    exit 1
  fi
fi
log "unmounted $MOUNTPOINT; preparing USB mass storage"
# Nothing is connected yet: the gadget is still being assembled and the UDC is
# not bound for another second or two. Saying "CONNECTING" here made the screen
# read CONNECTING then WAITING, which looks like the device tried to connect and
# gave up. Reserve that word for the post-detection phase at the enumeration
# step and keep this one strictly about local preparation.
/usr/bin/baseos-splash --important 45 "PREPARING USB STORAGE" 2>/dev/null || :

grep -q " $CONFIGFS " /proc/mounts 2>/dev/null || mount -t configfs none "$CONFIGFS" 2>/dev/null || {
  log "configfs mount failed"; exit 1;
}
log "available UDCs: $(ls /sys/class/udc 2>/dev/null | tr '\n' ' ')"
UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
[ -n "$UDC" ] || { log "no USB device controller found"; exit 1; }
# Hold the controller and its PHY out of runtime power management.
#
# Storage mode entered right after boot has never failed; the same request made
# minutes later from the diagnostic UI sometimes leaves the host silent. The
# difference that is visible in the logs is which devices the kernel was free to
# autosuspend by then: a USB2PHY parked in runtime suspend can miss the VBUS
# edge entirely, so the controller never gets a session to enumerate from.
# Where autosuspend is not actually in use this changes nothing; where it is,
# it removes the one power state we cannot recover from in user space.
disable_usb_runtime_pm
if [ ! -d "$G" ]; then
  mkdir -p "$G" || { log "cannot create gadget"; exit 1; }
  CREATED_GADGET=1
fi
if [ -e "$G/UDC" ]; then OLD_UDC=$(cat "$G/UDC" 2>/dev/null || :); fi
if [ -L "$G/configs/b.1/f-ffs.adb" ]; then HAD_ADB=1; fi
[ -e "$G/UDC" ] && printf '\n' > "$G/UDC" 2>/dev/null || :
rm -f "$G/configs/b.1/f-ffs.adb" 2>/dev/null || :
mkdir -p "$G/strings/0x409" "$G/configs/b.1/strings/0x409" "$G/functions/mass_storage.0" || {
  log "cannot create mass-storage function"; exit 1;
}
printf '0x2207' > "$G/idVendor" 2>/dev/null || :
printf '0x0006' > "$G/idProduct" 2>/dev/null || :
printf '0x0200' > "$G/bcdUSB" 2>/dev/null || :
# v31 diagnostic build: restore the v30 legacy PHY quirks and keep the v29 FSG pipeline.
# Adds per-request queue/completion lifecycle timestamps; does not change allocation/reuse behavior.
# Set speed before UDC binding and fail closed if the requested mode is not set.
if [ ! -w "$G/max_speed" ] || ! printf 'high-speed' > "$G/max_speed" 2>/dev/null; then
  log "ERROR: could not set diagnostic storage gadget to high-speed; aborting test"
  exit 1
fi
GADGET_MAX_SPEED=$(cat "$G/max_speed" 2>/dev/null || echo unknown)
if [ "$GADGET_MAX_SPEED" != "high-speed" ]; then
  log "ERROR: high-speed setting readback failed (max_speed=$GADGET_MAX_SPEED); aborting test"
  exit 1
fi
log "diagnostic v34 simple-exit-cleanup (v31 transfer pipeline retained): gadget max_speed=$GADGET_MAX_SPEED; legacy v18/v19 DWC3 PHY quirks; upstream FSG WRITE chunk sizing/request pipeline; no per-request DWC3 ENDTRANSFER/restart; standard TRB flags; request allocation/reuse behavior unchanged; nofua=1 unchanged"
printf 'BaseOS' > "$G/strings/0x409/manufacturer" 2>/dev/null || :
printf 'RG353PS USB Storage' > "$G/strings/0x409/product" 2>/dev/null || :
printf 'storage' > "$G/configs/b.1/strings/0x409/configuration" 2>/dev/null || :
printf '500' > "$G/configs/b.1/MaxPower" 2>/dev/null || :
LUN="$G/functions/mass_storage.0/lun.0"
printf '1' > "$LUN/removable" 2>/dev/null || :
printf '0' > "$LUN/ro" 2>/dev/null || :

# Windows normally sends SCSI WRITE commands with FUA for removable media,
# making each write synchronous and preventing block-layer request merging.
# The Linux MSG documentation explicitly warns that this can dramatically
# reduce performance. Ignore per-write FUA for this SD-card-backed LUN; normal
# SYNCHRONIZE CACHE requests are still handled by the gadget.
#
# The cost of that choice is that the host's writes can sit in the page cache,
# which used to mean "eject first or lose them". flush_on_idle covers it: the
# partition is flushed two seconds after its write counter stops moving, so a
# copy is on the card by the time the progress dialog closes. Pulling the cable
# mid-write is still losing data, and no device can do better.
if [ -w "$LUN/nofua" ] && printf '1' > "$LUN/nofua" 2>/dev/null; then
  log "mass-storage nofua=1; per-write FUA disabled to avoid synchronous SD-card writes"
else
  log "WARNING: could not enable mass-storage nofua; writes may be very slow with Windows removal-optimized policy"
fi

printf '%s' "$DEVICE" > "$LUN/file" || {
  log "could not assign $DEVICE to mass-storage gadget"; exit 1;
}
if [ -L "$G/configs/b.1/f-mass_storage.0" ]; then
  existing_target="$(readlink "$G/configs/b.1/f-mass_storage.0" 2>/dev/null || :)"
  if [ "$existing_target" = "$G/functions/mass_storage.0" ]; then
    log "reusing existing mass-storage configfs link"
  else
    rm -f "$G/configs/b.1/f-mass_storage.0" 2>/dev/null || :
    ln -s "$G/functions/mass_storage.0" "$G/configs/b.1/f-mass_storage.0" || {
      log "could not link mass-storage function"; exit 1;
    }
  fi
else
  ln -s "$G/functions/mass_storage.0" "$G/configs/b.1/f-mass_storage.0" || {
    log "could not link mass-storage function"; exit 1;
  }
fi
# Bind the gadget before the PC cable arrives. The RG353PS USB2PHY/DWC3
# path has failed EP0 initialization when the UDC is bound immediately after a
# new SDP/VBUS notification. Keep the enumeration timeout disarmed until cable
# detection below, so plugging in after entering storage mode still works.
log "storage mode ready; binding gadget before waiting for DC data cable"
snapshot "immediately-before-bind"
if ! printf '%s' "$UDC" > "$G/UDC"; then log "could not bind USB controller $UDC"; exit 1; fi
BOUND=1
# Start flushing on write-idle as soon as the host can write anything.
flush_on_idle &
FLUSH_PID=$!
log "write-idle flusher started pid=$FLUSH_PID; direct unplug needs no eject once a copy settles"
grep -q " /sys/kernel/debug " /proc/mounts 2>/dev/null ||
  mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || :
# Tell the operator to plug in only after the controller has settled.
#
# The prompt used to be painted *before* the UDC bind, so a cable inserted the
# moment it appeared landed in the same instant as the attach: that is precisely
# the race the comment above describes, and it left EP0 disabled with the PHY
# reporting no cable — storage mode then hung on this prompt until the 1-hour
# timeout, and unplugging did nothing. Binding first and pausing three seconds
# before inviting the cable makes "plug in when the prompt appears" the safe
# case instead of the broken one.
sleep 3
snapshot "three-seconds-after-bind"
SESSION_WRITE_SECTORS="$(awk -v p="$PART_NAME" '$3 == p {print $10; exit}' /proc/diskstats 2>/dev/null)"
log "USB gadget bound for $DEVICE; waiting for PC data cable"
/usr/bin/baseos-splash --important -1 "WAITING FOR DATA CABLE" 2>/dev/null || :

# Wait for the data cable without starting the 45-second enumeration timer.
# With the UDC already bound, a new PHY VBUS/extcon event can start native
# DWC3 attachment and EP0 setup instead of racing a late UDC bind. The cap is
# three minutes rather than an hour: an hour of a frozen prompt is
# indistinguishable from a hung device, and nothing is exported yet, so
# returning to the frontend early costs nothing.
i=0
while ! cable_present && [ "$i" -lt 180 ]; do
  if [ "$i" -eq 0 ]; then
    log "waiting for data cable; initial post-bind USB/PHY snapshot follows"
    dump_usb_status
  elif [ $((i % 60)) -eq 0 ]; then
    log "still waiting for data cable elapsed=${i}s"
  fi
  sleep 1
  i=$((i+1))
done
if ! cable_present; then
  log "data cable was not detected within 180 seconds; restoring local mount"
  /usr/bin/baseos-splash --important -1 "NO DATA CABLE - RETURNING" 2>/dev/null || :
  sleep 2
  exit 1
fi
if ! is_data_cable_connected; then
  log "extcon reports no cable but UDC state=$(cat "/sys/class/udc/$UDC/state" 2>/dev/null || echo unknown); treating the controller attach as a connected host"
  log_cable_probe_inputs "udc-attached-extcon-silent"
fi
log "data cable detected after ${i}s; checking UDC before enumeration timeout"
/usr/bin/baseos-splash --important 45 "CONNECTING USB STORAGE" 2>/dev/null || :
rk3566_usb_trigger || :
snapshot "after-data-cable-detection"
log "PC data cable present for $DEVICE; now waiting for USB enumeration"

# After the data cable is detected and the gadget is bound, allow 45 seconds
# for Windows to finish enumeration before restoring the local mount on failure.
seen=0
detached=0
LAST_RESET_STATE=
i=0
while [ "$i" -lt 3600 ]; do
  case "$i" in
    10|30)
      log "periodic USB role/PHY sample at ${i}s after gadget bind"
      dump_usb_status
      ;;
  esac
  # Durable heartbeat with block I/O counters and only new-session kernel events.
  if [ "$i" -gt 0 ] && [ $((i % 10)) -eq 0 ]; then
    hb_state="$(cat "/sys/class/udc/$UDC/state" 2>/dev/null || echo unknown)"
    hb_speed="$(cat "/sys/class/udc/$UDC/current_speed" 2>/dev/null || echo unknown)"
    hb_cable=no
    if is_data_cable_connected; then
      hb_cable=yes
    else
      log_cable_probe_inputs "heartbeat-${i}s"
    fi
    log "transfer heartbeat elapsed=$i seconds udc_state=$hb_state speed=$hb_speed data_cable=$hb_cable"
    hb_disk="$(grep -E ' mmcblk0(p[0-9]+)? ' /proc/diskstats 2>/dev/null | tr '\n' ';')"
    hb_write_sectors="$(awk -v p="$PART_NAME" '$3 == p {print $10; exit}' /proc/diskstats 2>/dev/null)"
    hb_write_delta=unknown
    case "$SESSION_WRITE_SECTORS:$hb_write_sectors" in
      *[!0-9:]*|:*|*:) ;;
      *) hb_write_delta=$((hb_write_sectors - SESSION_WRITE_SECTORS)) ;;
    esac
    [ -z "$hb_disk" ] || log "diskstats $hb_disk session_write_sectors_delta=$hb_write_delta"
    hb_uptime="$(awk '{print $1}' /proc/uptime 2>/dev/null)"
    # Preserve new SCSI entries by their monotonically increasing command
    # sequence number. A fixed dmesg tail can miss the WRITE that stalled if
    # PHY polling produces enough lines afterward.
    # Track START and FINISH independently. A finish record uses the same
    # sequence as its start, so one shared "seq > last" cursor would discard it.
    hb_scsi_batch="$(dmesg 2>/dev/null | grep -F 'baseos-msdiag:' | awk \
      -v last_start="$LAST_SCSI_START_SEQ" \
      -v last_finish="$LAST_SCSI_FINISH_SEQ" '
      /baseos-msdiag: SCSI start seq=/ {
        if (match($0, /SCSI start seq=[0-9]+/)) {
          item = substr($0, RSTART, RLENGTH)
          sub(/^SCSI start seq=/, "", item)
          seq = item + 0
          if (seq > max_start) max_start = seq
          if (seq > last_start) print $0
        }
        next
      }
      /baseos-msdiag: SCSI finish / {
        if (match($0, /SCSI finish .*seq=[0-9]+/)) {
          item = substr($0, RSTART, RLENGTH)
          sub(/^.*seq=/, "", item)
          seq = item + 0
          if (seq > max_finish) max_finish = seq
          if (seq > last_finish) print $0
        }
        next
      }
      END {
        print "__BASEOS_MAX_START_SEQ=" (max_start + 0)
        print "__BASEOS_MAX_FINISH_SEQ=" (max_finish + 0)
      }
    ')"
    hb_scsi_max_start="$(printf '%s\n' "$hb_scsi_batch" | sed -n 's/^__BASEOS_MAX_START_SEQ=//p' | tail -n 1)"
    hb_scsi_max_finish="$(printf '%s\n' "$hb_scsi_batch" | sed -n 's/^__BASEOS_MAX_FINISH_SEQ=//p' | tail -n 1)"
    hb_scsi_new="$(printf '%s\n' "$hb_scsi_batch" | grep -v '^__BASEOS_MAX_.*_SEQ=' || :)"
    if [ -n "$hb_scsi_new" ]; then
      printf '%s\n' "$hb_scsi_new" | while IFS= read -r hb_scsi_line; do
        [ -z "$hb_scsi_line" ] || log "SCSI command diagnostic: $hb_scsi_line"
      done
    fi
    # Preserve the recent EP0 SETUP sequence at each heartbeat, but only emit
    # it again if that sequence changed since the previous heartbeat.
    hb_ep0_setups="$(dmesg 2>/dev/null | grep -F 'RG353PS EP0 SETUP' | tail -n 12)"
    if [ -n "$hb_ep0_setups" ] && [ "$hb_ep0_setups" != "$LAST_EP0_SETUPS" ]; then
      printf '%s\n' "$hb_ep0_setups" | sed 's/RG353PS EP0 SETUP/EP0 SETUP request/g' | while IFS= read -r hb_ep0_setup_line; do
        [ -z "$hb_ep0_setup_line" ] || log "recent EP0 SETUP: $hb_ep0_setup_line"
      done
      LAST_EP0_SETUPS="$hb_ep0_setups"
    fi
    case "$hb_scsi_max_start" in
      ''|*[!0-9]*) ;;
      *) [ "$hb_scsi_max_start" -le "$LAST_SCSI_START_SEQ" ] || LAST_SCSI_START_SEQ="$hb_scsi_max_start" ;;
    esac
    case "$hb_scsi_max_finish" in
      ''|*[!0-9]*) ;;
      *) [ "$hb_scsi_max_finish" -le "$LAST_SCSI_FINISH_SEQ" ] || LAST_SCSI_FINISH_SEQ="$hb_scsi_max_finish" ;;
    esac

    # Detect a stuck host-to-device WRITE, not an idle storage session. A
    # pending SCSI WRITE with no backing-partition sector progress is the useful trigger.
    hb_pending_scsi="$(dmesg 2>/dev/null | awk -v now="$hb_uptime" -v session_start="$KERNEL_ERR_START_SEC" '
      # The helper mirrors these records into /dev/kmsg, creating nested
      # duplicate SCSI lines. Exclude wrappers so age/oldest use kernel timestamps.
      /baseos-usb-storage:/ { next }
      /baseos-msdiag: SCSI start seq=/ {
        if (!match($0, /SCSI start seq=[0-9]+/)) next
        seq = substr($0, RSTART, RLENGTH)
        sub(/^SCSI start seq=/, "", seq)
        if (!match($0, /^\[[[:space:]]*[0-9.]+/)) next
        started = substr($0, RSTART, RLENGTH)
        sub(/^\[[[:space:]]*/, "", started)
        sub(/\]$/, "", started)
        if ((started + 0) < (session_start + 0)) next
        starts[seq] = $0
        times[seq] = started + 0
        next
      }
      /baseos-msdiag: SCSI finish / {
        if (match($0, /SCSI finish .*seq=[0-9]+/)) {
          seq = substr($0, RSTART, RLENGTH)
          sub(/^.*seq=/, "", seq)
          finished[seq] = 1
        }
        next
      }
      END {
        count = 0
        oldest_age = 0
        oldest = ""
        for (seq in starts) {
          if (seq in finished) continue
          age = now - times[seq]
          if (age < 20) continue
          count++
          if (age > oldest_age) {
            oldest_age = age
            oldest = starts[seq]
          }
        }
        if (count)
          printf "pending_scsi_count=%d oldest_scsi_age=%.1fs oldest_scsi_start=%s", count, oldest_age, oldest
      }
    ')"

    # Track actual FSG Bulk-OUT request generations separately from SCSI commands.
    # Each request pointer is reused over time; the queue generation disambiguates lifetimes.
    hb_pending_fsg="$(dmesg 2>/dev/null | awk -v now="$hb_uptime" -v session_start="$KERNEL_ERR_START_SEC" '
      function field(line, name,    re, value) {
        re = name "=[^ ]+"
        if (match(line, re)) {
          value = substr(line, RSTART, RLENGTH)
          sub(name "=", "", value)
          return value
        }
        return "?"
      }
      function uptime(line,    value) {
        if (!match(line, /^\[[[:space:]]*[0-9.]+/)) return -1
        value = substr(line, RSTART, RLENGTH)
        sub(/^\[[[:space:]]*/, "", value)
        sub(/\]$/, "", value)
        return value + 0
      }
      /baseos-usb-storage:/ { next }
      /baseos-msdiag: FSG OUT lifecycle queue v31/ {
        started = uptime($0)
        if (started < (session_start + 0)) next
        req = field($0, "req")
        gen = field($0, "gen")
        path = field($0, "path")
        if (req == "?" || gen == "?" || (path != "1" && path != "2")) next
        key = req "|" gen
        starts[key] = started
        records[key] = "req=" req " gen=" gen " path=" path \
          " seq=" field($0, "seq") " tag=" field($0, "tag") \
          " op=" field($0, "op") " lba=" field($0, "lba") \
          " len=" field($0, "req_len") " intended=" field($0, "intended")
        next
      }
      /baseos-msdiag: FSG OUT lifecycle callback v31/ {
        req = field($0, "req")
        gen = field($0, "gen")
        if (req != "?" && gen != "?") completed[req "|" gen] = 1
        next
      }
      /baseos-msdiag: FSG OUT lifecycle queue-fail v31/ {
        req = field($0, "req")
        gen = field($0, "gen")
        if (req != "?" && gen != "?") completed[req "|" gen] = 1
        next
      }
      END {
        count = 0
        oldest_age = -1
        oldest = ""
        for (key in starts) {
          if (key in completed) continue
          age = now - starts[key]
          if (age < 0) continue
          count++
          if (age > oldest_age) {
            oldest_age = age
            oldest = records[key]
          }
        }
        if (count)
          printf "pending_fsg_out_count=%d oldest_fsg_out_age=%.1fs oldest_fsg_out=%s", \
            count, oldest_age, oldest
        else
          printf "pending_fsg_out_count=0"
      }
    ')"

    if [ "$hb_state" = "configured" ] && [ "$hb_cable" = "yes" ] &&
       [ -n "$hb_write_sectors" ] && [ -n "$hb_pending_scsi" ]; then
      if [ -n "$LAST_WRITE_SECTORS" ] && [ "$hb_write_sectors" = "$LAST_WRITE_SECTORS" ]; then
        NO_WRITE_PROGRESS_SECONDS=$((NO_WRITE_PROGRESS_SECONDS + 10))
      else
        NO_WRITE_PROGRESS_SECONDS=0
        LAST_STALL_DIAG_SECONDS=0
      fi
    else
      NO_WRITE_PROGRESS_SECONDS=0
      LAST_STALL_DIAG_SECONDS=0
    fi
    [ -z "$hb_write_sectors" ] || LAST_WRITE_SECTORS="$hb_write_sectors"

    if [ "$NO_WRITE_PROGRESS_SECONDS" -ge 30 ] &&
       [ $((NO_WRITE_PROGRESS_SECONDS - LAST_STALL_DIAG_SECONDS)) -ge 30 ]; then
      log "WRITE stall watchdog: no backing-partition sector progress for $NO_WRITE_PROGRESS_SECONDS s; sectors_written=$hb_write_sectors; $hb_pending_scsi; $hb_pending_fsg"
      # Endpoint state is normally quiet during the failure, so sample every
      # exposed DWC3 debugfs endpoint attribute at the stall rather than only
      # recording EP0. Missing attributes are harmless on kernel variants.
      for ep_dir in /sys/kernel/debug/usb/"$UDC"/ep*; do
        [ -d "$ep_dir" ] || continue
        for attr_path in "$ep_dir"/*; do
          [ -f "$attr_path" ] || continue
          attr_name="$(basename "$attr_path")"
          case "$attr_name" in
            transfer_type|queued|state|enabled|flags|maxpacket|burst|interval|address|direction|resource_index|type|descriptor|streams)
              read_usb_attr "$attr_path"
              ;;
          esac
        done
      done
      hb_irqs="$(grep -Ei 'dwc3|usb|mmc|sdhci|dw_mmc' /proc/interrupts 2>/dev/null | tr '\n' ';')"
      [ -z "$hb_irqs" ] || log "controller IRQ counters during WRITE stall: $hb_irqs"
      hb_stall_events="$(dmesg 2>/dev/null | grep -Ei 'baseos-msdiag|BULK OUT mismatch|RG353PS DWC3 bulk-out event|dwc3.*(error|timeout|failed|reset|stall|xfernotready)|mmc.*(error|timeout|reset)|I/O error' | tail -n 30 | tr '\n' ';')"
      [ -z "$hb_stall_events" ] || log "recent kernel/USB events during WRITE stall: $hb_stall_events"
      LAST_STALL_DIAG_SECONDS="$NO_WRITE_PROGRESS_SECONDS"
    fi
    hb_errors="$(dmesg 2>/dev/null | awk -v start="$KERNEL_ERR_START_SEC" '{ if (match($0, /^\[[[:space:]]*[0-9.]+/)) { t=substr($0, RSTART, RLENGTH); sub(/^\[[[:space:]]*/, "", t); if ((t+0) >= (start+0)) print } }' | grep -Ei 'mmc.*(error|timeout|reset)|I/O error|Buffer I/O|dwc3.*(error|timeout|unexpected|failed|end transfer)|ep0.*(error|failed)|usb.*(error|reset)' | grep -v 'baseos-usb-storage:' | tail -n 5 | tr '\n' ';')"
    if [ -n "$hb_errors" ] && [ "$hb_errors" != "$LAST_KERNEL_ERRORS" ]; then
      log "kernel events since storage start: $hb_errors"
      LAST_KERNEL_ERRORS="$hb_errors"
    fi
    sync
  fi
  state=$(cat "/sys/class/udc/$UDC/state" 2>/dev/null || printf 'not attached')
  # A Windows "Unknown USB device / Device Descriptor Request Failed" can
  # leave the UDC in powered/default/addressed forever. Count success only
  # after the host reaches CONFIGURED, and always restore the local mount
  # after 45 seconds if that never happens.
  case "$state" in
    configured)
      if [ "$seen" -eq 0 ]; then
        log "UDC reached successful enumeration state=configured after ${i}s"
        /usr/bin/baseos-splash --important -1 "USB STORAGE: SAFE TO UNPLUG" 2>/dev/null || :
      fi
      seen=1
      detached=0
      LAST_RESET_STATE=
      RESET_NOT_CONFIGURED_SECONDS=0
      ;;
    suspended)
      # A suspend state is only valid evidence of a previously enumerated USB
      # device if CONFIGURED was observed earlier in this session. On this
      # RK3566 port, an attached DC cable can leave UDC suspended/addressed
      # even when Windows fails the descriptor request. Do not let that state
      # suppress the 45-second enumeration-failure timeout.
      if [ "$seen" -eq 1 ]; then
        if is_data_cable_connected; then
          detached=0
          LAST_RESET_STATE=
          RESET_NOT_CONFIGURED_SECONDS=0
        else
          RESET_NOT_CONFIGURED_SECONDS=0
          [ "$detached" -ne 0 ] || log_cable_probe_inputs "udc-state-$state"
          detached=$((detached+1))
        fi
      elif [ "$i" -eq 1 ]; then
        log "UDC suspended before configured; keeping enumeration-failure timeout armed"
      elif [ "$i" -ge 70 ]; then
        log "UDC stayed suspended and never reached configured within ${i}s despite a pulse, two re-probes and a rebind; aborting storage mode and restoring local mount"
        break
      else
        enum_recovery_step "$i"
      fi
      ;;
    *)
      if [ "$seen" -eq 1 ]; then
        # UDC state=default may mean the host reset the USB bus, not that the
        # cable was unplugged. Never dismantle the gadget while SDP/CDP is
        # still asserted; allow Windows to enumerate the device again.
        if is_data_cable_connected; then
          if [ "$LAST_RESET_STATE" != "$state" ]; then
            log "UDC left configured (state=$state) but USB data cable remains detected; preserving gadget for re-enumeration"
            diagnose_usb_state_change "$state"
            LAST_RESET_STATE="$state"
          fi
          detached=0
          RESET_NOT_CONFIGURED_SECONDS=$((RESET_NOT_CONFIGURED_SECONDS+1))
          # If a bus reset leaves the DWC3 UDC stuck outside CONFIGURED for
          # 15 seconds while the PHY still reports a PC data connection, do
          # one guarded gadget unbind/rebind. soft_connect alone was tested
          # and left this controller stuck at "not attached" for the rest of
          # the session, so reset the gadget binding instead.
          if [ "$RESET_NOT_CONFIGURED_SECONDS" -ge 15 ] && [ "$RESET_RECOVERY_ATTEMPTED" -eq 0 ]; then
            RESET_RECOVERY_ATTEMPTED=1
            log "UDC has remained state=$state for ${RESET_NOT_CONFIGURED_SECONDS}s with SDP/CDP still present; attempting one gadget UDC unbind/rebind"
            recovery_unbind_error=
            if [ -e "$G/UDC" ] && recovery_unbind_error="$(printf '\n' 2>&1 > "$G/UDC")"; then
              BOUND=0
              sleep 1
              unbind_binding="$(cat "$G/UDC" 2>/dev/null || echo unreadable)"
              log "UDC unbind requested; binding_after_unbind=${unbind_binding:-empty}"
              recovery_bind_error=
              if recovery_bind_error="$(printf '%s' "$UDC" 2>&1 > "$G/UDC")"; then
                BOUND=1
                sleep 3
                recovery_state="$(cat "/sys/class/udc/$UDC/state" 2>/dev/null || echo unknown)"
                recovery_speed="$(cat "/sys/class/udc/$UDC/current_speed" 2>/dev/null || echo unknown)"
                recovery_binding="$(cat "$G/UDC" 2>/dev/null || echo empty)"
                log "UDC rebind result state=$recovery_state speed=$recovery_speed gadget_binding=$recovery_binding"
              else
                recovery_binding="$(cat "$G/UDC" 2>/dev/null || echo unreadable)"
                recovery_state="$(cat "/sys/class/udc/$UDC/state" 2>/dev/null || echo unknown)"
                log "UDC rebind failed: error=${recovery_bind_error:-no stderr} state=$recovery_state gadget_binding=${recovery_binding:-empty}; local data partition stays unmounted for safety"
              fi
            else
              log "UDC unbind failed: error=${recovery_unbind_error:-no stderr}; skipped recovery rebind"
            fi
            RESET_NOT_CONFIGURED_SECONDS=0
          fi
        else
          RESET_NOT_CONFIGURED_SECONDS=0
          [ "$detached" -ne 0 ] || log_cable_probe_inputs "udc-state-$state"
          detached=$((detached+1))
        fi
      elif [ "$i" -ge 70 ]; then
        log "UDC never reached configured within ${i}s despite a pulse, two re-probes and a rebind (last state=$state); aborting storage mode and restoring local mount"
        break
      else
        enum_recovery_step "$i"
      fi
      ;;
  esac
  # After a successful enumeration, return only after three samples with no
  # PHY/extcon data-cable indication. A transient UDC reset alone is not unplug.
  # Flush before teardown: a cable pulled without an eject is the expected path
  # now, and this is the last chance to commit anything the host wrote.
  [ "$detached" -lt 3 ] || { log "USB cable no longer detected for three samples; restoring local mount"; sync; break; }
  sleep 1
  i=$((i+1))
done
if [ "$seen" -eq 0 ]; then
  log "ERROR: USB host never reached UDC state=configured; storage was not successfully established"
  /usr/bin/baseos-splash --important -1 "USB ENUMERATION FAILED" 2>/dev/null || :
  exit 1
fi
if [ "$i" -ge 3600 ]; then log "storage mode timed out after one hour; restoring local mount"; fi
exit 0
