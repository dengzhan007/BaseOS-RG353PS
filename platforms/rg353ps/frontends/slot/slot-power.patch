+++ b/crates/slot/src/app.rs
@@ -5595,6 +5595,15 @@ impl App {
         if let Some(power) = &mut self.power {
             power.on_close();
         }
+        /* A port whose kernel can suspend on demand gets a real sleep here
+           instead of a dark panel over a CPU that is still running. The launch
+           script sets BASEOS_SLEEP to that port's suspend helper; without the
+           variable this is exactly the doze it always was. The call blocks
+           until the button wakes the unit, which is why it comes after the
+           state above has been flushed. */
+        if let Some(program) = std::env::var_os("BASEOS_SLEEP") {
+            let _ = std::process::Command::new(program).status();
+        }
     }
 
     fn wake(&mut self) {
