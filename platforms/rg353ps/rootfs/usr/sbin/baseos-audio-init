#!/bin/sh
# Bring the RG353PS codec up before any frontend starts.
#
# The board's only output is a simple-audio-card named rk817_ext: the RK817
# codec drives HPOL/HPOR, and the internal speakers hang off a separate
# simple-amplifier ("Speaker Amp") gated by GPIO4_C2. A stock Alpine rootfs
# never touches either, so the amplifier stays off and the DAC sits at its reset
# level - a frontend that opens ALSA but never talks to the mixer (Slot does
# exactly that) comes up silent. NextUI hides the same gap because its audiomon
# daemon sets the controls itself.
#
# Why the volume lives in a softvol layer
# ---------------------------------------
# RK817 exposes its DAC gain as a raw 0..255 register that maps linearly onto
# -95.5 dB..0 dB. ALSA's "%" on that control is a percentage of the *register*,
# not of the useful range, so 50% is -47 dB and 20% is -76 dB: both are silence
# on this speaker. Anything that moves the hardware control (the volume keys,
# a restored asound.state, a codec re-probe after resume) therefore produces a
# volume curve that is wildly non-linear and different from boot to boot.
#
# So the hardware gain is pinned at 0 dB on every run and the user-facing volume
# is the "BaseOS Master" softvol control: 0..100 mapped onto -48 dB..0 dB. That
# is one predictable curve for every frontend, and the same control the volume
# keys move.
#
# Runs on every boot and again after resume; every step is best effort and
# nothing here can block the boot.

LOG=/run/baseos-audio.log
STATE=/var/lib/alsa/asound.state
SOFTVOL_CTL='BaseOS Master'
# 0% maps here. -48 dB is inaudible on this speaker while still leaving the
# whole 0..100 range useful instead of squeezing it into the top 5%.
SOFTVOL_MIN_DB=-48.0
MAX_WAIT=15

say() { printf '%s %s\n' "$(date '+%H:%M:%S' 2>/dev/null)" "$*" >>"$LOG" 2>/dev/null || :; }

find_card() {
    i=0
    while [ "$i" -lt 8 ]; do
        id=$(cat "/sys/class/sound/card$i/id" 2>/dev/null || :)
        case "$id" in
            *[rR][kK]817*) echo "$i"; return 0 ;;
        esac
        i=$((i + 1))
    done
    return 1
}

mkdir -p /var/lib/alsa 2>/dev/null || :
: >>"$LOG" 2>/dev/null || :

CARD=
n=0
while [ "$n" -lt "$MAX_WAIT" ]; do
    CARD=$(find_card) && break
    sleep 1
    n=$((n + 1))
done
if [ -z "$CARD" ]; then
    say "no rk817 sound card after ${MAX_WAIT}s; leaving the mixer alone"
    exit 0
fi
say "rk817 codec is card$CARD ($(cat "/sys/class/sound/card$CARD/id" 2>/dev/null))"

# 1. ALSA default = plug -> softvol -> the codec. "default" otherwise resolves
#    to card 0, and on this board HDMI can probe as card 0 with no sink
#    attached, which is a very quiet way to lose all sound.
#
#    The file is rewritten whenever the card index it names changes; a stale
#    index after a re-probe would point the whole stack at HDMI.
write_asound() {
    {
        echo '# BASEOS audio: the RK817 codec is the only output this unit has.'
        echo '# Generated by baseos-audio-init; edit that script, not this file.'
        echo '#'
        echo '# The hardware DAC is pinned at 0 dB and the user volume is the'
        echo '# softvol control below, so 0..100 is -48 dB..0 dB end to end.'
        echo 'pcm.baseos_hw {'
        echo '    type hw'
        echo "    card $CARD"
        echo '    device 0'
        echo '}'
        echo 'pcm.baseos_vol {'
        echo '    type softvol'
        echo '    slave.pcm "baseos_hw"'
        echo '    control {'
        echo "        name \"$SOFTVOL_CTL\""
        echo "        card $CARD"
        echo '    }'
        echo "    min_dB $SOFTVOL_MIN_DB"
        echo '    max_dB 0.0'
        echo '    resolution 100'
        echo '}'
        echo 'pcm.!default {'
        echo '    type plug'
        echo '    slave.pcm "baseos_vol"'
        echo '}'
        echo 'ctl.!default {'
        echo '    type hw'
        echo "    card $CARD"
        echo '}'
    } >/etc/asound.conf 2>/dev/null || say "could not write /etc/asound.conf"
}

write_asound

mixer_names() {
    amixer -c "$CARD" controls 2>/dev/null |
        sed -n "s/^numid=[0-9][0-9]*,.*name='\(.*\)'$/\1/p"
}

# 2. Pin every hardware gain at 0 dB and close every playback switch, so that
#    nothing but the softvol layer can change the level. Capture controls are
#    left alone, and the softvol control is filtered out by name.
pin_hardware() {
    mixer_names | while IFS= read -r name; do
        [ "$name" = "$SOFTVOL_CTL" ] && continue
        case "$name" in
            *Volume*)
                if amixer -c "$CARD" cset name="$name" 100% >/dev/null 2>&1; then
                    say "hardware '$name' -> 100% (0 dB)"
                fi
                ;;
            *Switch*)
                case "$name" in
                    *Capture*|*Mic*|*PGA*) continue ;;
                esac
                if amixer -c "$CARD" cset name="$name" on >/dev/null 2>&1; then
                    say "switch '$name' -> on"
                fi
                ;;
        esac
    done
}

softvol_present() {
    amixer -c "$CARD" sget "$SOFTVOL_CTL" >/dev/null 2>&1
}

# 3. Create the softvol control before restore: the plugin only registers it
#    when a PCM using it is opened, and alsactl cannot restore a control that
#    does not exist yet. One second of silence is enough and runs off the boot
#    path.
if ! softvol_present; then
    if aplay -q -D default -t raw -f S16_LE -r 48000 -c 2 -d 1 /dev/zero >/dev/null 2>&1; then
        say "softvol control created"
    else
        say "could not open default PCM to create the softvol control"
    fi
fi

# 4. Restore the user's saved volume (softvol included), then force the
#    hardware back to 0 dB - a restored state file may well carry an old,
#    low hardware level from before this model existed.
if [ -s "$STATE" ]; then
    if alsactl -f "$STATE" restore >/dev/null 2>&1; then
        say "restored $STATE"
    else
        say "restore from $STATE failed; continuing with defaults"
    fi
fi

pin_hardware

# The softvol level is also kept in its own file: alsactl restores one state
# blob and can give up on a single mismatched control, and silently losing the
# user's volume to that is worse than a duplicated source of truth. The file
# wins when it is present and well formed.
VOLUME_FILE=/var/lib/alsa/baseos-volume
if [ -s "$VOLUME_FILE" ]; then
    saved=$(cat "$VOLUME_FILE" 2>/dev/null)
    case "$saved" in
        ''|*[!0-9]*) say "ignoring malformed $VOLUME_FILE ('$saved')" ;;
        *)
            if amixer -c "$CARD" sset "$SOFTVOL_CTL" "${saved}%" >/dev/null 2>&1; then
                say "softvol '$SOFTVOL_CTL' -> ${saved}% from $VOLUME_FILE"
            fi
            ;;
    esac
fi

# First boot on this rootfs slot, or a state file that predates the softvol
# layer: start at 100% so "volume all the way up" really is full scale. The
# marker is what decides this, not the current value - a user who left the
# volume at 0 must not be turned back up by the next boot.
VOLUME_MARKER=/var/lib/alsa/baseos-volume-model
if ! softvol_present; then
    say "softvol control still missing; volume keys will fall back to hardware"
elif [ ! -e "$VOLUME_MARKER" ]; then
    if amixer -c "$CARD" sset "$SOFTVOL_CTL" 100% >/dev/null 2>&1; then
        say "softvol '$SOFTVOL_CTL' initialised to 100%"
    fi
    : >"$VOLUME_MARKER" 2>/dev/null || :
fi

# 5. Store, so the hardware gains stay pinned across reboots even if something
#    else writes the state file.
if alsactl -f "$STATE" store >/dev/null 2>&1; then
    say "saved $STATE"
else
    say "could not save $STATE"
fi

cur=$(amixer -c "$CARD" cget name="$SOFTVOL_CTL" 2>/dev/null | sed -n 's/^ *: values=\([0-9]*\).*/\1/p' | head -1)
say "volume model: hardware 0 dB, softvol ${cur:-?}% (-48..0 dB)"
exit 0
