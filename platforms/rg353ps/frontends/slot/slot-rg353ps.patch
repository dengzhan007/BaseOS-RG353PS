+
+impl AxisSigns {
+    pub const FILE: &'static str = "sticks.txt";
+
+    pub fn load(config_dir: &Path) -> Self {
+        let mut signs = AxisSigns::default();
+        let Ok(text) = std::fs::read_to_string(config_dir.join(Self::FILE)) else {
+            return signs;
+        };
+        for line in text.lines() {
+            let line = line.split('#').next().unwrap_or("");
+            let Some((key, value)) = line.split_once('=') else {
+                continue;
+            };
+            let Ok(value) = value.trim().parse::<i32>() else {
+                continue;
+            };
+            let value = value.signum();
+            if value == 0 {
+                continue;
+            }
+            match key.trim().to_ascii_lowercase().as_str() {
+                "lx" => signs.left[0] = value,
+                "ly" => signs.left[1] = value,
+                "rx" => signs.right[0] = value,
+                "ry" => signs.right[1] = value,
+                _ => {}
+            }
+        }
+        signs
+    }
+
+    fn of(&self, stick: usize) -> &[i32; 2] {
+        if stick == STICK_RIGHT {
+            &self.right
+        } else {
+            &self.left
+        }
+    }
+}
