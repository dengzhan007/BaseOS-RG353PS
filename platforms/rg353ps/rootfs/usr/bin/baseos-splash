#!/bin/sh
# BaseOS framebuffer splash entry point.
# --important updates only the compact status pill, preserving the existing
# framebuffer content (used for non-progress informational messages).
# --progress atomically composes the illuminated wordmark and status pill.
[ -x /usr/bin/fbsplash ] || exit 0

case "${1:-}" in
  --important)
    shift
    [ "$#" -eq 2 ] && [ -n "$2" ] || exit 2
    exec /usr/bin/fbsplash "$@"
    ;;
  --progress)
    shift
    [ "$#" -eq 2 ] && [ -n "$2" ] || exit 2
    exec /usr/bin/fbsplash "$1" "$2" --combined
    ;;
  *)
    exit 2
    ;;
esac
