+/* Where /proc/mounts says this device is mounted, if it is mounted at all. The
+   paths the kernel prints there are escaped for whitespace; partition device
+   names never contain any, so a plain comparison is safe. */
+fn mounted_at(device: &str) -> Option<String> {
+    let mounts = fs::read_to_string("/proc/mounts").ok()?;
+    for line in mounts.lines() {
+        let mut fields = line.split_whitespace();
+        if fields.next() != Some(device) {
+            continue;
+        }
+        return fields.next().map(str::to_string);
+    }
+    None
+}
