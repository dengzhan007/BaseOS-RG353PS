#!/bin/sh
# Automatically discover user-installed frontends: TF2 first, then TF1 user data.
# Config values are plain key=value data and are never sourced or eval'd.
set -u
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

. /usr/sbin/baseos-frontend-discovery

# Boot-stage marks, same clock as rcS uses (see baseos-boot-report). This
# supervisor re-execs itself after a USB-storage session, so the entry mark is
# one-shot: a second "session entry" after the frontend was paused is a
# respawn, not a boot, and would make the timeline read as if the boot had
# started twice.
# Inlined for the same reason as rcS: this supervisor makes six of these calls
# and each one used to be a fork, an exec and a shell script.
boot_mark() {
  bm_up=
  read -r bm_up bm_rest < /proc/uptime 2>/dev/null || return 0
  [ -n "${bm_up:-}" ] || return 0
  printf '%s %s\n' "$bm_up" "$*" >> /run/boot-marks 2>/dev/null || :
  return 0
}
if [ ! -e /run/baseos-session-entered ]; then
  : > /run/baseos-session-entered 2>/dev/null || :
  boot_mark "session entry"
fi

TF1=/mnt/SDCARD
TF2=/mnt/TF2
# The user partition is the only volume a PC shows, so it wins: BASEOS_BOOT is
# hidden from file managers now and cannot be edited without a Linux host.
CONFIG=/mnt/SDCARD/baseos.conf
[ -r "$CONFIG" ] || CONFIG=/mnt/boot/baseos.conf
[ -r "$CONFIG" ] || CONFIG=/etc/baseos.conf

# A boot-time Function request has priority over frontend launch. hotkeyd
# creates this marker before publishing its startup-ready signal and removes it
# only after the USB-storage helper has returned.
BOOT_STORAGE_REQUEST=/run/baseos-usb-storage.boot-request
while [ -e "$BOOT_STORAGE_REQUEST" ]; do sleep 0.1; done

# Power-key ownership. rg353ps-hotkeyd handles a short tap (deep sleep) and a
# two-second hold (power off) unless a frontend claims the key for itself. A
# frontend claims it by carrying the marker line "baseos: power-owned" in its
# launch script: such a frontend can flush its own state before it sleeps or
# exits, and having both act on one tap suspended the unit twice. When no
# frontend claims it, or the frontend exits or is paused, the daemon takes over.
POWER_OWNER_FILE=/run/baseos-power-frontend
POWER_OWNED=0
release_power_owner() { rm -f "$POWER_OWNER_FILE" 2>/dev/null || :; }

# Reaching a frontend session is what ends an update's trial: the slots that
# booted are proven to work, so the payload is removed and the trial state
# cleared. Until this runs, three failed boots roll the previous slots back.
# Deferred past the user-data mount below: the trial state lives on BASEOS_DATA,
# since that is the one volume the flip does not move.
confirm_update() {
  if [ -x /usr/sbin/baseos-update ] && [ -e /mnt/SDCARD/.baseos/update/state ]; then
    /usr/sbin/baseos-update confirm
  fi
}

# Keep frontend-discovery traces in tmpfs on normal boots. Copy them to BOOT
# only when detection falls back to diagnostics, where a PC can read the report.
DETECTION_LOG=/mnt/boot/baseos-frontend-detection.txt
DETECTION_TMP=/tmp/baseos-frontend-detection.txt
PERSIST_DETECTION_LOG=no
: > "$DETECTION_TMP" 2>/dev/null || DETECTION_TMP=/dev/null
rm -f "$DETECTION_LOG" 2>/dev/null || :
log() {
  log_message="baseos-frontend: $*"
  printf '%s\n' "$log_message" > /dev/kmsg 2>/dev/null || :
  printf '%s\n' "$log_message" >> "$DETECTION_TMP" 2>/dev/null || :
  if [ "$PERSIST_DETECTION_LOG" = yes ]; then
    printf '%s\n' "$log_message" >> "$DETECTION_LOG" 2>/dev/null || :
  fi
}
persist_detection_log() {
  # Falling back to the diagnostic UI is a normal, self-explanatory outcome, and
  # the UI says as much on screen. The trace is only copied to the card when
  # debugging is on -- same switch as baseos-usb-storage and rg353ps-hotkeyd.
  if [ "$(setting debug no)" != yes ]; then return 0; fi
  if [ "$PERSIST_DETECTION_LOG" != yes ]; then
    cp "$DETECTION_TMP" "$DETECTION_LOG" 2>/dev/null || :
    PERSIST_DETECTION_LOG=yes
  fi
}
is_mounted() { grep -q " $1 " /proc/mounts; }

setting() {
  setting_key=$1
  setting_default=$2
  setting_value=$setting_default
  if [ -r "$CONFIG" ]; then
    while IFS= read -r setting_line || [ -n "$setting_line" ]; do
      case "$setting_line" in
        "$setting_key"=*) setting_value=${setting_line#*=} ;;
      esac
    done < "$CONFIG"
  fi
  printf '%s' "$setting_value"
}

diagnostic() {
  persist_detection_log
  # No frontend is running, so the power key belongs to rg353ps-hotkeyd again.
  release_power_owner
  log "starting built-in diagnostic UI"
  # Keep this supervisor alive in diagnostic mode too, so the Function/Mode
  # USB-storage hotkey can safely stop the UI and unmount the data card.
  while :; do
    # Start the UI from "/" so anything it forks inherits a cwd outside the
    # adapter directory. The adapter can live on BASEOS_DATA, and a helper
    # forked with a cwd on the volume it is about to export cannot unmount it:
    # storage mode requested from this menu died instantly with a "PARTITION
    # BUSY" until the export helper learned to chdir out on its own.
    cd / 2>/dev/null || :
    BASEOS_DIAGNOSTIC_SUPERVISED=1 /usr/sbin/rg353ps-control-center &
    DIAGNOSTIC_PID=$!
    while kill -0 "$DIAGNOSTIC_PID" 2>/dev/null; do
      if [ -e /run/baseos-usb-storage.request ]; then
        # Diagnostics opened from the selector can acknowledge the pause
        # themselves. Give that nested process a short window before stopping
        # the top-level diagnostic UI.
        i=0
        while [ ! -e /run/baseos-frontend-paused ] &&
              [ -e /run/baseos-usb-storage.request ] && [ "$i" -lt 20 ]; do
          sleep 0.1
          i=$((i+1))
        done
        if [ -e /run/baseos-frontend-paused ]; then
          log "nested selector diagnostics acknowledged the USB pause; keeping the selector chain alive"
          while [ -e /run/baseos-usb-storage.request ]; do sleep 0.1; done
          log "nested diagnostic USB storage finished; returning to the existing selector"
          continue
        fi
        [ -e /run/baseos-usb-storage.request ] || continue
        log "USB storage requested while diagnostic UI is active"
        kill -TERM "$DIAGNOSTIC_PID" 2>/dev/null || :
        i=0
        while kill -0 "$DIAGNOSTIC_PID" 2>/dev/null && [ "$i" -lt 15 ]; do
          sleep 0.1
          i=$((i+1))
        done
        if kill -0 "$DIAGNOSTIC_PID" 2>/dev/null; then
          kill -KILL "$DIAGNOSTIC_PID" 2>/dev/null || :
        fi
        wait "$DIAGNOSTIC_PID" 2>/dev/null || :
        cd /
        : > /run/baseos-frontend-paused
        while [ -e /run/baseos-usb-storage.request ]; do sleep 0.1; done
        rm -f /run/baseos-frontend-paused
        log "USB storage finished from diagnostic mode; rediscovering frontend"
        exec /usr/sbin/baseos-frontend-session
      fi
      sleep 0.1
    done
    wait "$DIAGNOSTIC_PID" 2>/dev/null || :
    if [ -s /run/baseos-frontend-selection ]; then
      log "frontend selected from diagnostics; resuming frontend discovery and launch"
      exec /usr/sbin/baseos-frontend-session
    fi
    sleep 0.2
  done
}

mkdir -p "$TF1" "$TF2"
ln -sfn "$TF1" /mnt/sdcard
# Recover temporary root-layout aliases left by an interrupted frontend session.
if is_mounted "$TF1" && [ -x /usr/sbin/baseos-frontend-paths ]; then
  /usr/sbin/baseos-frontend-paths cleanup "$TF1" || log "WARNING: stale frontend path aliases could not be cleaned"
fi

# TF2 is normally mounted by rcS before hotkeyd can open a storage session: a
# boot-triggered export takes whatever is mounted when it starts, so the mount
# cannot wait for this script, which that session blocks. Retrying here covers
# what rcS cannot: a first attempt that lost a race with the filesystem module,
# and the re-probe this supervisor does after every storage session. The probing
# rules -- configured node first, never the disk BASEOS_ROOT lives on, then any
# mmcblkXp1 that is not a BASEOS_* partition -- live in that one script so the
# two callers cannot drift apart.
if ! is_mounted "$TF2" && [ -x /usr/sbin/baseos-tf2-mount ]; then
  /usr/sbin/baseos-tf2-mount || :
fi
if ! is_mounted "$TF2"; then
  log "TF2 not present or not mountable; TF1 user data will be checked"
fi

# The init script normally mounts BASEOS_DATA here. Retry a non-destructive
# mount if that earlier step could not mount an already-formatted user area.
if is_mounted "$TF1"; then
  TF1_SOURCE=$(awk '$2 == "/mnt/SDCARD" { print $1 " type=" $3; exit }' /proc/mounts)
  log "TF1 user-data mount ready: $TF1_SOURCE"
else
  log "TF1 user-data path /mnt/SDCARD is not mounted before frontend scan"
fi

if ! is_mounted "$TF1"; then
  for event_file in /sys/class/block/*p*/uevent; do
    [ -r "$event_file" ] || continue
    candidate_name=
    candidate_part=
    while IFS= read -r event_line || [ -n "$event_line" ]; do
      case "$event_line" in
        DEVNAME=*) candidate_name=${event_line#DEVNAME=} ;;
        PARTNAME=*) candidate_part=${event_line#PARTNAME=} ;;
      esac
    done < "$event_file"
    [ "$candidate_part" = "BASEOS_DATA" ] || continue
    [ -n "$candidate_name" ] || continue
    [ -b "/dev/$candidate_name" ] || continue
    candidate_type=$(blkid -p -s TYPE -o value "/dev/$candidate_name" 2>/dev/null || :)
    case "$candidate_type" in vfat|exfat) ;; *) continue ;; esac
    /sbin/modprobe "$candidate_type" 2>/dev/null || :
    if mount -t "$candidate_type" -o rw,noatime "/dev/$candidate_name" "$TF1" 2>/dev/null; then
      log "mounted TF1 user data /dev/$candidate_name ($candidate_type) at $TF1"
      break
    fi
  done
fi

# The trial can end now: BASEOS_DATA is mounted, so its state file is readable,
# and userspace came up far enough to pick a frontend. Keyed on reaching this
# point rather than on the frontend exec, because a card with no frontend is a
# healthy system and keying it later made that state look like a failed update.
confirm_update

# The shared ROM root is Games/. Migrate the old spelling only when the new
# directory does not exist; when both exist, preserve both and let the owner
# merge them manually rather than silently overwriting game files.
if is_mounted "$TF1"; then
  if [ -d "$TF1/Roms" ] && [ ! -e "$TF1/Games" ]; then
    if mv "$TF1/Roms" "$TF1/Games" 2>/dev/null; then
      log "migrated legacy ROM directory Roms/ to Games/"
    else
      log "WARNING: could not rename Roms/ to Games/"
    fi
  elif [ -d "$TF1/Roms" ] && [ -d "$TF1/Games" ]; then
    log "both Roms/ and Games/ exist; preserving both without automatic merge"
  fi
  mkdir -p "$TF1/Games" "$TF1/Frontends" 2>/dev/null || :
fi

# Build BaseOS-owned compatibility packages for ordinary frontend folders.
# This only writes metadata below .baseos/compat; the frontend program tree is
# left unchanged. The helper does not hash frontend payloads on normal boots.
if [ -x /usr/sbin/baseos-frontend-compat ]; then
  /usr/sbin/baseos-frontend-compat scan "$TF2" "$TF1" || log "WARNING: legacy frontend compatibility scan failed"
fi

# force_diagnostic is an explicit troubleshooting override and therefore
# takes precedence over the optional frontend selector.
if [ "$(setting force_diagnostic no)" = "yes" ]; then
  diagnostic
fi

# A boot-time L1/R1 request opens the BaseOS selector after both user volumes
# are mounted and after Function-triggered USB storage has had priority.
if [ -e /run/baseos-frontend-select.boot-request ]; then
  rm -f /run/baseos-frontend-select.boot-request
  rm -f /run/baseos-frontend-selection
  if [ -x /usr/sbin/baseos-frontend-manager ] && [ -x /usr/sbin/rg353ps-frontend-selector ]; then
    if /usr/sbin/baseos-frontend-manager catalog && [ -s /run/baseos-frontend-catalog ]; then
      log "opening frontend selector from boot L1/R1 request"
      /usr/sbin/rg353ps-frontend-selector || log "frontend selector returned an error"
    else
      log "frontend selector requested but no managed frontend profiles were found"
    fi
  else
    log "frontend selector components are missing; continuing with configured frontend"
  fi
fi

# Legacy `frontend=...` and `allow_external_frontend_adapters=...` keys are
# intentionally not used; frontend_id is either auto, a legacy adapter ID,
# or the package--profile identity of a managed frontend instance.
FRONTEND_PREFERENCE=$(setting frontend_id auto)
if [ -s /run/baseos-frontend-selection ]; then
  read -r requested_frontend < /run/baseos-frontend-selection || requested_frontend=
  rm -f /run/baseos-frontend-selection
  if [ -n "$requested_frontend" ] && baseos_frontend_valid_id "$requested_frontend"; then
    FRONTEND_PREFERENCE=$requested_frontend
    log "one-time frontend profile selection: $FRONTEND_PREFERENCE"
  fi
fi
[ -n "$FRONTEND_PREFERENCE" ] || FRONTEND_PREFERENCE=auto
if [ "$FRONTEND_PREFERENCE" != auto ] && ! baseos_frontend_valid_id "$FRONTEND_PREFERENCE"; then
  log "invalid frontend_id setting; falling back to automatic discovery"
  FRONTEND_PREFERENCE=auto
fi

stage_legacy_updater() {
  stage_root=$1
  if [ -f "$stage_root/.tmp_update/updater" ]; then printf '%s' "$stage_root/.tmp_update/updater"; return 0; fi
  if [ -d "$stage_root/miyoo355/app/.tmp_update" ]; then
    log "staging legacy updater payload in $stage_root"
    cp -rf "$stage_root/miyoo355/app/.tmp_update" "$stage_root/" 2>/dev/null || :
  elif [ -f "$stage_root/MinUI.zip" ] && command -v unzip >/dev/null 2>&1; then
    log "staging legacy updater archive in $stage_root"
    unzip -o "$stage_root/MinUI.zip" '.tmp_update/*' -d "$stage_root" >/dev/null 2>&1 || :
  else return 1; fi
  if [ -f "$stage_root/.tmp_update/updater" ]; then
    rm -rf "$stage_root/miyoo355" 2>/dev/null || :
    sync
    printf '%s' "$stage_root/.tmp_update/updater"
    return 0
  fi
  return 1
}

ensure_baseos_paths() {
  paths_root=$1
  mkdir -p "$paths_root/userdata" 2>/dev/null || :
  if [ -d "$paths_root/userdata" ] && [ ! -d /userdata ]; then mkdir -p /userdata 2>/dev/null || :; fi
  if [ -d "$paths_root/userdata" ] && ! grep -q ' /userdata ' /proc/mounts 2>/dev/null; then mount --bind "$paths_root/userdata" /userdata 2>/dev/null || :; fi
  data_dir="$paths_root/.baseos/data"
  if mkdir -p "$data_dir" 2>/dev/null && [ -d "$data_dir" ] && ! grep -q ' /data ' /proc/mounts 2>/dev/null; then mount --bind "$data_dir" /data 2>/dev/null || :; fi
  export BASEOS_USERDATA=/userdata
}

scan_root() {
  scan_root_dir=$1
  log "scanning frontend root $scan_root_dir"
  if is_mounted "$scan_root_dir"; then
    scan_source=$(awk -v mountpoint="$scan_root_dir" '$2 == mountpoint { print $1 " type=" $3; exit }' /proc/mounts)
    log "frontend root mounted: $scan_source"
  else log "frontend root is not mounted: $scan_root_dir"; return 1; fi
  if baseos_frontend_scan_root "$scan_root_dir" "$FRONTEND_PREFERENCE"; then
    SELECTED=$BASEOS_SCAN_ID LAUNCH_MODE=script LAUNCHER=$BASEOS_SCAN_LAUNCHER
    FRONTEND_ROOT=$BASEOS_SCAN_ROOT ADAPTER_DIR=$BASEOS_SCAN_DIR
    ADAPTER_VOLUME_OWNER=$BASEOS_SCAN_VOLUME_OWNER ADAPTER_POWER_OWNER=$BASEOS_SCAN_POWER_OWNER
    FRONTEND_PACKAGE_MODE=no FRONTEND_PACKAGE_ID= FRONTEND_PROFILE_ID=
    FRONTEND_PROFILE_CONFIG= FRONTEND_PACKAGE_DIR=
    FRONTEND_COMPAT_MODE=no
    FRONTEND_SCAN_KIND=$BASEOS_SCAN_KIND
    FRONTEND_CARD_ROOT=$scan_root_dir
    FRONTEND_PROGRAM_ROOT=$BASEOS_SCAN_ROOT
    FRONTEND_PATHMAP_ID=$SELECTED
    BASEOS_COMPAT_PROGRAM_DIR=
    if [ "$BASEOS_SCAN_KIND" = package ] || [ "$BASEOS_SCAN_KIND" = compat-package ]; then
      FRONTEND_PACKAGE_MODE=yes
      FRONTEND_PACKAGE_ID=$BASEOS_SCAN_PACKAGE_ID
      FRONTEND_PROFILE_ID=$BASEOS_SCAN_PROFILE_ID
      FRONTEND_PROFILE_CONFIG=$BASEOS_SCAN_PROFILE_CONFIG
      FRONTEND_PACKAGE_DIR=$BASEOS_SCAN_PACKAGE_DIR
      FRONTEND_PATHMAP_ID=$FRONTEND_PACKAGE_ID
      if [ "$BASEOS_SCAN_KIND" = compat-package ]; then
        FRONTEND_COMPAT_MODE=yes
        BASEOS_COMPAT_PROGRAM_DIR=$BASEOS_SCAN_COMPAT_PROGRAM_DIR
        FRONTEND_PROGRAM_ROOT=$BASEOS_SCAN_COMPAT_PROGRAM_DIR
      else
        FRONTEND_PROGRAM_ROOT=$FRONTEND_PACKAGE_DIR
        [ ! -d "$FRONTEND_PROGRAM_ROOT/payload" ] || FRONTEND_PROGRAM_ROOT=$FRONTEND_PROGRAM_ROOT/payload
      fi
      if { [ "$BASEOS_SCAN_KIND" = package ] || [ "$BASEOS_SCAN_KIND" = compat-package ]; } &&
         [ "$FRONTEND_PREFERENCE" != auto ] && [ "$SELECTED" != "$FRONTEND_PREFERENCE" ] &&
         [ -x /usr/sbin/baseos-frontend-manager ]; then
        if /usr/sbin/baseos-frontend-manager set-default "$SELECTED" >/dev/null 2>&1; then
          log "migrated frontend_id from $FRONTEND_PREFERENCE to $SELECTED"
          FRONTEND_PREFERENCE=$SELECTED
        else
          log "WARNING: could not persist renamed frontend identity $SELECTED"
        fi
      fi
    fi
    [ "$FRONTEND_ROOT" = "$scan_root_dir" ] || log "found frontend $SELECTED in nested directory $FRONTEND_ROOT"
    log "selected frontend profile $SELECTED (kind=$BASEOS_SCAN_KIND priority=$BASEOS_SCAN_PRIORITY)"
    return 0
  fi
  if [ "$FRONTEND_PREFERENCE" = auto ] || [ "$FRONTEND_PREFERENCE" = legacy-updater ]; then
    if legacy_path=$(stage_legacy_updater "$scan_root_dir"); then
      SELECTED=legacy-updater LAUNCH_MODE=exec LAUNCHER=$legacy_path FRONTEND_ROOT=$scan_root_dir ADAPTER_DIR=
      ADAPTER_VOLUME_OWNER=system ADAPTER_POWER_OWNER=system
      FRONTEND_PACKAGE_MODE=no FRONTEND_PACKAGE_ID= FRONTEND_PROFILE_ID=
      FRONTEND_PROFILE_CONFIG= FRONTEND_PACKAGE_DIR=
      return 0
    fi
    for nested_root in "$scan_root_dir"/*; do
      [ -d "$nested_root" ] || continue
      if legacy_path=$(stage_legacy_updater "$nested_root"); then
        log "found legacy package in nested directory $nested_root"
        SELECTED=legacy-updater LAUNCH_MODE=exec LAUNCHER=$legacy_path FRONTEND_ROOT=$nested_root ADAPTER_DIR=
        ADAPTER_VOLUME_OWNER=system ADAPTER_POWER_OWNER=system
        FRONTEND_PACKAGE_MODE=no FRONTEND_PACKAGE_ID= FRONTEND_PROFILE_ID=
        FRONTEND_PROFILE_CONFIG= FRONTEND_PACKAGE_DIR=
        return 0
      fi
    done
  fi
  log "no usable adapter found at or one directory below $scan_root_dir"
  return 1
}

SELECTED= LAUNCHER= FRONTEND_ROOT= ADAPTER_DIR=
ADAPTER_VOLUME_OWNER=system ADAPTER_POWER_OWNER=system
FRONTEND_PACKAGE_MODE=no FRONTEND_PACKAGE_ID= FRONTEND_PROFILE_ID=
FRONTEND_PROFILE_CONFIG= FRONTEND_PACKAGE_DIR=
FRONTEND_SCAN_KIND=legacy FRONTEND_PROGRAM_ROOT= FRONTEND_PATHMAP_ID=
FRONTEND_CARD_ROOT=
LAUNCH_MODE=script
SELECTION_CACHE=/mnt/SDCARD/.baseos/cache/frontend-selection
# Same test as is_mounted, without the fork: this runs on the path it is
# supposed to shorten.
mount_has() {
  mount_has_want=$1
  [ -n "$mount_has_want" ] || return 1
  while read -r mount_has_dev mount_has_mp mount_has_rest; do
    [ "$mount_has_mp" = "$mount_has_want" ] && return 0
  done < /proc/mounts
  return 1
}

launcher_path_of() {
  case "$1" in
    exec:*) printf '%s' "${1#exec:}" ;;
    *) printf '%s' "$1" ;;
  esac
}

cached_selection() {
  [ -s "$SELECTION_CACHE" ] || return 1
  c_preference= c_id= c_mode= c_root= c_launcher=
  IFS='|' read -r c_preference c_id c_mode c_root c_launcher < "$SELECTION_CACHE" 2>/dev/null || return 1
  [ "$c_preference" = "$FRONTEND_PREFERENCE" ] || return 1
  [ -n "$c_id" ] && [ -n "$c_root" ] && [ -n "$c_launcher" ] || return 1
  case "$c_mode" in exec|script) ;; *) return 1 ;; esac
  [ -f "$c_launcher" ] || return 1
  mount_has "$c_root" || return 1
  if [ "$c_root" = "$TF1" ] && mount_has "$TF2"; then return 1; fi
  baseos_frontend_tree_changed_since "$c_root" "$SELECTION_CACHE" && return 1
  if [ "$c_mode" = script ]; then
    baseos_frontend_load_manifest "${c_launcher%/*}" || return 1
    [ "$BASEOS_ADAPTER_ID" = "$c_id" ] || return 1
    ADAPTER_DIR=$BASEOS_ADAPTER_DIR ADAPTER_VOLUME_OWNER=$BASEOS_ADAPTER_VOLUME_OWNER ADAPTER_POWER_OWNER=$BASEOS_ADAPTER_POWER_OWNER
    FRONTEND_PACKAGE_MODE=no FRONTEND_PACKAGE_ID= FRONTEND_PROFILE_ID=
    FRONTEND_PROFILE_CONFIG= FRONTEND_PACKAGE_DIR=
  else
    [ "$c_id" = legacy-updater ] || return 1
    ADAPTER_DIR= ADAPTER_VOLUME_OWNER=system ADAPTER_POWER_OWNER=system
  fi
  SELECTED=$c_id LAUNCH_MODE=$c_mode LAUNCHER=$c_launcher FRONTEND_ROOT=$c_root
  case "$c_root" in
    "$TF1") FRONTEND_CARD_ROOT=$TF1 ;;
    "$TF2") FRONTEND_CARD_ROOT=$TF2 ;;
    *) return 1 ;;
  esac
  if [ "$c_mode" = script ]; then
    FRONTEND_PROGRAM_ROOT=$c_root
    FRONTEND_PATHMAP_ID=$c_id
    FRONTEND_SCAN_KIND=legacy
  fi
  return 0
}
write_selection_cache() {
  # Package/profile instances are rescanned for now; their compact profile
  # metadata is small, and the legacy cache format has only one adapter ID.
  [ "${FRONTEND_PACKAGE_MODE:-no}" = no ] || return 0
  [ -n "$LAUNCHER" ] && [ -n "$FRONTEND_ROOT" ] || return 0
  [ -f "$(launcher_path_of "$LAUNCHER")" ] || return 0
  mkdir -p "${SELECTION_CACHE%/*}" 2>/dev/null || return 0
  printf '%s|%s|%s|%s|%s\n' "$FRONTEND_PREFERENCE" "$SELECTED" "$LAUNCH_MODE" \
    "$FRONTEND_ROOT" "$LAUNCHER" > "$SELECTION_CACHE.new" 2>/dev/null &&
    mv -f "$SELECTION_CACHE.new" "$SELECTION_CACHE" 2>/dev/null || {
      rm -f "$SELECTION_CACHE.new" 2>/dev/null || :
    }
  return 0
}

# Card priority is deliberate: use TF2 if it has a recognized adapter; only
# fall back to TF1's BASEOS_DATA when TF2 is absent or has no usable frontend.
if cached_selection; then
  log "frontend selection restored from cache: $SELECTED at $FRONTEND_ROOT"
fi
if [ -z "$LAUNCHER" ] && is_mounted "$TF2"; then
  if scan_root "$TF2"; then
    log "selected $SELECTED frontend from TF2 ($FRONTEND_ROOT)"
  else
    log "TF2 has no usable frontend; checking TF1 user data"
  fi
fi
if [ -z "$LAUNCHER" ] && is_mounted "$TF1"; then
  if scan_root "$TF1"; then
    log "selected $SELECTED frontend from TF1 ($FRONTEND_ROOT)"
  fi
fi
if [ -z "$LAUNCHER" ]; then
  log "no usable frontend found on TF2 or TF1; falling back to diagnostics"
  log "inspect $DETECTION_LOG; install a valid adapter or a supported legacy package on a user-data card"
  diagnostic
fi
write_selection_cache

# Keep the compatibility alias on the selected card root. Frontend program
# folders may be nested under Frontends/<name>, but legacy ROM discovery must
# still see the shared Games/ tree at the card root.
# Splits the blind spot between "rcS done" and the handoff into the part that
# is frontend discovery and the part that is waiting on audio and the volume
# handoff below.
boot_mark "frontend selected: $SELECTED"
PLATFORM=rg353ps
BASEOS_FRONTEND_ID=$SELECTED
BASEOS_SYSTEM_ROOT=/
BASEOS_BOOT=/mnt/boot
# BASEOS_FRONTEND_ROOT is a compatibility contract for historical launchers:
# it is the selected card root, not an isolated Frontends/<name> program folder.
# The latter has its own explicit BASEOS_FRONTEND_PROGRAM_ROOT variable.
BASEOS_CARD_ROOT=${FRONTEND_CARD_ROOT:-$TF1}
BASEOS_FRONTEND_ROOT=$BASEOS_CARD_ROOT
ln -sfn "$BASEOS_CARD_ROOT" /mnt/sdcard
BASEOS_PACKAGE_ID=${FRONTEND_PACKAGE_ID:-}
BASEOS_PROFILE_ID=${FRONTEND_PROFILE_ID:-}
BASEOS_PROFILE_DEFAULTS=${FRONTEND_PROFILE_CONFIG:-}
BASEOS_PACKAGE_DIR=${FRONTEND_PACKAGE_DIR:-}
BASEOS_COMPAT_PROGRAM_DIR=${BASEOS_COMPAT_PROGRAM_DIR:-}
BASEOS_FRONTEND_PATHMAP_ID=${FRONTEND_PATHMAP_ID:-$SELECTED}
BASEOS_FRONTEND_PROGRAM_ROOT=${FRONTEND_PROGRAM_ROOT:-$FRONTEND_ROOT}
BASEOS_INSTANCE_ID=$SELECTED
BASEOS_GAMES_DIR=$BASEOS_CARD_ROOT/Games
if [ "${FRONTEND_PACKAGE_MODE:-no}" = yes ]; then
  BASEOS_INSTANCE_DIR="$BASEOS_CARD_ROOT/.baseos/instances/$SELECTED"
  BASEOS_DATA_DIR="$BASEOS_INSTANCE_DIR/data"
  BASEOS_USERDATA_DIR="$BASEOS_INSTANCE_DIR/userdata"
  BASEOS_PROFILE_CONFIG="$BASEOS_INSTANCE_DIR/config/profile.conf"
  mkdir -p "$BASEOS_INSTANCE_DIR/config" "$BASEOS_INSTANCE_DIR/cache" \
    "$BASEOS_INSTANCE_DIR/states" "$BASEOS_INSTANCE_DIR/database" \
    "$BASEOS_INSTANCE_DIR/assets" "$BASEOS_INSTANCE_DIR/logs" \
    "$BASEOS_DATA_DIR" "$BASEOS_USERDATA_DIR" 2>/dev/null || :
  # Seed once from package defaults. Later package updates cannot overwrite
  # user-edited profile settings; uninstall/reinstall keeps the same instance.
  if [ -n "$BASEOS_PROFILE_DEFAULTS" ] && [ -f "$BASEOS_PROFILE_DEFAULTS" ] &&
     [ ! -s "$BASEOS_PROFILE_CONFIG" ]; then
    cp "$BASEOS_PROFILE_DEFAULTS" "$BASEOS_PROFILE_CONFIG" 2>/dev/null || :
  fi
else
  BASEOS_INSTANCE_DIR="$FRONTEND_ROOT/.baseos"
  BASEOS_DATA_DIR="$FRONTEND_ROOT/.baseos/data"
  BASEOS_USERDATA_DIR="$FRONTEND_ROOT/.baseos/userdata"
  BASEOS_PROFILE_CONFIG=
  # Create the private legacy user-data root before applying aliases such as
  # .userdata -> this directory. Otherwise the first launch misses the alias
  # and only later launches see it after the generic directory setup below.
  mkdir -p "$BASEOS_INSTANCE_DIR" "$BASEOS_DATA_DIR" "$BASEOS_USERDATA_DIR" 2>/dev/null || :
fi
BASEOS_LAUNCHER=$LAUNCHER
export PLATFORM BASEOS_FRONTEND_ID BASEOS_SYSTEM_ROOT BASEOS_BOOT
export BASEOS_FRONTEND_ROOT BASEOS_PACKAGE_ID BASEOS_PROFILE_ID BASEOS_PROFILE_CONFIG BASEOS_PROFILE_DEFAULTS
export BASEOS_PACKAGE_DIR BASEOS_COMPAT_PROGRAM_DIR BASEOS_FRONTEND_PATHMAP_ID BASEOS_FRONTEND_PROGRAM_ROOT
export BASEOS_INSTANCE_ID BASEOS_INSTANCE_DIR BASEOS_CARD_ROOT BASEOS_GAMES_DIR
export BASEOS_DATA_DIR BASEOS_USERDATA_DIR BASEOS_LAUNCHER

# Generate the BaseOS-owned shared-path map on first discovery. It lives under
# the card's .baseos directory, never inside or alongside frontend source files.
# For legacy/compat frontends, expose expected card-root paths while they run.
if [ -x /usr/sbin/baseos-frontend-paths ] && [ -n "$BASEOS_FRONTEND_PATHMAP_ID" ]; then
  if /usr/sbin/baseos-frontend-paths scan "$BASEOS_CARD_ROOT" "$BASEOS_FRONTEND_PATHMAP_ID" "$BASEOS_FRONTEND_PROGRAM_ROOT"; then
    BASEOS_FRONTEND_PATHMAP="$BASEOS_CARD_ROOT/.baseos/frontend-paths/$BASEOS_FRONTEND_PATHMAP_ID.conf"
    export BASEOS_FRONTEND_PATHMAP
    case "$FRONTEND_SCAN_KIND" in
      legacy|compat-package)
        if /usr/sbin/baseos-frontend-paths apply "$BASEOS_CARD_ROOT" "$BASEOS_FRONTEND_PROGRAM_ROOT" "$BASEOS_FRONTEND_PATHMAP" "$BASEOS_USERDATA_DIR"; then
          log "applied BaseOS shared-path map for $BASEOS_FRONTEND_PATHMAP_ID"
        else
          log "WARNING: could not apply BaseOS shared-path map for $BASEOS_FRONTEND_PATHMAP_ID"
        fi
        ;;
    esac
  else
    log "WARNING: could not create BaseOS shared-path map for $BASEOS_FRONTEND_PATHMAP_ID"
  fi
fi
# Mesa's on-disk program cache keeps GL program compilation out of later starts.
# It was never enabled on purpose: it follows $XDG_CACHE_HOME, then $HOME, and the
# launcher sets HOME=/ for the frontend, so the cache ended up in /.cache beside
# the rootfs. That works until a rootfs update throws it away, and it is invisible
# to anyone looking for where the space went. Name it, and cap it: Mesa's default
# limit is 1 GB while this rootfs has ~130 MB free, so an unbounded cache on a
# long-lived card is a slow way to fill the system partition.
#
# The cache has to outlive the boot, and the root filesystem is mounted
# read-only, so it cannot live there: a read-only /.cache is not merely stale,
# Mesa cannot add to it, and every new shader would be compiled from scratch on
# every boot. /var is a tmpfs for the same reason the root is read-only, so that
# is not a home for it either. The user volume is the one place on this device
# that is writable and persistent, and exFAT was checked on the device before
# the path was moved there: the cache is written, read back, and rebuilt after a
# part file is deleted.
#
# The fallback is a tmpfs: a unit whose user volume did not mount still gets a
# frontend, it just compiles its shaders every time.
if [ "${FRONTEND_PACKAGE_MODE:-no}" = yes ]; then
  MESA_CACHE_DIR="$BASEOS_INSTANCE_DIR/cache/mesa"
else
  MESA_CACHE_DIR=/mnt/SDCARD/.baseos/cache
fi
# [ -d ] before mkdir, not instead of it: busybox sh has no builtin mkdir, so
# every call forks /bin/mkdir, and on exFAT each of those does a directory walk
# before it can answer "it's already there". The test is a builtin stat. These
# three directories exist on every boot after the first, so the common path
# should not fork at all.
if [ ! -d "$MESA_CACHE_DIR" ] && ! mkdir -p "$MESA_CACHE_DIR" 2>/dev/null; then
  MESA_CACHE_DIR=/var/cache
  [ -d "$MESA_CACHE_DIR" ] || mkdir -p "$MESA_CACHE_DIR" 2>/dev/null || :
fi
XDG_CACHE_HOME=$MESA_CACHE_DIR
export XDG_CACHE_HOME
export MESA_SHADER_CACHE_MAX_SIZE=32M
[ -d "$BASEOS_DATA_DIR" ] || mkdir -p "$BASEOS_DATA_DIR" 2>/dev/null || :
[ -d "$BASEOS_USERDATA_DIR" ] || mkdir -p "$BASEOS_USERDATA_DIR" 2>/dev/null || :
# An upstream package brings its own layout and does not want BaseOS's dot-dirs
# invented on its card; it does need the two paths upstream guarantees.
if [ "$LAUNCH_MODE" = "exec" ]; then
  ensure_baseos_paths "$FRONTEND_ROOT"
fi
if [ "${FRONTEND_PACKAGE_MODE:-no}" = yes ]; then
  cd "$BASEOS_PACKAGE_DIR" || diagnostic
else
  cd "$FRONTEND_ROOT" || diagnostic
fi
# rcS starts baseos-audio-init in the background, so a fast boot can reach this
# point before the softvol volume layer exists. A frontend that opens ALSA in
# that window picks whatever control the codec happens to expose and gets the
# old, unusable register-percent curve. Re-run the init only when the layer is
# actually missing: on a normal boot this costs one stat and no delay.
if [ -x /usr/sbin/baseos-audio-init ]; then
  # Wait for the background run first. Deciding "the layer is missing" while
  # that run is still mid-flight started a second copy, and the two raced for
  # the default PCM: the late one logged "could not open default PCM to create
  # the softvol control" and the volume layer ended up built twice. Waiting for
  # its ready flag costs nothing when it finished promptly, and the flag is
  # written even when no codec was found, so a genuinely broken mixer still
  # falls through to the retry below.
  _aw=0
  while [ ! -e /run/baseos-audio-ready ] && [ "$_aw" -lt 30 ]; do
    sleep 0.1
    _aw=$((_aw + 1))
  done
  # baseos-audio-init records which card it settled on when it finishes, so the
  # common path is one read instead of a scan. Finding the card by hand meant
  # eight cat forks plus an amixer fork, and it answered a question that had
  # already been answered: the ready flag is written at the one point where the
  # softvol layer exists and the hardware gains are pinned, and the branch below
  # only exists for the case where this script has to run it itself.
  AUDIO_CARD=
  if [ -s /run/baseos-audio-card ]; then
    read -r AUDIO_CARD < /run/baseos-audio-card 2>/dev/null || AUDIO_CARD=
  fi
  if [ -z "$AUDIO_CARD" ]; then
    # No card was recorded: either the init found no codec, or it never ran.
    # Scan, and treat a missing control as "needs running".
    for _i in 0 1 2 3 4 5 6 7; do
      case "$(cat "/sys/class/sound/card$_i/id" 2>/dev/null)" in
        *rk817*) AUDIO_CARD=$_i; break ;;
      esac
    done
    if [ -z "$AUDIO_CARD" ] || ! amixer -c "$AUDIO_CARD" sget 'BaseOS Master' >/dev/null 2>&1; then
      log "volume layer missing; running baseos-audio-init before launch"
      /usr/sbin/baseos-audio-init >/dev/null 2>&1 || :
    fi
  fi
fi
# Volume ownership.
#
# The frontend draws its own bar, in its own style, and holds its own level.
# That bar is the thing the user looks at while pressing the keys, so it has to
# be the thing that actually changes the loudness - a bar that moves while the
# mixer does something else is what made the same on-screen percentage sound
# different every session.
#
# So while a frontend runs, the mixer is held at one fixed level and the
# frontend's own control is the only attenuator. The marker tells
# rg353ps-hotkeyd to stop moving the mixer; the previous mixer value is kept so
# the diagnostic UI, a shell or an update gets it back afterwards.
VOLUME_MARKER=/run/baseos-volume-frontend
VOLUME_SAVED=/run/baseos-volume-mixer-saved
# 0 dB at full scale plus a handheld speaker is a bad idea: it clips the tiny
# driver and leaves nothing to give if a frontend applies no gain of its own.
# 90/99 (-4.3 dB) is loud and still has headroom.
FRONTEND_MIXER_LEVEL=90

audio_card_index() {
  # Reuse what this session already learned. baseos-audio-init records the card
  # it settled on when it publishes the ready marker, and the lookup above used
  # to throw that away and rescan: eight cat forks, on the handoff path, to
  # answer a question that had been answered a moment earlier. The scan stays as
  # the fallback for when the marker carried no number (no codec found, or the
  # init never ran).
  if [ -n "${AUDIO_CARD:-}" ]; then
    printf '%s' "$AUDIO_CARD"
    return 0
  fi
  for ac_i in 0 1 2 3 4 5 6 7; do
    case "$(cat "/sys/class/sound/card$ac_i/id" 2>/dev/null)" in
      *rk817*) printf '%s' "$ac_i"; return 0 ;;
    esac
  done
  return 1
}

claim_volume_for_frontend() {
  # Declared first and unconditionally: the marker is what tells
  # rg353ps-hotkeyd and baseos-audio-init to keep their hands off this control,
  # and it matters most in the case where the softvol control is not up yet
  # (the cget below would bail out and, with the write after it, leave the
  # daemon still moving the mixer). It carries this session's pid, and a pid
  # that no longer exists means the marker can be ignored.
  printf '%s\n' "$$" > "$VOLUME_MARKER" 2>/dev/null || :
  ac_card=$(audio_card_index) || return 0
  # One amixer call, not two. sget was only there to prove the control exists
  # and cget answers that by coming back empty, which is also the value that has
  # to be saved before the pin overwrites it.
  ac_cur=$(amixer -c "$ac_card" cget name='BaseOS Master' 2>/dev/null |
           sed -n 's/^ *: values=\([0-9][0-9]*\).*/\1/p' | head -1)
  [ -n "$ac_cur" ] || return 0
  printf '%s\n' "$ac_cur" > "$VOLUME_SAVED" 2>/dev/null
  if amixer -c "$ac_card" cset name='BaseOS Master' "$FRONTEND_MIXER_LEVEL" >/dev/null 2>&1; then
    log "mixer pinned at $FRONTEND_MIXER_LEVEL for the frontend (was ${ac_cur:-unknown}); the frontend's own volume now controls loudness"
  else
    log "could not pin the mixer for the frontend; it will still own the keys"
  fi
}

release_volume_from_frontend() {
  rm -f "$VOLUME_MARKER" 2>/dev/null || :
  [ -s "$VOLUME_SAVED" ] || return 0
  ac_card=$(audio_card_index) || return 0
  ac_back=$(cat "$VOLUME_SAVED" 2>/dev/null)
  case "$ac_back" in
    ''|*[!0-9]*) return 0 ;;
  esac
  # Handing back a level that was itself a leftover would drop the diagnostic UI
  # and any shell into silence with nothing on screen to explain it.
  [ "$ac_back" -lt 5 ] && ac_back=60
  amixer -c "$ac_card" cset name='BaseOS Master' "$ac_back" >/dev/null 2>&1 &&
    log "mixer restored to $ac_back after the frontend exited"
  rm -f "$VOLUME_SAVED" 2>/dev/null || :
}

# Boot timing at the point the frontend is about to run.
#
# Everything after this line is the frontend's own time, so the marker is the
# boundary that makes every number in the log attributable. It is written once
# per boot, immediately before the first exec, and kept on tmpfs across
# respawns. /proc/uptime cannot see the bootloader or the kernel decompression:
# boot-clock reads the ARM generic counter alongside the monotonic clock to
# split those out, and when it declines (userspace counter access denied, or a
# sample that straddled a reschedule) the line falls back to uptime alone rather
# than print a split it cannot prove.
BOOT_LOG_SUBDIR=Logs

write_boot_log() {
  # Persistent boot timing is opt-in. Keep the detailed timeline in /run for
  # this boot, but avoid routine writes to the user's exFAT card.
  [ "$(setting boot_log no)" = yes ] || return 0
  is_mounted "$TF1" || return 0
  mkdir -p "$TF1/$BOOT_LOG_SUBDIR" 2>/dev/null || :
  bw_blog=$TF1/$BOOT_LOG_SUBDIR/boot.log
  {
    printf '%s\n' "--- boot $(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo 'unknown time')  kernel $(cat /proc/sys/kernel/osrelease 2>/dev/null || echo unknown)  frontend $1"
    if [ -x /usr/sbin/baseos-boot-report ]; then
      /usr/sbin/baseos-boot-report 2>/dev/null
    else
      printf '%s\n' "Startup: $(cat /run/boot-frontend-exec 2>/dev/null) s Linux to menu"
    fi
  } >> "$bw_blog" 2>/dev/null || return 0
  # One block per boot accumulates over months on a card nobody edits, and only
  # the recent boots are ever read back. Trim in place once the file gets long.
  bw_lines=$(wc -l < "$bw_blog" 2>/dev/null || echo 0)
  if [ "${bw_lines:-0}" -gt 600 ] 2>/dev/null; then
    tail -n 200 "$bw_blog" > "$bw_blog.tmp" 2>/dev/null && mv -f "$bw_blog.tmp" "$bw_blog" 2>/dev/null || :
    rm -f "$bw_blog.tmp" 2>/dev/null || :
  fi
}

record_handoff() {
  # Keep the first handoff: a respawn after a USB-storage session is not a boot.
  [ -s /run/boot-frontend-exec ] && return 0
  boot_mark "handoff: entered"
  ho_handoff= ho_pre= ho_post= ho_total=
  read -r ho_handoff _ < /proc/uptime 2>/dev/null || :
  # rcS took the counter split while the card was idle; only the handoff instant
  # has to be sampled here, and /proc/uptime is already in the page cache. The
  # split's "before Linux" field is a constant for the rest of the boot (free
  # running counter minus monotonic clock), so the total is that constant plus
  # this boot's uptime.
  if [ -n "${ho_handoff:-}" ] && [ -s /run/boot-clock-boot ]; then
    read -r _ ho_pre _ _ < /run/boot-clock-boot 2>/dev/null || :
    if [ -n "${ho_pre:-}" ]; then
      ho_post=$ho_handoff
      ho_total=$(awk -v a="$ho_pre" -v b="$ho_handoff" \
        'BEGIN { printf "%.3f", a + b }' 2>/dev/null) || ho_total=
    fi
  fi
  # rcS could not take the split (kernel denies userspace counter reads, or the
  # samples kept straddling a reschedule): fall back to sampling the whole thing
  # here, which is what this did before and still produces a usable number.
  if [ -z "${ho_total:-}" ]; then
    if [ -x /usr/sbin/boot-clock ] \
       && /usr/sbin/boot-clock > /run/boot-clock-handoff 2>/dev/null; then
      read -r ho_handoff ho_pre ho_post ho_total < /run/boot-clock-handoff 2>/dev/null || :
    else
      rm -f /run/boot-clock-handoff 2>/dev/null || :
    fi
  fi
  [ -n "${ho_handoff:-}" ] || return 0
  if [ -n "${ho_total:-}" ]; then
    printf '%s %s %s %s\n' "$ho_handoff" "$ho_pre" "$ho_post" "$ho_total" \
      > /run/boot-clock-handoff 2>/dev/null || :
  fi
  printf '%s\n' "$ho_handoff" > /run/boot-frontend-exec 2>/dev/null || :
  if [ -n "${ho_total:-}" ]; then
    log "Startup: $ho_pre s before Linux, $ho_post s Linux to menu, $ho_total s total ($1)"
  else
    log "Startup: $ho_handoff s Linux to menu ($1)"
  fi
  # The card copy is a log, not a prerequisite: writing it here cost 0.3-1.4 s
  # inside the launch path (exFAT on an SD card, first write after mount, plus a
  # fork of baseos-boot-report), and the frontend has nothing to wait for. The
  # numbers are already in /run before this point, so the session can start and
  # the card gets the same block as soon as the write lands.
  write_boot_log "$1" >/dev/null 2>&1 &
}

log "launching $SELECTED frontend ($LAUNCH_MODE): $LAUNCHER"
# Older packages may carry capability markers in launch.sh instead of a manifest.
# Read them with shell builtins only; new packages should use manifest.conf.
if [ "$LAUNCH_MODE" = script ] && { [ -z "$ADAPTER_DIR" ] || [ ! -f "$ADAPTER_DIR/manifest.conf" ]; }; then
  while IFS= read -r capability_line || [ -n "$capability_line" ]; do
    case "$capability_line" in
      "# baseos: volume-owned") ADAPTER_VOLUME_OWNER=frontend ;;
      "# baseos: power-owned") ADAPTER_POWER_OWNER=frontend ;;
    esac
  done < "$LAUNCHER"
fi

# Adapter capabilities decide whether the frontend owns its on-screen volume control.
# A card-side setting can explicitly override the manifest.
VOLUME_CLAIMED=no
case "$(setting volume_owner auto)" in
  system) VOLUME_CLAIMED=no ;;
  frontend) VOLUME_CLAIMED=yes ;;
  *) [ "$ADAPTER_VOLUME_OWNER" = frontend ] && VOLUME_CLAIMED=yes ;;
esac
if [ "$VOLUME_CLAIMED" = yes ]; then
  # baseos-audio-init runs in the background from rcS and restores the state
  # blob plus the saved softvol level. Pinning before it finishes means the
  # restore lands on top of the pin, which is exactly how a unit that played
  # fine before the reboot came up silent with its bar at 30%. Wait for its
  # ready flag, but never block the boot on a broken mixer.
  boot_mark "session: audio wait begins"
  ac_wait=0
  while [ ! -e /run/baseos-audio-ready ] && [ "$ac_wait" -lt 30 ]; do
    sleep 0.1
    ac_wait=$((ac_wait + 1))
  done
  [ -e /run/baseos-audio-ready ] || log "audio layer never reported ready; pinning the mixer anyway"
  boot_mark "session: audio ready (waited $((ac_wait * 100)) ms)"
  claim_volume_for_frontend
fi
boot_mark "session: prepped"
# Last thing before the frontend exists: record this boot's handoff time.
record_handoff "$SELECTED"
# Pause the frontend before exposing its mounted card to the USB host.
kill_tree() {
  signal=$1
  pid=$2
  [ -r "/proc/$pid/task/$pid/children" ] || { kill -"$signal" "$pid" 2>/dev/null || :; return; }
  children=$(cat "/proc/$pid/task/$pid/children" 2>/dev/null || :)
  for child in $children; do kill_tree "$signal" "$child"; done
  kill -"$signal" "$pid" 2>/dev/null || :
}
if [ "$LAUNCH_MODE" = "exec" ]; then
  [ -f "$LAUNCHER" ] || { log "legacy updater vanished: $LAUNCHER"; diagnostic; }
  [ -x "$LAUNCHER" ] || chmod 0755 "$LAUNCHER" 2>/dev/null || :
  "$LAUNCHER" &
else
  # Power-key ownership comes from the adapter manifest or legacy marker.
  [ "$ADAPTER_POWER_OWNER" = frontend ] && POWER_OWNED=1
  /bin/sh "$LAUNCHER" &
fi
FRONTEND_PID=$!
if [ "$VOLUME_CLAIMED" = yes ]; then
  # The pid is what rg353ps-hotkeyd checks to decide whether the marker still
  # means anything; an empty marker would read as "no frontend".
  printf '%s\n' "$FRONTEND_PID" > "$VOLUME_MARKER" 2>/dev/null || :
  log "frontend $SELECTED owns the volume keys while it runs"
fi
if [ "$POWER_OWNED" -eq 1 ]; then
  printf '%s\n' "$FRONTEND_PID" > "$POWER_OWNER_FILE" 2>/dev/null || :
  log "frontend $SELECTED owns the power key while it runs"
else
  log "frontend $SELECTED does not claim the power key; rg353ps-hotkeyd keeps it"
fi
while kill -0 "$FRONTEND_PID" 2>/dev/null; do
  # One-shot, opt-in first-stage suspend test. This runs only after a frontend
  # has launched, so its process tree can be checked after resume. Never run
  # while the shared card is being exported or the frontend is being unmounted.
  SUSPEND_TEST_MARKER=/mnt/boot/BASEOS-SUSPEND-TEST-S2IDLE
  if [ -e "$SUSPEND_TEST_MARKER" ] && [ -x /usr/sbin/rg353ps-suspend-test ]; then
    if rm -f "$SUSPEND_TEST_MARKER" 2>/dev/null && [ ! -e "$SUSPEND_TEST_MARKER" ]; then
      sync
      log "one-shot s2idle suspend/resume test requested"
      /usr/sbin/rg353ps-suspend-test s2idle
      suspend_test_rc=$?
      log "suspend/resume test helper returned exit=$suspend_test_rc"
    else
      log "suspend test request could not be consumed; refusing to suspend"
    fi
  fi
  if [ -e /run/baseos-usb-storage.request ]; then
    log "USB storage requested; stopping frontend before unmount"
    kill_tree TERM "$FRONTEND_PID"
    release_power_owner
    i=0
    while kill -0 "$FRONTEND_PID" 2>/dev/null && [ "$i" -lt 15 ]; do sleep 0.1; i=$((i+1)); done
    if kill -0 "$FRONTEND_PID" 2>/dev/null; then kill_tree KILL "$FRONTEND_PID"; fi
    wait "$FRONTEND_PID" 2>/dev/null || :
    if [ -x /usr/sbin/baseos-frontend-paths ]; then
      /usr/sbin/baseos-frontend-paths cleanup "$TF1" || log "WARNING: could not clean frontend path aliases before USB export"
    fi
    cd /
    release_volume_from_frontend
    : > /run/baseos-frontend-paused
    while [ -e /run/baseos-usb-storage.request ]; do sleep 0.1; done
    rm -f /run/baseos-frontend-paused
    log "USB storage finished; rediscovering frontend"
    exec /usr/sbin/baseos-frontend-session
  fi
  sleep 0.1
done
wait "$FRONTEND_PID"
rc=$?
release_power_owner
release_volume_from_frontend
if [ -x /usr/sbin/baseos-frontend-paths ]; then
  /usr/sbin/baseos-frontend-paths cleanup "$TF1" || log "WARNING: could not clean frontend path aliases after exit"
fi
persist_detection_log
log "frontend '$SELECTED' exited with status $rc; returning to diagnostics"
printf '\033[0m\033[?25h\033[2J\033[H' > /dev/tty1 2>/dev/null || :
# Re-enter diagnostics through the supervisor, not by exec'ing the UI directly.
# The old exec dropped this supervisor, so nothing was left to answer a
# Function-key or menu request for USB storage: the helper wrote
# /run/baseos-usb-storage.request, waited 15 s for /run/baseos-frontend-paused,
# never got it, and gave up with "USB STORAGE FAILED" — which is exactly what
# storage mode did whenever it was entered from the diagnostic UI.
diagnostic
