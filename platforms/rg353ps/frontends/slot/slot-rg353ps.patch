+/// One ADC sample as a signed axis: negative below centre, positive above, zero
+/// inside the small analog deadzone. `AxisSigns` decides which physical
+/// direction that ends up meaning.
+fn axis(raw: i32) -> i32 {
+    let centred = raw.clamp(0, 1023) - ADC_CENTRE;
+    if centred.abs() <= ADC_ANALOG_DEADZONE {
+        return 0;
+    }
+    (centred * 32767 / ADC_TRAVEL).clamp(i32::from(i16::MIN), i32::from(i16::MAX))
+}
